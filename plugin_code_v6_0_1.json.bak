  DRESSING_DICT = 'MHD_DRESSING' unless const_defined?(:DRESSING_DICT, false)
  DRESSING_SYSTEM = 'MHDESIGN_DRESSING' unless const_defined?(:DRESSING_SYSTEM, false)
  DRESSING_UNIT_URLS = {
    'straight' => 'https://mhdesign-eg.com/SKETCHUP022/MHDESIGN_Dressing/unit/straight.skp',
    'corner' => 'https://mhdesign-eg.com/SKETCHUP022/MHDESIGN_Dressing/unit/corner.skp'
  }.freeze unless const_defined?(:DRESSING_UNIT_URLS, false)
  DRESSING_SIGNATURES = {
    'straight' => 'MHD_DRESSING_STRAIGHT_V1',
    'corner' => 'MHD_DRESSING_CORNER_V1'
  }.freeze unless const_defined?(:DRESSING_SIGNATURES, false)
  DRESSING_TOOL_CONSTANTS = {
    'straight' => %w[MHDESIGN::Dressing::Straight MHDESIGN::DressingStraight MHDESIGN::StraightDressing MHDESIGN::StraightDesigner MHDESIGN::DressingDesigner DressingDesigner],
    'corner' => %w[MHDESIGN::Dressing::Corner MHDESIGN::DressingCorner MHDESIGN::CornerDressing MHDESIGN::CornerDesigner MHDESIGN::DressingCornerDesigner CornerDesigner]
  }.freeze unless const_defined?(:DRESSING_TOOL_CONSTANTS, false)
  DRESSING_ENTRY_METHODS = %i[open_for_selection open_for_component open_for_unit show_dialog open_dialog show_ui activate_tool open_selector show open launch run].freeze unless const_defined?(:DRESSING_ENTRY_METHODS, false)

  def self.dressing_attribute(entity, key)
    return nil unless entity && entity.respond_to?(:get_attribute)
    value = entity.get_attribute(DRESSING_DICT, key, nil)
    if (value.nil? || value.to_s.empty?) && entity.respond_to?(:definition) && entity.definition
      value = entity.definition.get_attribute(DRESSING_DICT, key, nil)
    end
    value
  rescue
    nil
  end

  def self.dressing_unit_type(entity)
    return nil unless entity && entity.valid?
    type = dressing_attribute(entity, 'UNIT_TYPE').to_s
    return nil unless DRESSING_UNIT_URLS.key?(type)
    return nil unless dressing_attribute(entity, 'SYSTEM').to_s == DRESSING_SYSTEM
    return nil unless dressing_attribute(entity, 'UNIT_SIGNATURE').to_s == DRESSING_SIGNATURES[type]
    type
  rescue
    nil
  end

  def self.selected_signed_dressing_unit
    Sketchup.active_model.selection.to_a.each do |entity|
      next unless entity.is_a?(Sketchup::ComponentInstance) || entity.is_a?(Sketchup::Group)
      type = dressing_unit_type(entity)
      return [entity, type] if type
    end
    nil
  rescue
    nil
  end

  def self.sign_dressing_unit!(entity, type)
    return false unless entity && entity.valid? && DRESSING_SIGNATURES.key?(type.to_s)
    owners = [entity]
    owners << entity.definition if entity.respond_to?(:definition) && entity.definition
    owners.each do |owner|
      owner.set_attribute(DRESSING_DICT, 'SYSTEM', DRESSING_SYSTEM)
      owner.set_attribute(DRESSING_DICT, 'UNIT_TYPE', type.to_s)
      owner.set_attribute(DRESSING_DICT, 'UNIT_SIGNATURE', DRESSING_SIGNATURES.fetch(type.to_s))
      owner.set_attribute(DRESSING_DICT, 'SIGNATURE_VERSION', 1)
      owner.set_attribute(DRESSING_DICT, 'FUNCTION_ROLE', 'wardrobe_root')
    end
    true
  end

  def self.load_dressing_engine(type)
    type = type.to_s
    return false unless DRESSING_UNIT_URLS.key?(type)
    return true if @loaded_dressing_engines && @loaded_dressing_engines[type]
    url = type == 'straight' ? DRESSING_STRAIGHT_URL : DRESSING_CORNER_URL
    cached = read_encrypted_cache_for_url(url, 'tool')
    if cached && !cached.to_s.strip.empty?
      eval(cached.force_encoding('UTF-8'), TOPLEVEL_BINDING, "(remote:dressing_#{type})", 1)
    else
      return false unless load_remote_ruby_live(url, key: "dressing_#{type}", cache_prefix: 'tool')
    end
    @loaded_dressing_engines ||= {}
    @loaded_dressing_engines[type] = true
    true
  rescue => error
    UI.messagebox("❌ تعذر تحميل أداة الدريسنج:\n#{error.message}")
    false
  end

  def self.dressing_constant_from_path(path)
    path.to_s.split('::').reject(&:empty?).inject(Object) do |parent, name|
      return nil unless parent.const_defined?(name, false)
      parent.const_get(name, false)
    end
  rescue NameError
    nil
  end

  def self.open_dressing_design_tool(type, selected_unit = nil)
    type = type.to_s
    return false unless DRESSING_UNIT_URLS.key?(type)
    if selected_unit && dressing_unit_type(selected_unit) != type
      UI.messagebox(MHDESIGN::Language.for_tool('library').t('TEXT_A7298C893875'))
      return false
    end
    return false unless load_dressing_engine(type)
    candidates = DRESSING_TOOL_CONSTANTS.fetch(type).filter_map { |name| dressing_constant_from_path(name) }
    matcher = type == 'corner' ? /corner|زاوي/i : /straight|designer|مستقيم/i
    constants.each do |constant_name|
      next unless constant_name.to_s.match?(matcher)
      candidate = const_get(constant_name)
      candidates << candidate if candidate.is_a?(Module)
    rescue NameError, LoadError
      next
    end
    candidates.uniq.each do |candidate|
      DRESSING_ENTRY_METHODS.each do |method_name|
        next unless candidate.respond_to?(method_name)
        entry = candidate.method(method_name)
        if entry.arity == 0
          entry.call
        elsif entry.arity == 1 || entry.arity < 0
          entry.call(selected_unit)
        else
          next
        end
        return true
      end
    end
    UI.messagebox("#{MHDESIGN::Language.for_tool('library').t('TEXT_F150A3D8ABEA')}#{type}.")
    false
  rescue => error
    UI.messagebox("❌ تعذر فتح أداة الدريسنج:\n#{error.message}")
    false
  end

  def self.prepare_dressing_unit(type, library_dialog)
    type = type.to_s
    return false unless DRESSING_UNIT_URLS.key?(type)
    return false if @dressing_unit_loading
    @dressing_unit_loading = true
    library_dialog.execute_script("window.updateEmbeddedLoading(8, 'جاري تجهيز أداة الدريسنج...');") rescue nil
    unless load_dressing_engine(type)
      library_dialog.execute_script("window.hideEmbeddedLoading();") rescue nil
      return false
    end
    library_dialog.execute_script("window.updateEmbeddedLoading(28, 'تم تجهيز الأداة، جاري تحميل الوحدة...');") rescue nil
    component = {
      url: DRESSING_UNIT_URLS.fetch(type),
      name: type == 'straight' ? 'وحدة دريسنج مستقيم' : 'وحدة دريسنج زاوية',
      dressing_type: type, progress_dialog: library_dialog
    }
    fetch_definition_async(component) do |definition|
      @dressing_unit_loading = false
      unless definition
        library_dialog.execute_script("window.hideEmbeddedLoading();") rescue nil
        next
      end
      begin
        library_dialog.execute_script("window.updateEmbeddedLoading(100, 'اكتمل التجهيز');") rescue nil
        library_dialog.close if library_dialog && library_dialog.respond_to?(:close)
        activate_smart_unit_placement(definition, component)
      rescue => error
        UI.messagebox("❌ تعذر تجهيز وحدة الدريسنج:\n#{error.message}")
      end
    end
    true
  rescue => error
    @dressing_unit_loading = false
    UI.messagebox("❌ تعذر تحميل وحدة الدريسنج:\n#{error.message}")
    false
  ensure
    @dressing_unit_loading = false unless @loaded_dressing_engines && @loaded_dressing_engines[type]
  end

  def self.activate_pricing_launcher_from_server
    begin
      ok_admin = load_remote_ruby_live(PRICING_ADMIN_URL, key: "pricing_admin", remove_consts: ["MHDESIGN::PricingAdmin"], cache_prefix: "tool")
      return false unless ok_admin
      ok_designer = load_remote_ruby_live(PRICING_DESIGNER_URL, key: "pricing_designer", remove_consts: ["MHDESIGN::PricingDesignerBoardV2"], cache_prefix: "tool")
      return false unless ok_designer
      ok_launcher = load_remote_ruby_live(PRICING_LAUNCHER_URL, key: "pricing_launcher", remove_consts: ["MHDESIGN::PricingLauncher"], cache_prefix: "tool")
      return false unless ok_launcher
      if defined?(MHDESIGN::PricingLauncher) && MHDESIGN::PricingLauncher.respond_to?(:open_selector)
        MHDESIGN::PricingLauncher.open_selector
        return true
      end
      UI.messagebox("⚠️ تم تحميل ملفات التسعير ✅ لكن لم أجد دالة التشغيل.\nلازم يكون فيه:\nMHDESIGN::PricingLauncher.open_selector")
      false
    rescue => e
      UI.messagebox("❌ فشل تحميل/تشغيل لوحة التسعير:\n#{e.message}")
      false
    end
  end

  def self.dynamic?(instance)
    return false unless instance.is_a?(Sketchup::ComponentInstance)
    !!instance.attribute_dictionary("dynamic_attributes", false)
  rescue
    false
  end

  def self.unwrap_to_dynamic!(instance)
    return instance if dynamic?(instance)
    ents = instance.definition.entities.to_a
    childs = ents.grep(Sketchup::ComponentInstance)
    dyn_childs = childs.select { |c| dynamic?(c) }
    return instance if dyn_childs.empty?
    model = Sketchup.active_model
    model.start_operation("Unwrap Dynamic Component", true)
    begin
      parent_ents = instance.parent.entities
      before_ids = parent_ents.to_a.map(&:entityID)
      instance.explode
      after = parent_ents.to_a.reject { |e| before_ids.include?(e.entityID) }
      after_insts = after.grep(Sketchup::ComponentInstance)
      dyn = after_insts.find { |x| dynamic?(x) } || after_insts.first
      model.selection.clear
      model.selection.add(dyn) if dyn
      model.commit_operation
      dyn || instance
    rescue
      model.abort_operation rescue nil
      instance
    end
  end

  @library_dialog = nil
  @library_dialog_hidden_for_placement = false
  @library_dialog_restore_position = nil

  def self.register_library_dialog(dialog)
    @library_dialog = dialog
    @library_dialog_hidden_for_placement = false
    dialog
  rescue
    dialog
  end

  def self.hide_library_for_placement
    dlg = @library_dialog
    return false unless dlg
    begin
      return true if @library_dialog_hidden_for_placement
      pos = dlg.get_position rescue nil
      @library_dialog_restore_position =
        if pos.is_a?(Array) && pos.length >= 2
          [pos[0].to_i, pos[1].to_i]
        else
          [DEFAULT_DIALOG_LEFT, DEFAULT_DIALOG_TOP]
        end
      dlg.set_position(-30000, -30000)
      @library_dialog_hidden_for_placement = true
      true
    rescue
      begin
        dlg.minimize
        @library_dialog_hidden_for_placement = true
        true
      rescue
        false
      end
    end
  end

  def self.restore_library_after_placement
    dlg = @library_dialog
    return false unless dlg
    return true unless @library_dialog_hidden_for_placement
    begin
      pos = @library_dialog_restore_position || [DEFAULT_DIALOG_LEFT, DEFAULT_DIALOG_TOP]
      dlg.set_position(pos[0].to_i, pos[1].to_i) rescue nil
      dlg.show rescue nil
      dlg.bring_to_front if dlg.respond_to?(:bring_to_front)
      @library_dialog_hidden_for_placement = false
      true
    rescue
      @library_dialog_hidden_for_placement = false
      false
    end
  end

  SMART_SNAP_DISTANCE = 20.cm unless const_defined?(:SMART_SNAP_DISTANCE, false)

  class SmartUnitPlacementTool
    def initialize(definition, comp_data = nil)
      @definition = definition
      @comp_data = comp_data
      @instance = nil
      @target = nil
      @mode = :free
      @placed = false
      @movement_plane_z = 0.0
      @ctrl_down = false
      @last_mouse_x = nil
      @last_mouse_y = nil
      @last_view = nil
    end

    def activate
      model = Sketchup.active_model
      @instance = model.active_entities.add_instance(@definition, Geom::Transformation.new)
      @movement_plane_z = @instance.bounds.min.z.to_f
      model.selection.clear
      model.selection.add(@instance)
      Sketchup.status_text = MHDESIGN::Language.for_tool('library').translate_source('حرّك الوحدة للسناب يمين أو شمال. اضغط Ctrl لإيقاف السناب واختيار الوحدة تحت الماوس للاستبدال.')
    rescue => e
      UI.messagebox("❌ تعذر بدء الإدراج الذكي:\n#{e.message}")
      model.select_tool(nil) rescue nil
    end

    def deactivate(view)
      erase_preview unless @placed
      MHDESIGN.restore_library_after_placement
      view.invalidate if view
    end

    def onCancel(reason, view)
      erase_preview
      MHDESIGN.restore_library_after_placement
      Sketchup.active_model.select_tool(nil)
      view.invalidate
    end

    def onKeyDown(key, repeat, flags, view)
      if key.to_i == 17
        @ctrl_down = true
        refresh_from_last_mouse(view)
      end
    end

    def onKeyUp(key, repeat, flags, view)
      if key.to_i == 17
        @ctrl_down = false
        refresh_from_last_mouse(view)
      end
    end

    def refresh_from_last_mouse(view = nil)
      active_view = view || @last_view
      return unless active_view && !@last_mouse_x.nil? && !@last_mouse_y.nil?
      onMouseMove(0, @last_mouse_x, @last_mouse_y, active_view)
    rescue
      active_view.invalidate if active_view
    end

    def onMouseMove(flags, x, y, view)
      return unless valid_instance?
      @last_mouse_x = x
      @last_mouse_y = y
      @last_view = view
      point = point_on_movement_plane(view, x, y)
      return unless point
      @target, @mode, tr = calculate_placement(point, @ctrl_down, view, x, y)
      @instance.transformation = tr if tr
      Sketchup.status_text = MHDESIGN::Language.for_tool('library').translate_source(case @mode
        when :replace then 'وضع الاستبدال: السناب متوقف والوحدة تحت الماوس محددة — اضغط للتأكيد.'
        when :snap_x_min, :snap_x_max then 'تم اختيار الجانب الفارغ تلقائيًا — اضغط لتثبيت الوحدة.'
        when :snap_wall then 'تم جذب الوحدة للحائط وتوجيه ضهرها إليه — اضغط لتثبيت الوحدة.'
        else 'حرّك الوحدة للسناب يمين أو شمال. اضغط Ctrl لإيقاف السناب واختيار الوحدة تحت الماوس للاستبدال.'
        end)
      view.invalidate
    rescue => e
      puts "MR Kitchen smart placement mouse error: #{e.message}"
    end

    def onLButtonDown(flags, x, y, view)
      return unless valid_instance?
      model = Sketchup.active_model
      replacement_target = (@ctrl_down && @mode == :replace && valid_target?(@target)) ? @target : nil
      final_instance = @instance
      begin
        final_instance = MHDESIGN.unwrap_to_dynamic!(final_instance)
        if @comp_data.is_a?(Hash) && @comp_data[:personal_library_id]
          final_instance = MHDESIGN.personal_unwrap_dressing!(final_instance)
        end
        replace_without_scale!(final_instance, replacement_target) if replacement_target
        MHDESIGN.write_source_metadata(final_instance, @comp_data) if final_instance && final_instance.valid?
        model.selection.clear
        model.selection.add(final_instance) if final_instance && final_instance.valid?
        @placed = true
        dressing_type = @comp_data.is_a?(Hash) ? (@comp_data[:dressing_type] || @comp_data['dressing_type']).to_s : ''
        if !dressing_type.empty? && final_instance && final_instance.valid?
          MHDESIGN.sign_dressing_unit!(final_instance, dressing_type)
          UI.start_timer(0.05, false) do
            MHDESIGN.open_dressing_design_tool(dressing_type, final_instance) if final_instance.valid?
          end
        else
          UI.start_timer(0.20, false) do
            MHDESIGN.open_options_automatically(final_instance) if final_instance && final_instance.valid?
          end
        end
      rescue => e
        UI.messagebox("❌ خطأ أثناء إنهاء إدراج الوحدة:\n#{e.message}")
      end
      MHDESIGN.restore_library_after_placement
      model.select_tool(nil)
      view.invalidate
    end

    def draw(view)
      return unless valid_target?(@target)
      points = entity_world_corners(@target)
      return if points.length != 8
      edges = [0,1, 1,3, 3,2, 2,0, 4,5, 5,7, 7,6, 6,4, 0,4, 1,5, 2,6, 3,7]
      view.line_width = 3
      view.drawing_color = (@mode == :replace ? 'red' : 'lime')
      view.draw(GL_LINES, edges.map { |i| points[i] })
    rescue
    end

    private

    def valid_instance?
      @instance && @instance.valid?
    end

    LIBRARY_UNIT_DEFINITION_PREFIXES = %w[BASE_UNIT WALL_UNIT TALL_UNIT].freeze
    ROOM_BUILDER_DICT = 'MHD_ROOM_BUILDER'.freeze

    def library_unit_component?(entity)
      return false unless entity.is_a?(Sketchup::ComponentInstance)
      return false unless entity.valid? && entity.visible?
      name = MHDESIGN::Language.original_definition_name(entity.definition).to_s.strip.upcase
      return false if name.empty?
      LIBRARY_UNIT_DEFINITION_PREFIXES.any? do |prefix|
        name == prefix || name.start_with?("#{prefix}#") || name.start_with?("#{prefix}_")
      end
    rescue
      false
    end

    def valid_target?(entity)
      entity && entity != @instance && library_unit_component?(entity)
    end

    def erase_preview
      @instance.erase! if valid_instance?
    rescue
    ensure
      @instance = nil
    end

    def point_on_movement_plane(view, x, y)
      ray = view.pickray(x, y)
      plane_origin = Geom::Point3d.new(0, 0, @movement_plane_z || 0.0)
      Geom.intersect_line_plane(ray, [plane_origin, Z_AXIS])
    rescue
      nil
    end

    def candidate_entities
      model = Sketchup.active_model
      model.active_entities.to_a.select do |entity|
        next false if entity == @instance
        library_unit_component?(entity)
      end
    rescue
      []
    end

    def normalized_axis(vector)
      v = vector.clone
      return nil if v.length <= 0.000001
      v.normalize!
      v
    rescue
      nil
    end

    def unit_axes(entity)
      tr = entity.transformation
      [tr.origin, normalized_axis(tr.xaxis) || X_AXIS, normalized_axis(tr.yaxis) || Y_AXIS, normalized_axis(tr.zaxis) || Z_AXIS]
    rescue
      [ORIGIN, X_AXIS, Y_AXIS, Z_AXIS]
    end

    def local_bounds(entity)
      entity.definition.bounds
    rescue
      entity.bounds
    end

    def entity_world_corners(entity)
      bounds_corners(local_bounds(entity)).map { |p| p.transform(entity.transformation) }
    rescue
      []
    end

    def bounds_corners(bounds)
      min = bounds.min
      max = bounds.max
      [
        Geom::Point3d.new(min.x, min.y, min.z), Geom::Point3d.new(max.x, min.y, min.z),
        Geom::Point3d.new(min.x, max.y, min.z), Geom::Point3d.new(max.x, max.y, min.z),
        Geom::Point3d.new(min.x, min.y, max.z), Geom::Point3d.new(max.x, min.y, max.z),
        Geom::Point3d.new(min.x, max.y, max.z), Geom::Point3d.new(max.x, max.y, max.z)
      ]
    end

    def coordinates_in_axes(point, origin, axes)
      v = origin.vector_to(point)
      [v.dot(axes[0]), v.dot(axes[1]), v.dot(axes[2])]
    end

    def extents_in_axes(entity, origin, axes)
      coords = entity_world_corners(entity).map { |p| coordinates_in_axes(p, origin, axes) }
      [coords.map { |a| a[0] }.min, coords.map { |a| a[0] }.max,
       coords.map { |a| a[1] }.min, coords.map { |a| a[1] }.max,
       coords.map { |a| a[2] }.min, coords.map { |a| a[2] }.max]
    end

    def target_under_mouse(view, x, y)
      return nil unless view && !x.nil? && !y.nil?
      helper = view.pick_helper
      helper.do_pick(x, y, 12)
      active_entities = Sketchup.active_model.active_entities
      count = helper.count.to_i
      (0...count).each do |index|
        path = helper.path_at(index) rescue nil
        next unless path.is_a?(Array)
        path.reverse_each do |entity|
          next if entity == @instance
          next unless entity && entity.valid? && entity.visible?
          next unless library_unit_component?(entity)
          parent_entities = entity.parent.respond_to?(:entities) ? entity.parent.entities : nil
          return entity if parent_entities == active_entities
        end
      end
      picked = helper.best_picked rescue nil
      while picked && picked.respond_to?(:parent)
        return picked if candidate_entities.include?(picked)
        parent = picked.parent
        break unless parent.respond_to?(:instances) || parent.respond_to?(:entities)
        picked = nil
      end
      nil
    rescue
      nil
    end

    def room_builder_wall?(entity)
      return false unless entity.respond_to?(:get_attribute)
      entity.get_attribute(ROOM_BUILDER_DICT, 'النوع').to_s == 'حائط'
    rescue
      false
    end

    def parse_room_builder_point(value)
      values = value.to_s.split('|').map(&:to_f)
      return nil unless values.length == 3
      Geom::Point3d.new(values[0], values[1], values[2])
    rescue
      nil
    end

    def wall_under_mouse(view, x, y)
      return nil unless view && !x.nil? && !y.nil?
      helper = view.pick_helper
      helper.do_pick(x, y, 12)
      count = helper.count.to_i
      (0...count).each do |index|
        path = helper.path_at(index) rescue nil
        next unless path.is_a?(Array)
        world_tr = Geom::Transformation.new
        path.each do |entity|
          next unless entity.is_a?(Sketchup::ComponentInstance) || entity.is_a?(Sketchup::Group)
          world_tr = world_tr * entity.transformation
          return [entity, world_tr] if room_builder_wall?(entity)
        end
      end
      nil
    rescue
      nil
    end

    def wall_snap_data(wall, world_tr)
      p1 = parse_room_builder_point(wall.get_attribute(ROOM_BUILDER_DICT, 'P1'))
      p2 = parse_room_builder_point(wall.get_attribute(ROOM_BUILDER_DICT, 'P2'))
      return nil unless p1 && p2
      a = p1.transform(world_tr)
      b = p2.transform(world_tr)
      tangent = a.vector_to(b)
      return nil if tangent.length < 0.1.mm
      tangent.normalize!
      inward = Z_AXIS.cross(tangent)
      inward.normalize!
      [a, b, tangent, inward]
    rescue
      nil
    end

    def closest_point_on_wall_segment(point, a, b, side_margin = 0.0)
      segment = a.vector_to(b)
      length = segment.length
      return a if length < 0.000001
      tangent = segment.clone
      tangent.normalize!
      distance = a.vector_to(point).dot(tangent)
      margin = [[side_margin.to_f, 0.0].max, length * 0.5].min
      distance = [[distance, margin].max, length - margin].min
      a.offset(tangent, distance)
    rescue
      a
    end

    def wall_snapped_transform(wall, wall_world_tr, mouse_point)
      data = wall_snap_data(wall, wall_world_tr)
      return nil unless data
      a, b, tangent, inward = data
      lxmin, lxmax, lymin, lymax, lzmin, _lzmax = definition_bounds_values
      local_center_x = (lxmin + lxmax) * 0.5
      half_width = (lxmax - lxmin).abs * 0.5
      yaxis = Geom::Vector3d.new(-inward.x, -inward.y, 0)
      yaxis.normalize!
      zaxis = Z_AXIS.clone
      xaxis = yaxis.cross(zaxis)
      xaxis.normalize!
      anchor = closest_point_on_wall_segment(mouse_point, a, b, half_width)
      back_bottom_center = Geom::Point3d.new(anchor.x, anchor.y, @movement_plane_z.to_f)
      new_origin = back_bottom_center.offset(xaxis, -local_center_x).offset(yaxis, -lymax).offset(zaxis, -lzmin)
      Geom::Transformation.axes(new_origin, xaxis, yaxis, zaxis)
    rescue
      nil
    end

    def calculate_placement(point, ctrl_down = false, view = nil, mouse_x = nil, mouse_y = nil)
      if ctrl_down
        picked = target_under_mouse(view, mouse_x, mouse_y)
        if valid_target?(picked)
          origin, xaxis, yaxis, zaxis = unit_axes(picked)
          axes = [xaxis, yaxis, zaxis]
          ext = extents_in_axes(picked, origin, axes)
          if ext && ext.all?
            return [picked, :replace, replacement_preview_transform(origin, axes, ext)]
          end
        end
        return [nil, :free, free_transform(point)]
      end
      wall_pick = wall_under_mouse(view, mouse_x, mouse_y)
      if wall_pick
        wall, wall_world_tr = wall_pick
        wall_tr = wall_snapped_transform(wall, wall_world_tr, point)
        return [wall, :snap_wall, wall_tr] if wall_tr
      end
      best = nil
      best_score = nil
      picked_target = target_under_mouse(view, mouse_x, mouse_y)
      candidate_entities.each do |entity|
        origin, xaxis, yaxis, zaxis = unit_axes(entity)
        axes = [xaxis, yaxis, zaxis]
        ext = extents_in_axes(entity, origin, axes)
        next unless ext.all?
        px, py, pz = coordinates_in_axes(point, origin, axes)
        xmin, xmax, ymin, ymax, zmin, zmax = ext
        dx = px < xmin ? xmin - px : (px > xmax ? px - xmax : 0.0)
        dy = py < ymin ? ymin - py : (py > ymax ? py - ymax : 0.0)
        score = Math.sqrt(dx * dx + dy * dy)
        score -= SMART_SNAP_DISTANCE * 10.0 if entity == picked_target
        next if entity != picked_target && score > SMART_SNAP_DISTANCE
        if best_score.nil? || score < best_score
          best = [entity, origin, axes, ext, [px, py, pz]]
          best_score = score
        end
      end
      return [nil, :free, free_transform(point)] unless best
      entity, origin, axes, ext, coords = best
      xmin, xmax, ymin, ymax, zmin, zmax = ext
      px, py, pz = coords
      width = [xmax - xmin, 0.001].max
      depth = [ymax - ymin, 0.001].max
      left_distance  = (px - xmin).abs
      right_distance = (px - xmax).abs
      preferred = left_distance <= right_distance ? :snap_x_min : :snap_x_max
      alternate = preferred == :snap_x_min ? :snap_x_max : :snap_x_min
      preferred_occupied = snap_side_occupied?(entity, preferred, origin, axes, ext)
      alternate_occupied = snap_side_occupied?(entity, alternate, origin, axes, ext)
      mode = if !preferred_occupied then preferred
             elsif !alternate_occupied then alternate
             else return [nil, :free, free_transform(point)]
             end
      [entity, mode, snapped_transform(origin, axes, ext, mode)]
    rescue
      [nil, :free, free_transform(point)]
    end

    def ranges_overlap_amount(a_min, a_max, b_min, b_max)
      [a_max, b_max].min - [a_min, b_min].max
    end

    def snap_side_occupied?(target, mode, target_origin, axes, target_ext)
      txmin, txmax, tymin, tymax, tzmin, tzmax = target_ext
      target_depth = [tymax - tymin, 0.001].max
      target_height = [tzmax - tzmin, 0.001].max
      touch_tolerance = 3.cm.to_f
      candidate_entities.any? do |other|
        next false if other == target || other == @instance
        other_ext = extents_in_axes(other, target_origin, axes)
        next false unless other_ext && other_ext.all?
        oxmin, oxmax, oymin, oymax, ozmin, ozmax = other_ext
        y_overlap = ranges_overlap_amount(tymin, tymax, oymin, oymax)
        z_overlap = ranges_overlap_amount(tzmin, tzmax, ozmin, ozmax)
        next false if y_overlap < target_depth * 0.35
        next false if z_overlap < target_height * 0.35
        gap = mode == :snap_x_min ? (txmin - oxmax).abs : (oxmin - txmax).abs
        gap <= touch_tolerance
      end
    rescue
      false
    end

    def definition_bounds_values
      b = @definition.bounds
      [b.min.x, b.max.x, b.min.y, b.max.y, b.min.z, b.max.z]
    end

    def axes_transform(origin, axes)
      Geom::Transformation.axes(origin, axes[0], axes[1], axes[2])
    end

    def origin_from_local_min(world_corner, axes, local_x, local_y, local_z)
      world_corner.offset(axes[0], -local_x).offset(axes[1], -local_y).offset(axes[2], -local_z)
    end

    def free_transform(point)
      Geom::Transformation.translation(point)
    end

    def snapped_transform(target_origin, axes, ext, mode)
      xmin, xmax, ymin, _ymax, zmin, _zmax = ext
      lxmin, lxmax, lymin, _lymax, lzmin, _lzmax = definition_bounds_values
      wx = mode == :snap_x_min ? xmin : xmax
      local_x = mode == :snap_x_min ? lxmax : lxmin
      corner = target_origin.offset(axes[0], wx).offset(axes[1], ymin).offset(axes[2], zmin)
      new_origin = origin_from_local_min(corner, axes, local_x, lymin, lzmin)
      axes_transform(new_origin, axes)
    end

    def replacement_preview_transform(target_origin, axes, ext)
      xmin, xmax, ymin, ymax, zmin, _zmax = ext
      lxmin, lxmax, lymin, lymax, lzmin, _lzmax = definition_bounds_values
      target_cx = (xmin + xmax) * 0.5
      target_cy = (ymin + ymax) * 0.5
      local_cx = (lxmin + lxmax) * 0.5
      local_cy = (lymin + lymax) * 0.5
      desired = target_origin.offset(axes[0], target_cx).offset(axes[1], target_cy).offset(axes[2], zmin)
      new_origin = desired.offset(axes[0], -local_cx).offset(axes[1], -local_cy).offset(axes[2], -lzmin)
      axes_transform(new_origin, axes)
    end

    def dc_engine
      return nil unless defined?($dc_observers) && $dc_observers
      $dc_observers.get_latest_class
    rescue
      nil
    end

    def normalize_ar(text)
      s = text.to_s.gsub(/<[^>]*>/, '').strip
      s = s.tr('أإآٱ', 'اااا')
      s = s.tr('ةى', 'هي')
      s = s.gsub(/[ًٌٍَُِّْـ]/, '')
      s.gsub(/\s+/, '').downcase
    end

    def dc_keys_from_definition(ent)
      dict = ent.definition.attribute_dictionary('dynamic_attributes', false)
      return [] unless dict
      keys = []
      dict.each_pair do |key, _value|
        key = key.to_s
        next unless key.start_with?('_') && key.end_with?('_access')
        keys << key.sub(/^_/, '').sub(/_access$/, '')
      end
      keys.uniq
    rescue
      []
    end

    def dimension_attr(ent, dimension, d)
      dc_keys_from_definition(ent).each do |key|
        label = begin
          d.get_attribute_formlabel(ent, key).to_s
        rescue
          key.to_s
        end
        n = normalize_ar(label)
        next if n.include?('درج')
        chassis = n.include?('شاسي') || n.include?('شاسه')
        next unless chassis
        matched =
          case dimension
          when :width then n.include?('عرض')
          when :depth then n.include?('عمق')
          when :height then n.include?('ارتفاع') && !n.include?('رجل') && !n.include?('رجول') && !n.include?('ارجل')
          else false
          end
        return { key: key } if matched
      end
      nil
    rescue
      nil
    end

    def dimension_attrs(ent, d)
      { width: dimension_attr(ent, :width, d), depth: dimension_attr(ent, :depth, d), height: dimension_attr(ent, :height, d) }
    end

    def read_dc_value(d, ent, attr)
      d.get_attribute_value(ent, attr[:key].to_s).to_f
    rescue
      ent.get_attribute('dynamic_attributes', attr[:key].to_s, 0.0).to_f
    end

    def apply_dc_value(d, ent, key, value)
      formula_key = "_#{key}_formula"
      begin
        ent.delete_attribute('dynamic_attributes', formula_key)
      rescue
      end
      begin
        d.set_attribute(ent, key, value)
      rescue
        ent.set_attribute('dynamic_attributes', key, value)
      end
    end

    def rigid_slot_snapshot(ent)
      tr = ent.transformation
      xaxis = normalized_axis(tr.xaxis)
      yaxis = normalized_axis(tr.yaxis)
      zaxis = normalized_axis(tr.zaxis)
      return nil unless xaxis && yaxis && zaxis
      { origin: tr.origin.clone, xaxis: xaxis, yaxis: yaxis, zaxis: zaxis }
    rescue
      nil
    end

    def place_in_rigid_slot(ent, slot)
      current = rigid_slot_snapshot(ent)
      return false unless current && slot
      current_rigid = Geom::Transformation.axes(current[:origin], current[:xaxis], current[:yaxis], current[:zaxis])
      target_rigid = Geom::Transformation.axes(slot[:origin], slot[:xaxis], slot[:yaxis], slot[:zaxis])
      ent.transform!(target_rigid * current_rigid.inverse)
      true
    rescue
      false
    end

    def replace_without_scale!(new_unit, old_unit)
      raise MHDESIGN::Language.for_tool('library').t('TEXT_35E4B04D4C7A') unless new_unit && new_unit.valid?
      raise MHDESIGN::Language.for_tool('library').t('TEXT_843194327159') unless old_unit && old_unit.valid?
      raise MHDESIGN::Language.for_tool('library').t('TEXT_F9FB63309B17') unless old_unit.is_a?(Sketchup::ComponentInstance)
      d = dc_engine
      raise MHDESIGN::Language.for_tool('library').t('TEXT_F409C94BF268') unless d
      old_attrs = dimension_attrs(old_unit, d)
      new_attrs = dimension_attrs(new_unit, d)
      dimensions = [:width, :depth, :height]
      missing = dimensions.select { |dim| old_attrs[dim].nil? || new_attrs[dim].nil? }
      unless missing.empty?
        names = { width: 'العرض', depth: 'العمق', height: 'الارتفاع' }
        raise "#{MHDESIGN::Language.for_tool('library').t('TEXT_F7550CD6B535')}#{missing.map { |x| names[x] }.join('، ')}"
      end
      values = {}
      dimensions.each { |dim| values[dim] = read_dc_value(d, old_unit, old_attrs[dim]) }
      slot = rigid_slot_snapshot(old_unit)
      raise MHDESIGN::Language.for_tool('library').t('TEXT_7DF21DD0EC0C') unless slot
      model = Sketchup.active_model
      model.start_operation('MR Kitchen Replace Unit', true)
      forced = {}
      dimensions.each do |dim|
        key = new_attrs[dim][:key].to_s
        value = values[dim]
        forced[key] = value
        apply_dc_value(d, new_unit, key, value)
      end
      forced.each { |key, value| d.set_forced_config_value(new_unit, key, value) }
      d.run_all_formulas(new_unit)
      d.redraw(new_unit, false, false)
      d.update_last_sizes(new_unit)
      d.clear_forced_config_values(new_unit)
      d.run_all_formulas(new_unit)
      d.redraw(new_unit, false, false)
      d.update_last_sizes(new_unit)
      raise MHDESIGN::Language.for_tool('library').t('TEXT_9B6E255EA54F') unless place_in_rigid_slot(new_unit, slot)
      old_unit.erase!
      begin
        d.refresh_dialogs
        d.refresh_configure_dialog
      rescue
      end
      model.commit_operation
      model.active_view.invalidate
      true
    rescue => e
      begin
        d.clear_forced_config_values(new_unit) if d && new_unit
      rescue
      end
      begin
        model.abort_operation if model
      rescue
      end
      raise e
    end
  end

  def self.close_options_dialog_before_placement
    mod = options_protected_module
    return true unless mod
    begin
      dlg = mod.instance_variable_get(:@dlg)
      if dlg
        dlg.close rescue nil
        mod.instance_variable_set(:@dlg, nil) rescue nil
      end
    rescue
    end
    [:close, :hide, :close_dialog, :hide_dialog].each do |method_name|
      begin
        mod.send(method_name) if mod.respond_to?(method_name)
      rescue
      end
    end
    true
  rescue
    true
  end

  def self.focus_sketchup_for_placement
    begin
      Sketchup.focus if Sketchup.respond_to?(:focus)
    rescue
    end
    UI.start_timer(0.01, false) do
      begin
        Sketchup.focus if Sketchup.respond_to?(:focus)
      rescue
      end
    end
    true
  rescue
    true
  end

  def self.activate_smart_unit_placement(definition, comp_data = nil)
    close_options_dialog_before_placement
    focus_sketchup_for_placement
    Sketchup.active_model.select_tool(SmartUnitPlacementTool.new(definition, comp_data))
    UI.start_timer(0.02, false) { focus_sketchup_for_placement }
    true
  rescue => e
    restore_library_after_placement
    UI.messagebox("❌ فشل تشغيل الإدراج الذكي:\n#{e.message}")
    false
  end

  class PlaceAndUnwrapObserver < Sketchup::EntitiesObserver
    def initialize(target_def, comp_data = nil)
      @target_def = target_def
      @comp_data  = comp_data
      @done = false
    end
    def onElementAdded(entities, entity)
      return if @done
      return unless entity.is_a?(Sketchup::ComponentInstance)
      return unless entity.definition == @target_def
      @done = true
      model = Sketchup.active_model
      UI.start_timer(0.0, false) do
        begin
          inst2 = MHDESIGN.unwrap_to_dynamic!(entity)
          MHDESIGN.write_source_metadata(inst2, @comp_data) if inst2
          model.selection.clear
          model.selection.add(inst2) if inst2
          UI.start_timer(0.20, false) { MHDESIGN.open_options_automatically(inst2) if inst2 && inst2.valid? }
        rescue => e
          UI.messagebox("#{MHDESIGN::Language.for_tool('library').t('TEXT_11B99522552C')}#{e.message}")
        ensure
          begin
            entities.remove_observer(self)
          rescue
          end
        end
      end
    end
  end

  def self.install_place_observer_for(definition, comp_data = nil)
    ents = Sketchup.active_model.entities
    obs = PlaceAndUnwrapObserver.new(definition, comp_data)
    ents.add_observer(obs)
    UI.start_timer(20.0, false) do
      begin
        ents.remove_observer(obs)
      rescue
      end
    end
  end

  def self.fetch_definition_async(comp, &block)
    begin
      url = comp[:url].to_s
      raise "#{MHDESIGN::Language.for_tool('library').t('TEXT_738F4B1CB542')}" if url.to_s.strip.empty?
      model = Sketchup.active_model
      progress = nil
      embedded_progress = comp.is_a?(Hash) ? comp[:progress_dialog] : nil
      embedded_progress_label = comp.is_a?(Hash) && comp[:dressing_type] ? 'جاري تحميل وحدة الدريسنج...' : 'جاري تحميل المكون...'
      unless cache_exists_and_nonempty_for_url?(url, "skp") || embedded_progress
        progress = UI::HtmlDialog.new({
          :dialog_title => "تحميل المكون...",
          :preferences_key => "mrkitchen_progress",
          :scrollable => false, :resizable => false, :width => 300, :height => 150
        })
        progress.set_html <<-HTML
          <html><head>
            <meta charset="UTF-8">
            <link rel="preconnect" href="https://fonts.googleapis.com">
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
            <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;800&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
            <style>
              body { font-family:'Tajawal',sans-serif; text-align:center; margin:0; padding:20px; direction:rtl; }
              h3 { margin: 10px 0; }
              #progress-bar { width: 100%; height: 20px; background: #ddd; border-radius: 10px; overflow: hidden; margin-top: 10px; }
              #progress-fill { height: 100%; width: 0%; background: #4caf50; transition: width 0.2s ease; }
              #percent { margin-top: 8px; font-size: 14px; }
            #{MHDESIGN_ResponsiveHeaderUI::CSS}
html { color-scheme: dark; }
body { background: var(--ref-bg); color: var(--ref-text); padding: 6px; font: 12px/1.35 "Segoe UI", Tahoma, Arial, sans-serif; }
.mhd-ref-header { min-height: 44px; padding: 3px 5px; border: 1px solid var(--ref-border); border-radius: 8px; }
.mhd-ref-header :is(.title, h3) { font-size: 14px; }
.mhd-ref-header .mhd-ref-logo { max-height: 32px; }
.mhd-ref-header .mhd-ref-art svg { width: 40px; height: 42px; }
.wrap { gap: 6px; }
.sub, .name { color: var(--ref-muted); }
.bar, #progress-bar { background: var(--ref-input); border: 1px solid var(--ref-border); height: 12px; }
.fill, #progress-fill { background: var(--ref-action); }
            </style>
          </head><body>
            <header class="mhd-ref-header">#{MHDESIGN_ResponsiveHeaderUI::BRAND}<div class="mhd-ref-heading"><h3>#{MHDESIGN::Language.for_tool('library').html('TEXT_D73886D8DFD6')}</h3></div></header>
            <div id="progress-bar"><div id="progress-fill"></div></div>
            <div id="percent">0%</div>
          </body></html>
        HTML
        progress.show
      end
      UI.start_timer(0.1, false) do
        tempfile = nil
        begin
          if cache_exists_and_nonempty_for_url?(url, "skp")
            raw_data = read_encrypted_cache_for_url(url, "skp")
            raise "#{MHDESIGN::Language.for_tool('library').t('TEXT_53DE5776DB41')}" if raw_data.nil? || raw_data.bytesize == 0
          else
            content_length = nil
            downloaded = +""
            URI.open(url, "rb", open_timeout: OPEN_TIMEOUT, read_timeout: READ_TIMEOUT,
              content_length_proc: ->(len) { content_length = len },
              progress_proc: ->(bytes) {
                percent = content_length ? ((bytes.to_f / content_length) * 100).to_i : 0
                if progress
                  progress.execute_script("document.getElementById('progress-fill').style.width = '#{percent}%'") rescue nil
                  progress.execute_script("document.getElementById('percent').innerText = '#{percent}%'") rescue nil
                elsif embedded_progress
                  shown_percent = 30 + (percent * 0.62).to_i
                  embedded_progress.execute_script("window.updateEmbeddedLoading(#{shown_percent}, #{embedded_progress_label.to_json});") rescue nil
                end
              }
            ) do |remote_file|
              downloaded = remote_file.read.to_s
            end
            raise "#{MHDESIGN::Language.for_tool('library').t('TEXT_7A0B1BB1C66E')}" if downloaded.nil? || downloaded.bytesize == 0
            write_encrypted_cache_for_url(url, downloaded, "skp")
            raw_data = downloaded
          end
          tempfile = Tempfile.new(["mrkitchen_component", ".skp"])
          tempfile.binmode
          tempfile.write(raw_data)
          tempfile.flush
          tempfile.close
          progress.close if progress && progress.visible?
          embedded_progress.execute_script("window.updateEmbeddedLoading(94, 'جاري تجهيز الوحدة والمقاسات...');") rescue nil if embedded_progress
          definition = model.definitions.load(tempfile.path, allow_newer: true)
          embedded_progress.execute_script("window.updateEmbeddedLoading(100, 'اكتمل التجهيز');") rescue nil if embedded_progress
          block.call(definition) if block
        rescue => e
          begin
            progress.close if progress && progress.visible?
          rescue
          end
          embedded_progress.execute_script("window.hideEmbeddedLoading();") rescue nil if embedded_progress
          UI.messagebox("#{MHDESIGN::Language.for_tool('library').t('TEXT_B41A89D94226')}#{e.message}")
          block.call(nil) if block
        ensure
          begin
            tempfile.close if tempfile && !tempfile.closed?
          rescue
          end
          begin
            tempfile.unlink if tempfile
          rescue
          end
        end
      end
    rescue => e
      UI.messagebox("#{MHDESIGN::Language.for_tool('library').t('TEXT_19FC570B4BC2')}#{e.message}")
      block.call(nil) if block
    end
  end

  def self.call_invoice_plugin
    begin
      ok = load_remote_ruby_live(INVOICE_PLUGIN_URL, key: "invoice_plugin", remove_consts: ["MHDesign::MHInvoice"], cache_prefix: "plugin")
      return false unless ok
      if defined?(MHDesign) && MHDesign.const_defined?(:MHInvoice)
        mod = MHDesign.const_get(:MHInvoice)
        if mod.respond_to?(:open_invoice_dialog)
          mod.open_invoice_dialog
          return true
        else
          UI.messagebox("#{MHDESIGN::Language.for_tool('library').t('TEXT_38F5F127156E')}")
          return false
        end
      end
      UI.messagebox("#{MHDESIGN::Language.for_tool('library').t('TEXT_6B44131A3660')}")
      false
    rescue => e
      UI.messagebox("❌ فشل تحميل/تشغيل إضافة الفواتير:\n#{e.message}")
      false
    end
  end

  def self.call_reports_plugin
    begin
      ok = load_remote_ruby_live(REPORTS_PLUGIN_URL, key: "reports_plugin", remove_consts: ["MHDESIGN::ReportUnits"], cache_prefix: "plugin")
      return false unless ok
      if defined?(MHDESIGN) && MHDESIGN.const_defined?(:ReportUnits)
        mod = MHDESIGN.const_get(:ReportUnits)
        [:run, :start, :open_dialog, :show_dialog, :open, :show, :main, :generate].each do |m|
          begin
            if mod.respond_to?(m)
              mod.send(m)
              return true
            end
          rescue
          end
        end
        list = (mod.methods(false).map(&:to_s).sort rescue [])
        UI.messagebox("⚠️ report_units.rb اتحمّل ✅ لكن لم أجد دالة تشغيل.\nالدوال المتاحة داخل MHDESIGN::ReportUnits:\n- " + list.first(40).join("\n- "))
        return false
      end
      UI.messagebox("#{MHDESIGN::Language.for_tool('library').t('TEXT_F5D188DD2EC6')}")
      false
    rescue => e
      UI.messagebox("❌ فشل تحميل/تشغيل إضافة التقارير:\n#{e.message}")
      false
    end
  end

  module MHDESIGN_UNIQUIFY
    def self.make_all_components_unique(entities)
      entities.grep(Sketchup::ComponentInstance).each do |instance|
        instance.make_unique
        make_all_components_unique(instance.definition.entities)
      end
    end
    def self.make_definitions_unique
      model = Sketchup.active_model
      model.definitions.each do |definition|
        next if definition.group? || definition.image?
        definition.instances.each do |instance|
          instance.make_unique
          make_all_components_unique(instance.definition.entities)
        end
      end
    end
    def self.run_uniquify
      model = Sketchup.active_model
      model.start_operation("جعل كل المكونات فريدة", true)
      make_all_components_unique(model.entities)
      make_definitions_unique
      model.commit_operation
      UI.messagebox("#{MHDESIGN::Language.for_tool('library').t('TEXT_3AB2396C1F45')}")
    end
  end

  def self._blank_rgba(w, h)
    Array.new(w * h * 4, 0)
  end

  def self._set_px(pixels, w, x, y, r=0, g=0, b=0, a=255)
    return if x < 0 || y < 0 || x >= w
    idx = (y * w + x) * 4
    pixels[idx]     = r
    pixels[idx + 1] = g
    pixels[idx + 2] = b
    pixels[idx + 3] = a
  end

  def self._draw_line(pixels, w, x0, y0, x1, y1, r=0, g=0, b=0, a=255)
    dx = (x1 - x0).abs
    sx = x0 < x1 ? 1 : -1
    dy = -(y1 - y0).abs
    sy = y0 < y1 ? 1 : -1
    err = dx + dy
    loop do
      _set_px(pixels, w, x0, y0, r, g, b, a)
      break if x0 == x1 && y0 == y1
      e2 = 2 * err
      if e2 >= dy
        err += dy
        x0 += sx
      end
      if e2 <= dx
        err += dx
        y0 += sy
      end
    end
  end

  def self._draw_arrow_head(pixels, w, tipx, tipy, dir)
    case dir
    when :left
      _draw_line(pixels, w, tipx, tipy, tipx + 6, tipy - 4)
      _draw_line(pixels, w, tipx, tipy, tipx + 6, tipy + 4)
    when :right
      _draw_line(pixels, w, tipx, tipy, tipx - 6, tipy - 4)
      _draw_line(pixels, w, tipx, tipy, tipx - 6, tipy + 4)
    end
  end

  def self._write_cur(path, w, h, hotx, hoty, pixels_rgba)
    raise "bad size" unless w > 0 && h > 0
    xor_row_bytes = w * 4
    xor_bytes = xor_row_bytes * h
    mask_row_bytes = ((w + 31) / 32) * 4
    mask_bytes = mask_row_bytes * h
    bi_size = 40
    bi_width = w
    bi_height = h * 2
    bi_planes = 1
    bi_bitcount = 32
    bi_compression = 0
    bi_sizeimage = xor_bytes + mask_bytes
    bi_xppm = 0
    bi_yppm = 0
    bi_clrused = 0
    bi_clrimportant = 0
    header = [bi_size, bi_width, bi_height, bi_planes, bi_bitcount, bi_compression, bi_sizeimage, bi_xppm, bi_yppm, bi_clrused, bi_clrimportant].pack("V3v2V6")
    xor = +""
    (h-1).downto(0) do |y|
      (0...w).each do |x|
        idx = (y * w + x) * 4
        r = pixels_rgba[idx]
        g = pixels_rgba[idx + 1]
        b = pixels_rgba[idx + 2]
        a = pixels_rgba[idx + 3]
        xor << b.chr << g.chr << r.chr << a.chr
      end
    end
    and_mask = "\x00" * mask_bytes
    image_data = header + xor + and_mask
    icondir = [0, 2, 1].pack("v3")
    width_byte  = (w == 256 ? 0 : w)
    height_byte = (h == 256 ? 0 : h)
    bytes_in_res = image_data.bytesize
    image_offset = 6 + 16
    entry = [width_byte, height_byte, 0, 0, hotx, hoty, bytes_in_res, image_offset].pack("C4v2V2")
    File.binwrite(path, icondir + entry + image_data)
    true
  rescue
    false
  end

  def self._make_rotate_pixels(w=32, h=32)
    px = _blank_rgba(w, h)
    pts = [[10,10],[13,8],[16,7],[19,8],[22,10],[24,13],[25,16],[24,19],[22,22],[19,24],[16,25],[13,24],[11,22]]
    (0...pts.length-1).each { |i| _draw_line(px, w, pts[i][0], pts[i][1], pts[i+1][0], pts[i+1][1], 0,0,0,255) }
    _draw_arrow_head(px, w, 10, 10, :left)
    px
  end

  def self._make_flip_pixels(w=32, h=32)
    px = _blank_rgba(w, h)
    _draw_line(px, w, 7, 16, 25, 16, 0,0,0,255)
    _draw_arrow_head(px, w, 7, 16, :left)
    _draw_arrow_head(px, w, 25, 16, :right)
    px
  end

  def self._cursor_from_temp_cur(name)
    path = File.join(Dir.tmpdir, "mrkitchen_cursor_#{name}.cur")
    w = 32
    h = 32
    hotx = 8
    hoty = 8
    pixels = case name
             when :rotate then _make_rotate_pixels(w, h)
             when :flip   then _make_flip_pixels(w, h)
             else nil
             end
    return nil unless pixels
    ok = _write_cur(path, w, h, hotx, hoty, pixels)
    return nil unless ok && File.exist?(path) && File.size(path) > 0
    id = UI.create_cursor(path, hotx, hoty)
    return nil if id.nil? || id.to_i == 0
    id
  rescue
    nil
  end

  ROTATE_CURSOR_ID = _cursor_from_temp_cur(:rotate)
  FLIP_CURSOR_ID   = _cursor_from_temp_cur(:flip)

  class MHDRotate90Tool
    def _apply_cursor
      return false unless ROTATE_CURSOR_ID && ROTATE_CURSOR_ID.to_i != 0
      UI.set_cursor(ROTATE_CURSOR_ID)
      true
    rescue
      false
    end
    def onSetCursor; _apply_cursor; end
    def onMouseMove(flags, x, y, view); _apply_cursor; end
    def onKeyDown(key, repeat, flags, view); _apply_cursor; end
    def onLButtonDown(flags, x, y, view)
      model = Sketchup.active_model
      ph = view.pick_helper
      ph.do_pick(x, y)
      ent = ph.best_picked
      return unless ent.is_a?(Sketchup::ComponentInstance) || ent.is_a?(Sketchup::Group)
      model.start_operation("MR Kitchen Rotate 45", true)
      begin
        center = ent.bounds.center
        axis   = Geom::Vector3d.new(0, 0, 1)
        angle  = 45.degrees
        tr = Geom::Transformation.rotation(center, axis, angle)
        ent.transform!(tr)
      ensure
        model.commit_operation
      end
    end
  end

  def self.activate_rotate_tool
    Sketchup.active_model.select_tool(MHDRotate90Tool.new)
  end

  class MHDFlipLRTool
    def _apply_cursor
      return false unless FLIP_CURSOR_ID && FLIP_CURSOR_ID.to_i != 0
      UI.set_cursor(FLIP_CURSOR_ID)
      true
    rescue
      false
    end
    def onSetCursor; _apply_cursor; end
    def onMouseMove(flags, x, y, view); _apply_cursor; end
    def onKeyDown(key, repeat, flags, view); _apply_cursor; end
    def onLButtonDown(flags, x, y, view)
      model = Sketchup.active_model
      ph = view.pick_helper
      ph.do_pick(x, y)
      ent = ph.best_picked
      return unless ent.is_a?(Sketchup::ComponentInstance) || ent.is_a?(Sketchup::Group)
      model.start_operation("MR Kitchen Flip L/R", true)
      begin
        tr = ent.transformation
        origin = tr.origin
        xaxis  = tr.xaxis
        yaxis  = tr.yaxis
        zaxis  = tr.zaxis
        basis = Geom::Transformation.axes(origin, xaxis, yaxis, zaxis)
        mirror_local = Geom::Transformation.scaling(-1, 1, 1)
        mirror_world = basis * mirror_local * basis.inverse
        ent.transform!(mirror_world)
      ensure
        model.commit_operation
      end
    end
  end

  def self.activate_flip_lr_tool
    Sketchup.active_model.select_tool(MHDFlipLRTool.new)
  end

  def self.activate_click_side_snap_tool
    begin
      ok = load_remote_ruby_live(SNAP_TOOL_URL, key: "snap_tool",
        remove_consts: ["MHDESIGN::ClickSideSnapTool_VisibleBounds", "MHDESIGN::ClickSideSnapTool_HybridNativeSnap", "MHDESIGN::ClickSideSnapTool_CornerHandles"],
        cache_prefix: "tool")
      return false unless ok
      if defined?(MHDESIGN::ClickSideSnapTool_CornerHandles)
        Sketchup.active_model.select_tool(MHDESIGN::ClickSideSnapTool_CornerHandles.new)
        return true
      end
      if defined?(MHDESIGN::ClickSideSnapTool_HybridNativeSnap)
        Sketchup.active_model.select_tool(MHDESIGN::ClickSideSnapTool_HybridNativeSnap.new)
        return true
      end
      if defined?(MHDESIGN::ClickSideSnapTool_VisibleBounds)
        Sketchup.active_model.select_tool(MHDESIGN::ClickSideSnapTool_VisibleBounds.new)
        return true
      end
      UI.messagebox("#{MHDESIGN::Language.for_tool('library').t('TEXT_17EEFB8D154E')}")
      false
    rescue => e
      UI.messagebox("#{MHDESIGN::Language.for_tool('library').t('TEXT_A78FCC29CB04')}#{e.message}")
      false
    end
  end

  # ==================== Library UI ====================
  def self.show_library
    purge_legacy_remote_tool_cache_silent
    return unless ensure_no_legacy_local_plugins!
    unless activate(false)
      activate(true)
      return
    end
    update_result = handle_update_gate!
    return if update_result == :abort
    selected_dressing = selected_signed_dressing_unit
    return open_dressing_design_tool(selected_dressing[1], selected_dressing[0]) if selected_dressing
    saved_country = ensure_country_selected
    return if saved_country.nil? || saved_country.to_s.empty?
    preload_assets_cache_with_progress(saved_country)
    load_core_context_tools_from_server
    load_options_protected_from_server

    saved_lower = get_saved_lower_mode
    saved_upper = get_saved_upper_mode
    saved_library_mode = Sketchup.read_default(PLUGIN_NAME, 'library_mode').to_s
    saved_library_mode = 'kitchens' unless %w[kitchens dressing personal].include?(saved_library_mode)

    saved_w = (Sketchup.read_default(PLUGIN_NAME, "dlg_w") || DEFAULT_DIALOG_WIDTH).to_i
    saved_h = (Sketchup.read_default(PLUGIN_NAME, "dlg_h") || DEFAULT_DIALOG_HEIGHT).to_i
    saved_w = DEFAULT_DIALOG_WIDTH  if saved_w < 300
    saved_h = DEFAULT_DIALOG_HEIGHT if saved_h < 300

    dlg = UI::HtmlDialog.new({
      :dialog_title => "MR Kitchen Library",
      :preferences_key => LIBRARY_DIALOG_PREFS_KEY,
      :scrollable => true, :resizable => true,
      :width => saved_w, :height => saved_h
    })

    register_library_dialog(dlg)
    begin
      dlg.set_position(DEFAULT_DIALOG_LEFT, DEFAULT_DIALOG_TOP)
    rescue
    end

    # ============ FOOTER (Dev Card) ============
    footer_html = <<~FOOTER
      <div class="rightFooter mhd-dev-card">
        <div class="mhd-dev-top">
          <span class="mhd-dev-label">Designed by</span>
          <span class="mhd-dev-name">مهندس مروان عادل</span>
          <span class="mhd-verified" title="مطوّر معتمد">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="#1D9BF0" d="M22.25 12c0-1.43-.88-2.67-2.19-3.34.46-1.39.2-2.9-.81-3.91s-2.52-1.27-3.91-.81C14.67 2.63 13.43 1.75 12 1.75s-2.67.88-3.34 2.19c-1.39-.46-2.9-.2-3.91.81s-1.27 2.52-.81 3.91C2.63 9.33 1.75 10.57 1.75 12s.88 2.67 2.19 3.34c-.46 1.39-.2 2.9.81 3.91s2.52 1.27 3.91.81c.67 1.31 1.91 2.19 3.34 2.19s2.67-.88 3.34-2.19c1.39.46 2.9.2 3.91-.81s1.27-2.52.81-3.91c1.31-.67 2.19-1.91 2.19-3.34z"/>
              <path fill="#FFFFFF" d="M10.6 16.2l-3.5-3.5 1.4-1.4 2.1 2.1 5-5 1.4 1.4z"/>
            </svg>
          </span>
        </div>
        <span class="mhd-dev-phone" dir="ltr">
          <span class="mhd-phone-icon">☎</span>01204279606
        </span>
        <div class="mhd-dev-rights">© MR Kitchen • جميع الحقوق محفوظة</div>
      </div>
    FOOTER

    library_ui_copy = case current_language.to_s
    when /\Aar/
      { filters: "تصفية النتائج", search: "بحث عن وحدة…", units: "الوحدات" }
    when 'fr'
      { filters: "Filtres", search: "Rechercher un élément…", units: "Éléments" }
    when 'tr'
      { filters: "Filtreler", search: "Ünite ara…", units: "Üniteler" }
    else
      { filters: "Filters", search: "Search units…", units: "Units" }
    end

    html = <<-HTML
    <html lang="#{MHDESIGN::Language.current.tr('_','-')}" dir="#{MHDESIGN::Language.direction}">
    <head>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1">
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;800;900&family=Tajawal:wght@300;400;500;700;800;900&display=swap" rel="stylesheet">
      <style>
        :root {
          --bg-app: #0B111A;
          --bg-header: #101B27;
          --bg-sidebar: #111F2C;
          --bg-panel: #172633;
          --bg-card: #1A2B39;
          --bg-input: #0E1925;
          --bg-hover: #243A49;
          --accent-primary: #08C9C3;
          --accent-hover: #10DDD4;
          --accent-dark: #087D80;
          --text-primary: #F4F7FA;
          --text-secondary: #A6B5C3;
          --text-muted: #71879A;
          --border-default: #34495B;
          --border-active: #27E5DC;
          --warning: #F2B72F;
          --danger: #EF5965;
          --header-gradient: linear-gradient(110deg, #07111B 0%, #102332 60%, #075C62 100%);
          --active-gradient: linear-gradient(135deg, #064A50 0%, #0B7778 100%);
          --button-gradient: linear-gradient(90deg, #08BDB8 0%, #13DDD2 55%, #05B9B5 100%);
          --panel-gradient: linear-gradient(145deg, #1D3040 0%, #111E2B 100%);
          --rail-width: 72px;
          --mini-width: 74px;
          --rightw: 320px;
          --gap: 16px;
          --card-gap: 14px;
          --radius: 12px;
          --shadow: 0 6px 16px rgba(0,0,0,.23);
        }

        * { box-sizing: border-box; }
        html { color-scheme: dark; }
        body {
          margin: 0;
          overflow: hidden;
          background: var(--bg-app);
          color: var(--text-primary);
          font: 13px/1.5 Tajawal, Cairo, 'Segoe UI', Tahoma, sans-serif;
        }
        button, select, input, textarea { font: inherit; color: inherit; }
        button { cursor: pointer; }
        button:disabled { cursor: default; }
        button:focus, input:focus, select:focus, textarea:focus, a:focus {
          outline: 2px solid var(--border-active);
          outline-offset: 2px;
        }
        [hidden] { display: none !important; }
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-thumb { background: #405565; border-radius: 8px; }
        .glyph { display: block; width: 20px; height: 20px; flex: 0 0 auto; }

        .app {
          --filter-track: min(var(--rightw), 42%);
          height: 100vh;
          display: grid;
          grid-template: "header header header" auto "filters workspace rail" minmax(0, 1fr)
                         / var(--filter-track) minmax(0, 1fr) var(--rail-width);
          direction: ltr;
          column-gap: var(--gap);
          row-gap: 12px;
          padding: 0 12px 12px;
        }
        .topbar {
          grid-area: header;
          position: relative;
          display: grid;
          grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr) minmax(0, 1fr);
          align-items: center;
          gap: var(--gap);
          min-height: 80px;
          margin: 0 -12px;
          padding: 10px 24px;
          overflow: hidden;
          background: var(--header-gradient);
          border-bottom: 1px solid var(--border-default);
        }
        .logoBox, .heading { position: relative; z-index: 1; }
        .logoBox { display: flex; align-items: center; gap: 8px; }
        .logoBox img { width: 48px; height: 48px; object-fit: contain; }
        .wordmark { display: grid; line-height: 1.2; color: var(--text-primary); }
        .wordmark strong { font-size: 17px; }
        .wordmark small { margin-top: 4px; font-size: 9px; letter-spacing: .18em; }
        .heading { text-align: center; }
        .title { margin: 0; font-size: 25px; line-height: 1.25; font-weight: 800; font-family: Cairo, Tajawal, sans-serif; }
        .sub { margin: 4px 0 0; color: var(--text-secondary); font-size: 13px; }
        .headerDrawing {
          position: absolute; right: 18px; bottom: -15px;
          width: 180px; height: 106px;
          color: var(--accent-hover); opacity: .4; pointer-events: none;
        }

        .sidebar {
          grid-area: rail;
          min-height: 0;
          overflow: auto;
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 8px;
          padding: 8px 0;
          border: 1px solid var(--border-default);
          border-radius: var(--radius);
          background: var(--bg-sidebar);
          scrollbar-width: none;
        }
        .sidebar::-webkit-scrollbar { display: none; }
        .pill {
          display: grid;
          justify-items: center;
          gap: 4px;
          padding-top: 8px;
          width: min(100%, 44px);
          border-top: 1px solid var(--border-default);
        }
        .sb-spacer { flex: 1 0 0; }
        .icon, .miniToggle, .catsOpenBtn, .catsCloseBtn, .zoomBtn {
          display: inline-flex; align-items: center; justify-content: center; flex: none;
          width: 40px; min-height: 40px; padding: 0;
          border-radius: 8px; border: 1px solid transparent; background: transparent;
        }
        .miniToggle, .catsOpenBtn, .catsCloseBtn, .zoomBtn {
          border-color: var(--border-default);
          background: var(--bg-panel);
        }
        .icon:hover, .miniToggle:hover, .catsOpenBtn:hover, .catsCloseBtn:hover, .zoomBtn:hover {
          background: var(--bg-hover);
          border-color: var(--accent-dark);
          color: var(--accent-hover);
        }
        .miniToggle { font-size: 21px; }
        body.mini .app {
          grid-template: "rail" minmax(0, 1fr) / minmax(0, 1fr);
          padding: 0;
        }
        body.mini .sidebar { border-radius: 0; }
        body.mini .topbar, body.mini .main, body.mini .right, body.mini .resizer { display: none !important; }

        .right {
          grid-area: filters;
          min-height: 0;
          min-width: 0;
          overflow: auto;
          display: flex;
          flex-direction: column;
          gap: 12px;
        }
        .filters, .cats {
          flex: none;
          min-width: 0;
          padding: 12px;
          border: 1px solid var(--border-default);
          border-radius: var(--radius);
          background: var(--bg-sidebar);
          direction: inherit;
        }
        .filters { background: var(--panel-gradient); }
        .cats { display: flex; flex: 1 0 auto; flex-direction: column; }
        .sectionHead {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 8px;
          margin: 0 0 8px;
        }
        .sectionHead h2 { margin: 0; font-size: 16px; overflow-wrap: break-word; font-weight: 800; }
        .catsCloseBtn { width: 32px; min-height: 32px; }
        .searchBox { position: relative; display: block; }
        .searchBox .glyph {
          position: absolute; top: 11px; inset-inline-start: 10px;
          color: var(--text-secondary); pointer-events: none;
          width: 18px; height: 18px;
        }
        .search, .assemblySelect, .personalPanel input:not([type=checkbox]), .personalPanel textarea {
          width: 100%; min-height: 40px; min-width: 0;
          padding: 6px 10px;
          border: 1px solid var(--border-default);
          border-radius: 8px;
          background: var(--bg-input);
          color: var(--text-primary);
        }
        .search { padding-inline-start: 34px; }
        .search::placeholder { color: var(--text-secondary); }
        .zoomControls {
          display: none; width: max-content; max-width: 100%;
          align-items: center; gap: 8px; margin-top: 8px;
          border: 1px solid var(--border-default); border-radius: 8px;
          background: var(--bg-input); direction: ltr;
        }
        .zoomBtn { width: 38px; min-height: 36px; font-size: 20px; line-height: 1; }
        .zoomValue { min-width: 44px; text-align: center; font-weight: 700; }
        .assemblyWrap {
          display: grid; gap: 10px; margin-top: 12px; padding-top: 12px;
          border-top: 1px solid var(--border-default);
        }
        .assemblyRow { display: grid; gap: 4px; min-width: 0; }
        .assemblyLabel { font-weight: 700; }
        .cat {
          display: flex; justify-content: space-between; align-items: center;
          gap: 8px; width: 100%; min-height: 36px; padding: 5px 8px; margin-top: 4px;
          border: 1px solid transparent; border-radius: 8px;
          background: transparent; text-align: start; overflow-wrap: anywhere;
        }
        .cat:hover { background: var(--bg-hover); }
        .cat.active, .libraryModeBtn.active {
          background: var(--active-gradient); border-color: var(--border-active);
          color: var(--text-primary); font-weight: 700;
        }
        .count {
          flex: none; min-width: 32px; padding: 2px 6px; text-align: center;
          font-size: 12px; border-radius: 6px;
          background: rgba(166,181,195,.14); font-variant-numeric: tabular-nums;
        }
        .rightFooter { flex: none; margin-top: auto; padding: 12px 8px 0; border-top: 1px solid var(--border-default); text-align: center; color: var(--text-secondary); font-size: 12px; user-select: text; }
        #cats { margin-bottom: 12px; }
        .rightFooter a { color: var(--text-primary); text-underline-offset: 3px; }
        .phone { display: block; margin-top: 4px; color: var(--text-primary); font-weight: 700; }
        .resizer {
          grid-area: filters; justify-self: end;
          transform: translateX(12px); width: 10px;
          cursor: col-resize; z-index: 1;
        }
        .resizer:hover { background: rgba(39,229,220,.2); }
        .dragging * { cursor: col-resize !important; user-select: none !important; }
        body.rightCollapsed .app, body.compactFilters .app { --filter-track: 0px; column-gap: 8px; }
        body.rightCollapsed .right, body.rightCollapsed .resizer,
        body.compactFilters .right, body.compactFilters .resizer { display: none; }
        body.rightCollapsed .catsOpenBtn, body.compactFilters .catsOpenBtn { display: inline-flex; }
        body.compactFilters.filtersOpen .right {
          display: flex; grid-column: 1 / 3; justify-self: start;
          width: min(320px, 100%); max-height: 100%; z-index: 3;
          padding: 8px; border: 1px solid var(--border-default); border-radius: var(--radius);
          background: var(--bg-app); box-shadow: 12px 4px 28px rgba(0,0,0,.6);
        }

        .main {
          grid-area: workspace;
          display: flex; flex-direction: column;
          min-width: 0; min-height: 0; gap: 12px;
        }
        .libraryModes {
          flex: none; display: flex; align-items: stretch;
          justify-content: center; gap: 8px;
        }
        .libraryModeBtn {
          flex: 1 1 0; min-width: 0; max-width: 166px; min-height: 42px;
          padding: 5px 8px;
          display: flex; align-items: center; justify-content: center; gap: 8px;
          border-radius: 999px; border: 1px solid var(--border-default);
          background: var(--bg-panel);
          font-size: 14px; font-weight: 700; overflow-wrap: anywhere;
        }
        .libraryModeBtn:hover { border-color: var(--accent-primary); }
        .workspace {
          flex: 1 1 0; min-height: 0;
          display: flex; flex-direction: column;
          overflow: hidden;
          border: 1px solid var(--border-default); border-radius: var(--radius);
          background: var(--bg-header);
        }
        .workspaceBar {
          flex: none; min-height: 44px;
          display: flex; align-items: center; justify-content: space-between;
          gap: 8px; padding: 6px 12px;
          border-bottom: 1px solid var(--border-default);
          background: var(--bg-input);
        }
        .workspaceLabel { display: flex; align-items: center; gap: 8px; font-weight: 700; }
        .workspaceLabel .glyph { color: var(--text-secondary); }
        .catsOpenBtn { display: none; width: 36px; min-height: 36px; }
        .gridWrap { flex: 1 1 0; min-height: 0; overflow: auto; }
        .grid {
          display: grid;
          grid-template-columns: repeat(auto-fill, minmax(min(100%, 248px), 1fr));
          gap: var(--card-gap); padding: 12px;
        }
        .card {
          position: relative; display: flex; flex-direction: column;
          min-width: 0; overflow: hidden;
          border: 1px solid var(--border-default); border-radius: 14px;
          background: var(--bg-panel); box-shadow: var(--shadow);
          transition: background-color .15s ease, border-color .15s ease;
        }
        .card:hover, .card:focus-within { background: var(--bg-card); border-color: var(--accent-dark); }
        .thumb { position: relative; height: 0; padding-top: 64%; background: #E9EDF2; }
        .thumb img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
        .card:not(.adCard) .thumb { padding-top: 100%; }
        .card:not(.adCard) .thumb img { object-fit: cover; }
        .content { display: flex; flex-direction: column; flex: 1; gap: 6px; padding: 12px; }
        .name, .desc { overflow-wrap: anywhere; }
        .name { font-size: 15px; line-height: 1.35; font-weight: 700; }
        .desc { min-height: 18px; color: var(--text-secondary); font-size: 13px; }
        .btnRow { display: flex; gap: 8px; margin-top: auto; padding-top: 6px; }
        .btn {
          min-width: 0; min-height: 40px; padding: 7px 10px;
          border: 1px solid var(--border-default); border-radius: 8px;
          background: var(--bg-input); font-weight: 700; overflow-wrap: anywhere;
        }
        .btnRow .btn { flex: 1 1 0; }
        .btn:hover { background: var(--bg-hover); }
        .btn.primary { border-color: transparent; background: var(--button-gradient); color: #04191C; }
        .btn.primary:hover { background: var(--accent-hover); }
        .insertMark { margin-inline-end: 6px; font-size: 16px; line-height: 1; }
        .adBadge {
          position: absolute; top: 8px; inset-inline-end: 8px; z-index: 1;
          padding: 3px 8px; border-radius: 8px;
          background: var(--bg-input); color: var(--warning);
          font-weight: 700; font-size: 11px;
        }
        .emptyBox {
          grid-column: 1 / -1; padding: 16px;
          border: 1px dashed var(--border-default); border-radius: var(--radius);
          color: var(--text-secondary); text-align: center;
        }

        #personalSidebarTop, body.personalMode .assemblyWrap:not(#personalSidebarTop) .kitchenSetting,
        body.dressingMode .assemblyWrap .kitchenSetting, body.dressingMode .categoriesHead, body.dressingMode #cats,
        body.dressingMode .searchBox, body:not(.kitchensMode) .workspaceCount { display: none; }
        body.personalMode #personalSidebarTop { display: grid; }
        .personalTreeRow { display: flex; min-height: 36px; margin: 4px 0; border-radius: 8px; }
        .personalTreeRow.selected, .personalHome.selected { background: var(--active-gradient); }
        .personalTreeRow:hover { background-color: var(--bg-hover); }
        .personalTreeRow button { border: 0; background: transparent; padding: 4px; }
        .personalArrow { flex: 0 0 24px; color: var(--text-secondary); }
        .personalTreeLabel { flex: 1; min-width: 0; text-align: start; overflow-wrap: anywhere; }
        .personalLocation, .personalHint { margin: 0; color: var(--text-secondary); overflow-wrap: anywhere; }
        .personalBack:disabled { opacity: .45; }
        .personalEdit, .personalDelete {
          position: absolute; top: 8px; z-index: 2;
          width: 36px; height: 36px;
          border: 1px solid var(--border-default); border-radius: 8px;
          background: var(--bg-input); font-size: 20px;
        }
        .personalEdit { left: 8px; }
        .personalDelete { right: 8px; color: var(--danger); }
        .personalFolderOpen {
          display: flex; flex: 1; flex-direction: column;
          align-items: center; justify-content: center;
          gap: 8px; width: 100%; min-height: 180px;
          padding: 48px 12px 12px; border: 0; background: transparent;
        }
        .personalFolderIcon { font-size: 48px; }
        .personalFolderImage { width: 100%; height: 136px; object-fit: contain; }
        .personalAdd {
          justify-content: center; align-items: center;
          min-height: 180px; padding: 12px;
          border-style: dashed; background: transparent;
          color: var(--accent-hover);
        }
        .personalModal, .embeddedLoading {
          display: none; position: fixed; inset: 0; z-index: 1000;
          align-items: center; justify-content: center;
          padding: 16px; background: rgba(3,12,18,.78);
        }
        .personalModal.show, .embeddedLoading.show { display: flex; }
        .personalPanel, .embeddedLoadingCard {
          display: flex; flex-direction: column; gap: 8px;
          width: 440px; max-width: 100%; max-height: 100%;
          overflow: auto; padding: 16px;
          border: 1px solid var(--border-default); border-radius: var(--radius);
          background: var(--bg-panel); box-shadow: var(--shadow);
        }
        .personalPanel h3 { margin: 0 0 8px; font-size: 17px; }
        .personalCheck { display: flex; align-items: flex-start; gap: 8px; }
        #personalPreview, #personalCategoryPreview { max-height: 150px; max-width: 100%; object-fit: contain; }
        #personalPreview:not([src]), #personalCategoryPreview:not([src]) { display: none; }

        .dressingChoices { grid-column: 1 / -1; display: grid; gap: var(--card-gap); }
        .dressingChoice {
          display: flex; align-items: center; justify-content: flex-start;
          flex-wrap: wrap; gap: 16px; padding: 16px;
          border: 1px solid var(--border-default); border-radius: var(--radius);
          background: var(--panel-gradient); text-align: start;
        }
        .dressingChoice:hover { border-color: var(--border-active); }
        .dressingChoiceIcon {
          display: grid; place-items: center;
          width: 76px; height: 76px;
          border-radius: var(--radius); background: var(--bg-input);
          color: var(--accent-hover);
        }
        .dressingChoiceIcon svg { width: 60px; height: 60px; }
        .dressingChoiceText { flex: 1 1 160px; min-width: 0; }
        .dressingChoiceTitle { display: block; font-size: 17px; font-weight: 700; }
        .dressingChoiceDesc { display: block; color: var(--text-secondary); }

        .embeddedLoading { z-index: 1010; }
        .embeddedLoadingCard { text-align: center; gap: 12px; }
        .embeddedLoadingBrand { font: 800 24px 'Segoe UI', sans-serif; }
        .embeddedLoadingStatus { font-weight: 700; }
        .embeddedLoadingTrack { height: 8px; border-radius: 8px; overflow: hidden; background: var(--bg-input); direction: ltr; }
        .embeddedLoadingFill { height: 100%; width: 0; background: var(--button-gradient); transition: width .18s ease; }
        .embeddedLoadingPercent { color: var(--text-secondary); }

        .compactFilters .topbar { padding-inline: 12px; grid-template-columns: 48px minmax(0, 1fr) 48px; gap: 8px; }
        .compactFilters .wordmark, .compactFilters .libraryModeBtn .glyph { display: none; }
        .compactFilters .title { font-size: 22px; }
        .compactFilters .headerDrawing { opacity: .18; }
        .compactFilters .sidebar { margin-right: -4px; }
        .compactFilters .app { --rail-width: 56px; }
        .compactHeader .topbar { min-height: 52px; padding-block: 4px; }
        .compactHeader .sub { display: none; }
        @media (prefers-reduced-motion: reduce) {
          *, *::before, *::after { transition: none !important; }
        }
      #{MHDESIGN_ResponsiveHeaderUI::CSS}
:root {
  --bg-app: var(--ref-bg); --bg-sidebar: var(--ref-panel); --bg-panel: var(--ref-panel);
  --bg-card: var(--ref-section); --bg-input: var(--ref-input); --border-default: var(--ref-border);
  --accent-primary: var(--ref-accent); --button-gradient: var(--ref-action);
}
.topbar.mhd-ref-header { min-height: clamp(78px, calc(6.35vw + 12px), 112px); }
@media (max-width: 620px) {
  .topbar.mhd-ref-header { min-height: 70px; }
}
.filters .sectionHead, .cats .sectionHead {
  min-height: 42px; padding: 7px 10px; border: 1px solid var(--ref-border);
  border-radius: 8px; background: var(--ref-section); color: var(--ref-text);
}
.workspaceBar { background: var(--ref-section); color: var(--ref-text); }

/* ===== Pro Header ===== */
.mhd-pro-header {
  position: relative;
  min-height: 155px !important;
  background:
    radial-gradient(circle at 15% 50%, rgba(8,201,195,.30), transparent 45%),
    radial-gradient(circle at 85% 40%, rgba(245,196,107,.22), transparent 40%),
    var(--header-gradient) !important;
  border-bottom: 2px solid transparent !important;
  border-image: linear-gradient(90deg, transparent, #17d4cc, #f5c46b, transparent) 1;
  box-shadow: 0 10px 30px rgba(0,0,0,.45);
}
.mhd-title-block { display: flex; flex-direction: column; align-items: center; gap: 10px; }
.mhd-kicker {
  font-size: 14px;
  letter-spacing: .45em;
  color: #f5c46b;
  font-weight: 800;
  text-transform: uppercase;
  text-shadow: 0 0 14px rgba(245,196,107,.65), 0 0 4px rgba(245,196,107,.9);
}
.mhd-main-title {
  font-family: Cairo, Tajawal, sans-serif !important;
  font-size: 62px !important;
  font-weight: 900 !important;
  letter-spacing: 2.5px;
  background: linear-gradient(90deg, #ffffff 0%, #17d4cc 45%, #f5c46b 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent !important;
  text-shadow: 0 4px 28px rgba(23,212,204,.5);
  margin: 0 !important;
  line-height: 1.05 !important;
}
.mhd-tagline {
  margin: 0 !important;
  color: var(--text-secondary) !important;
  font-size: 20px !important;
  font-weight: 600;
  letter-spacing: .6px;
}
.mhd-dev-badge {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  margin-top: 12px;
  padding: 10px 26px;
  border-radius: 999px;
  background: linear-gradient(135deg, rgba(0,0,0,.5), rgba(20,40,55,.7));
  border: 1px solid rgba(245,196,107,.55);
  box-shadow:
    0 4px 22px rgba(245,196,107,.3),
    inset 0 0 14px rgba(23,212,204,.12);
  font-size: 17px;
  font-weight: 800;
  color: var(--text-primary);
}
.mhd-dev-badge-text { color: #f5e0b0; letter-spacing: .3px; }
.mhd-dev-phone-top {
  color: #f5c46b;
  font-weight: 900;
  letter-spacing: 1.8px;
  font-size: 17px;
  padding-inline-start: 14px;
  border-inline-start: 1px solid rgba(245,196,107,.5);
  cursor: default;
  user-select: text;
}
.mhd-verified {
  display: inline-flex;
  filter: drop-shadow(0 0 6px rgba(29,155,240,.85));
}
.mhd-verified svg { width: 22px; height: 22px; }
.mhd-header-spacer { width: 1px; }
.mhd-dev-card {
  display: flex; flex-direction: column; align-items: center; gap: 6px;
  padding: 12px 10px;
  border: 1px solid rgba(245,196,107,.35); border-radius: 12px;
  background: linear-gradient(145deg, rgba(245,196,107,.10), rgba(0,0,0,.25));
  text-align: center;
}
.mhd-dev-top { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; justify-content: center; }
.mhd-dev-label { font-size: 10px; color: var(--text-muted); letter-spacing: .15em; text-transform: uppercase; }
.mhd-dev-name { font-weight: 900; color: #f5c46b; font-size: 14px; }
.mhd-dev-phone {
  display: inline-flex; align-items: center; gap: 6px;
  color: #04191C; background: linear-gradient(90deg, #f5c46b, #ffdf9a);
  font-weight: 900; font-size: 14px; letter-spacing: 1px;
  padding: 6px 16px; border-radius: 999px;
  box-shadow: 0 4px 14px rgba(245,196,107,.35);
  cursor: default;
  user-select: text;
}
.mhd-dev-rights { font-size: 10px; color: var(--text-muted); }
@media (max-width: 760px) {
  .mhd-pro-header { min-height: 120px !important; }
  .mhd-main-title { font-size: 38px !important; letter-spacing: 1.5px; }
  .mhd-kicker { font-size: 11px; letter-spacing: .3em; }
  .mhd-tagline { font-size: 16px !important; }
  .mhd-dev-badge { font-size: 14px; padding: 8px 18px; gap: 10px; }
  .mhd-dev-phone-top { font-size: 14px; padding-inline-start: 10px; }
  .mhd-verified svg { width: 18px; height: 18px; }
}
      </style>
    </head>

    <body oncontextmenu="return false">
      <div id="personalCategoryModal" class="personalModal" role="dialog" aria-modal="true" aria-labelledby="personalCategoryTitle">
        <form id="personalCategoryForm" class="personalPanel">
          <h3 id="personalCategoryTitle">#{MHDESIGN::Language.for_tool('library').html('TEXT_C1CC83C071A9')}</h3>
          <p id="personalCategoryLocation" class="personalHint"></p>
          <label for="personalCategoryName">#{MHDESIGN::Language.for_tool('library').html('TEXT_0C278C708191')}</label><input id="personalCategoryName" maxlength="120" required autocomplete="off">
          <button type="button" class="btn" onclick="personalSend('category_image')">#{MHDESIGN::Language.for_tool('library').html('TEXT_2A5390B47192')}</button>
          <img id="personalCategoryPreview" alt="#{MHDESIGN::Language.for_tool('library').html('TEXT_863D850169D8')}">
          <button id="personalCategoryRemoveImage" type="button" class="btn" style="display:none" onclick="personalCategoryImage(null)">#{MHDESIGN::Language.for_tool('library').html('TEXT_5358E65BEFF5')}</button>
          <div class="btnRow"><button id="personalCategorySave" type="submit" class="btn primary">#{MHDESIGN::Language.for_tool('library').html('COMMON_SAVE')}</button><button type="button" class="btn" onclick="document.getElementById('personalCategoryModal').classList.remove('show')">#{MHDESIGN::Language.for_tool('library').html('COMMON_CANCEL')}</button></div>
        </form>
      </div>
      <div id="personalModal" class="personalModal" role="dialog" aria-modal="true" aria-labelledby="personalTitle">
        <form id="personalForm" class="personalPanel">
          <h3 id="personalTitle">#{MHDESIGN::Language.for_tool('library').html('TEXT_FDD5BE6DDE05')}</h3>
          <label for="personalName">#{MHDESIGN::Language.for_tool('library').html('REPORT_UNIT_NAME')}</label><input id="personalName" maxlength="200" required autocomplete="off">
          <label for="personalDesc">#{MHDESIGN::Language.for_tool('library').html('TEXT_64E00C367A7F')}</label><textarea id="personalDesc" rows="3" maxlength="4000"></textarea>
          <button type="button" class="btn" onclick="personalSend('image')">#{MHDESIGN::Language.for_tool('library').html('TEXT_2832E1D1EBB0')}</button>
          <img id="personalPreview" alt="#{MHDESIGN::Language.for_tool('library').html('TEXT_2E9E769D9C61')}">
          <p id="personalThumbnailHint" class="personalHint">#{MHDESIGN::Language.for_tool('library').html('TEXT_686A37FE468E')}</p>
          <label class="personalCheck" id="personalRenameRow"><input type="checkbox" id="personalRename"><span id="personalRenameLabel">#{MHDESIGN::Language.for_tool('library').html('TEXT_3D15C0EA4B49')}</span></label>
          <p id="personalEditHint" class="personalHint" style="display:none">#{MHDESIGN::Language.for_tool('library').html('TEXT_36031903C6BB')}</p>
          <div class="btnRow"><button id="personalSave" type="submit" class="btn primary">#{MHDESIGN::Language.for_tool('library').html('TEXT_FF1D03AC378A')}</button><button type="button" class="btn" onclick="personalClose()">#{MHDESIGN::Language.for_tool('library').html('COMMON_CANCEL')}</button></div>
        </form>
      </div>

      <div class="app" id="appRoot">
        <header class="topbar mhd-ref-header mhd-pro-header">
          #{MHDESIGN_ResponsiveHeaderUI::BRAND}
          <div class="heading mhd-title-block" dir="rtl">
            <span class="mhd-kicker">✦ PREMIUM KITCHEN LIBRARY ✦</span>
            <h1 class="title mhd-main-title">MR Kitchen</h1>
            <p class="sub mhd-tagline">نحن لا نصنع مطابخ... نحن نصنع بصمة من الفخامة تدوم</p>
            <p class="sub mhd-tagline">DESIGNED TO IMPRESS. BUILT TO LAST.</p>
            <p class="sub mhd-tagline">مطابخ ودريسينج بتصميم استثنائي وتنفيذ يليق بطموحك</p>
            <div class="mhd-dev-badge">
              <span class="mhd-dev-badge-text">تصميم وبرمجة: مهندس مروان عادل</span>
              <span class="mhd-verified" title="مطوّر معتمد">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path fill="#1D9BF0" d="M22.25 12c0-1.43-.88-2.67-2.19-3.34.46-1.39.2-2.9-.81-3.91s-2.52-1.27-3.91-.81C14.67 2.63 13.43 1.75 12 1.75s-2.67.88-3.34 2.19c-1.39-.46-2.9-.2-3.91.81s-1.27 2.52-.81 3.91C2.63 9.33 1.75 10.57 1.75 12s.88 2.67 2.19 3.34c-.46 1.39-.2 2.9.81 3.91s2.52 1.27 3.91.81c.67 1.31 1.91 2.19 3.34 2.19s2.67-.88 3.34-2.19c1.39.46 2.9.2 3.91-.81s1.27-2.52.81-3.91c1.31-.67 2.19-1.91 2.19-3.34z"/>
                  <path fill="#FFFFFF" d="M10.6 16.2l-3.5-3.5 1.4-1.4 2.1 2.1 5-5 1.4 1.4z"/>
                </svg>
              </span>
              <span class="mhd-dev-phone-top" dir="ltr">01204279606</span>
            </div>
          </div>
          <div class="mhd-header-spacer" aria-hidden="true"></div>
        </header>
        <aside class="sidebar" id="sidebarCol">
          <button type="button" aria-controls="mainCol rightCol" aria-expanded="true" class="miniToggle" id="miniToggle" title="#{MHDESIGN::Language.for_tool('library').html('TEXT_9B6CFB45F5FD')}"><span id="miniArrow" aria-hidden="true">⟪</span></button>

          <div class="pill">
            <button type="button" class="icon" title="#{MHDESIGN::Language.for_tool('library').html('TEXT_668471B538B7')}" onclick="doAction('user_info')"><svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21v-2a7 7 0 0 1 7-5h2a7 7 0 0 1 7 5v2"/></svg></button>
          </div>

          <div class="pill">
            <button type="button" class="icon" title="#{MHDESIGN::Language.for_tool('library').html('TEXT_6063F3B89920')}" onclick="doAction('invoice')"><svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 3l2 2 2-2 3 2 3-2 2 2 2-2v18l-2-2-2 2-3-2-3 2-2-2-2 2zM8 9h8m-8 4h8m-8 3h4"/></svg></button>
            <button type="button" class="icon" title="#{MHDESIGN::Language.for_tool('library').html('TEXT_09125B75BA61')}" onclick="doAction('pricing_launcher')"><svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v20m5-15c-1-3-10-3-10 1 0 5 10 2 10 7 0 4-9 4-11 1"/></svg></button>
            <button type="button" class="icon" title="#{MHDESIGN::Language.for_tool('library').html('TEXT_F68F66042E4B')}" onclick="doAction('report')"><svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h9l4 4v14H6zM14 3v5h5M9 12h7m-7 4h7"/></svg></button>
            <button type="button" class="icon" title="#{MHDESIGN::Language.for_tool('library').html('TEXT_9855B51EFD16')}" onclick="doAction('unique')"><svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3h13v13H8zM3 8v13h13m-4-12h5m-2.5-2.5v5"/></svg></button>
            <button type="button" class="icon" title="#{MHDESIGN::Language.for_tool('library').html('TEXT_47903FE71D2A')}" onclick="doAction('serial_tool')"><svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 3h16v18H4zM8 8l2-2v5m4-4h3v2l-3 2h3m-9 3h2l-1 2 1 1H8m8-3-2 3h3m0-3v5"/></svg></button>
          </div>

          <div class="pill">
            <button type="button" class="icon" title="#{MHDESIGN::Language.for_tool('library').html('TEXT_E0E2005B593B')}" onclick="doAction('rotate90')"><svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11a9 9 0 1 1 2 7m-2-13v6h6"/></svg></button>
            <button type="button" class="icon" title="#{MHDESIGN::Language.for_tool('library').html('TEXT_FA6389F0F59E')}" onclick="doAction('flip_lr')"><svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v18m-2-5H3l7-9zm4 0h7l-7-9z"/></svg></button>
            <button type="button" class="icon" title="#{MHDESIGN::Language.for_tool('library').html('TEXT_2642525391A7')}" onclick="doAction('snap_side')"><svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20v-9a8 8 0 0 1 16 0v9h-5v-9a3 3 0 0 0-6 0v9zm0-5h5m6 0h5"/></svg></button>
            <button type="button" class="icon" title="#{MHDESIGN::Language.for_tool('library').html('TEXT_F83031D53DA1')}" onclick="doAction('hand_groove')"><svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 17h18v4H3zM7 17V9l4 4 4-4v8M17 4l4 4-3 3-4-4z"/></svg></button>
            <button type="button" class="icon" title="#{MHDESIGN::Language.for_tool('library').html('TEXT_DB6BDA61E351')}" onclick="doAction('classic_door')"><svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 21h16M6 21V3h12v18M9 6h6v5H9zm0 8h6v4H9z"/></svg></button>
            <button type="button" class="icon" title="#{MHDESIGN::Language.for_tool('library').html('TEXT_0A004504B5C7')}" onclick="doAction('component_translator')"><svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zm-9 9h18M12 3c-5 5-5 13 0 18m0-18c5 5 5 13 0 18"/></svg></button>
            <button type="button" class="icon" title="#{MHDESIGN::Language.for_tool('library').html('KLM_TITLE')}" onclick="doAction('kitchen_materials')"><svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 0-9 9c2 0 3-1 2-3s1-3 3-3c3 0 4-1 4-3zM7 12h.01M9 7h.01M14 7h.01M17 10h.01"/></svg></button>
            <button type="button" class="icon" title="#{MHDESIGN::Language.for_tool('library').html('TEXT_1315A7F0F7E7')}" onclick="doAction('component_options')"><svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16M8 4v4m8 2v4m-6 2v4"/></svg></button>
          </div>

          <div class="sb-spacer"></div>

          <div class="pill">
            <button type="button" class="icon" title="#{MHDESIGN::Language.for_tool('library').html('DOWNLOAD_OFFLINE')}" onclick="doAction('download_all_components')"><svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m-4-4 4 4 4-4M4 16v5h16v-5"/></svg></button>
            <button type="button" class="icon" title="#{MHDESIGN::Language.for_tool('library').html('REFRESH_LIBRARY')}" onclick="doAction('refresh_cache')"><svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11a8 8 0 0 1 14-5l2 3m0-5v5h-5M20 13a8 8 0 0 1-14 5l-2-3m0 5v-5h5"/></svg></button>
          </div>
        </aside>

        <main class="main" id="mainCol" dir="#{MHDESIGN::Language.direction}">
          <div class="libraryModes">
            <button id="kitchensModeBtn" type="button" class="libraryModeBtn active" aria-pressed="true" onclick="setLibraryMode('kitchens')"><svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h18v16H3zM12 4v16M9 8v4m6-4v4"/></svg><span>#{MHDESIGN::Language.for_tool('library').html('TEXT_FEADE4B179A4')}</span></button>
            <button id="personalModeBtn" type="button" class="libraryModeBtn" aria-pressed="false" onclick="setLibraryMode('personal')"><svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h7l2 2h9v12H3z"/></svg><span>#{MHDESIGN::Language.for_tool('library').html('TEXT_74D2FF4B5A41')}</span></button>
            <button id="dressingModeBtn" type="button" class="libraryModeBtn" aria-pressed="false" onclick="setLibraryMode('dressing')"><svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 7a3 3 0 1 1 4 2.8l-1 1.2v1M12 12l9 5v2H3v-2z"/></svg><span>#{MHDESIGN::Language.for_tool('library').html('TEXT_48161C9FB39A')}</span></button>
          </div>
          <section class="workspace">
            <div class="workspaceBar">
              <div class="workspaceLabel"><svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3h7v7H3zm11 0h7v7h-7zM3 14h7v7H3zm11 0h7v7h-7z"/></svg><span id="workspaceMode"></span><span class="count workspaceCount" id="workspaceCount" title="#{library_ui_copy[:units]}"></span></div>
              <button type="button" class="catsOpenBtn" id="catsOpenBtn" aria-controls="rightCol" aria-expanded="false" title="#{MHDESIGN::Language.for_tool('library').html('SHOW_CATEGORIES')}"><svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h18l-7 8v6l-4 2v-8z"/></svg></button>
            </div>
            <div class="gridWrap" id="gridWrap">
              <div id="grid" class="grid"></div>
            </div>
          </section>
        </main>

        <aside class="right" id="rightCol" dir="#{MHDESIGN::Language.direction}">
          <section class="filters">
            <div class="sectionHead">
              <h2>#{library_ui_copy[:filters]}</h2>
              <button type="button" class="catsCloseBtn" id="catsCloseBtn" title="#{MHDESIGN::Language.for_tool('library').html('HIDE_CATEGORIES')}">✕</button>
            </div>
            <label class="searchBox">
              <svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.5 3.5a7 7 0 1 0 0 14 7 7 0 0 0 0-14zm5 12 5 5"/></svg>
              <input type="search" id="search" class="search" aria-label="#{library_ui_copy[:search]}" placeholder="#{library_ui_copy[:search]}" />
            </label>
            <div class="zoomControls">
              <button type="button" id="zoomOutBtn" class="zoomBtn" title="#{MHDESIGN::Language.for_tool('library').html('ZOOM_OUT')}">-</button>
              <div id="zoomValue" class="zoomValue">100%</div>
              <button type="button" id="zoomInBtn" class="zoomBtn" title="#{MHDESIGN::Language.for_tool('library').html('ZOOM_IN')}">+</button>
            </div>

            <div class="assemblyWrap">
              <div class="assemblyRow kitchenSetting">
                <label class="assemblyLabel" for="lowerSelect">#{MHDESIGN::Language.for_tool('library').html('LOWER_TALL')}</label>
                <select id="lowerSelect" class="assemblySelect">
                  <option value="A">#{MHDESIGN::Language.for_tool('library').html('DC_ASSEMBLY_SIDE_ON_BASE')}</option>
                  <option value="B">#{MHDESIGN::Language.for_tool('library').html('DC_ASSEMBLY_FULL_SIDE')}</option>
                </select>
              </div>

              <div class="assemblyRow kitchenSetting">
                <label class="assemblyLabel" for="upperSelect">#{MHDESIGN::Language.for_tool('library').html('WALL_UNITS')}</label>
                <select id="upperSelect" class="assemblySelect">
                  <option value="A">#{MHDESIGN::Language.for_tool('library').html('DC_ASSEMBLY_SIDE_ON_BASE')}</option>
                  <option value="B">#{MHDESIGN::Language.for_tool('library').html('DC_ASSEMBLY_FULL_SIDE')}</option>
                </select>
              </div>

              <div class="assemblyRow">
                <label class="assemblyLabel" for="languageSelect" data-i18n="LANGUAGE">#{MHDESIGN::Language.for_tool('library').html('LANGUAGE')}</label>
                <select id="languageSelect" class="assemblySelect"></select>
              </div>
            </div>

            <div id="personalSidebarTop" class="assemblyWrap"><div id="personalNavigation" class="assemblyRow"></div><div id="personalTransferControls" class="assemblyRow"><button type="button" class="btn" onclick="personalSend('export')">#{MHDESIGN::Language.for_tool('library').html('TEXT_89BDC6EB9D77')}</button><button type="button" class="btn" onclick="personalSend('import')">#{MHDESIGN::Language.for_tool('library').html('TEXT_A663A589577A')}</button></div></div>
          </section>
          <section class="cats">
            <div class="sectionHead categoriesHead">
              <h2>#{MHDESIGN::Language.for_tool('library').html('CATEGORIES')}</h2>
              <svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 9 5-9 5-9-5zm-9 9 9 5 9-5M3 16l9 5 9-5"/></svg>
            </div>
            <div id="cats"></div>
            #{footer_html}
          </section>
        </aside>
        <div class="resizer" id="resizer" aria-hidden="true"></div>
      </div>

      <div class="embeddedLoading" id="embeddedLoading">
        <div class="embeddedLoadingCard">
          <div class="embeddedLoadingBrand">MR Kitchen</div>
          <div class="embeddedLoadingStatus" id="embeddedLoadingStatus">#{MHDESIGN::Language.for_tool('library').html('TEXT_08E383484B90')}</div>
          <div class="embeddedLoadingTrack"><div class="embeddedLoadingFill" id="embeddedLoadingFill"></div></div>
          <div class="embeddedLoadingPercent" id="embeddedLoadingPercent">0%</div>
        </div>
      </div>

      <script>
        document.addEventListener('contextmenu', e=>e.preventDefault());

        const MHD_LANG = #{(defined?(MHDESIGN::Language) ? MHDESIGN::Language.for_tool('library').ui_payload : {locale:"ar_EG",direction:"rtl",texts:{},source_map:{}}).to_json.gsub('<', '\\u003c').gsub('>', '\\u003e').gsub('&', '\\u0026')};

        function renderLanguageOptions(){
          const select = document.getElementById('languageSelect') || document.querySelector('select[onchange*="language"]') || document.querySelector('.language select');
          if(!select) return;
          const languages = Array.isArray(MHD_LANG.languages) ? MHD_LANG.languages : [];
          select.innerHTML = '';
          languages.forEach(lang=>{
            const code = String(lang.code || '').trim();
            if(!code) return;
            const option = document.createElement('option');
            option.value = code;
            option.textContent = String(lang.name || code);
            option.selected = code === String(MHD_LANG.locale || '');
            select.appendChild(option);
          });
          if(!select.options.length){
            const fallback = document.createElement('option');
            fallback.value = 'ar_EG';
            fallback.textContent = '#{MHDESIGN::Language.for_tool('library').js_fragment('TEXT_61EAAF7509D4')}';
            select.appendChild(fallback);
          }
        }

        let allComponents = [];
        let adsList = [];
        let activeCat = "all";
        let q = "";
        let adRotationIndex = 0;
        let adTimer = null;
        let currentCountry = "#{saved_country}";
        let libraryMode = "#{saved_library_mode}";
        const ADS_INSERT_EVERY = #{ADS_INSERT_EVERY};

        const rightCol   = document.getElementById("rightCol");
        const resizer    = document.getElementById("resizer");
        const miniToggle = document.getElementById("miniToggle");
        const miniArrow  = document.getElementById("miniArrow");
        const catsCloseBtn = document.getElementById("catsCloseBtn");
        const catsOpenBtn  = document.getElementById("catsOpenBtn");
        const gridWrap = document.getElementById("gridWrap");

        const KEY_W = "mh_right_col_width_v1";
        const KEY_RIGHT_COLLAPSED = "mh_right_collapsed_v1";
        const MIN_W = 200;
        const MAX_W = 520;

        let personalData = {categories:[], units:[]};
        let personalCategory = '', personalEditingUnit = '', personalEditingCategory = '', personalCategoryParent = '';
        let personalBusy = false;
        let personalSavingActive = false;
        let personalCategoryPicture = null;
        const personalCollapsed = new Set();

        function personalSend(action, values={}) {
          if(personalBusy) return;
          personalBusy = true;
          if(action==='save'||action==='edit_save')personalSavingStart(action==='edit_save'?'جاري تحديث الوحدة…':'جاري إضافة الوحدة…');
          if(action==='export'||action==='import')personalSavingStart(action==='export'?'جاري تصدير مكتبتي…':'جاري استيراد المكتبة…');
          sketchup.personalAction(JSON.stringify(Object.assign({action}, values)));
        }
        window.personalReady = function(){personalBusy=false;document.getElementById('personalSave').disabled=false;document.getElementById('personalCategorySave').disabled=false;};
        window.personalError = function(message){personalSavingDone();personalReady();alert(message);};
        window.personalSavingStart=function(message){personalSavingActive=true;showEmbeddedLoading(message);personalProgress(5,message);};
        window.personalProgress=function(percent,message){updateEmbeddedLoading(percent,message);};
        window.personalSavingDone=function(){if(personalSavingActive){hideEmbeddedLoading();personalSavingActive=false;}};
        window.personalThumbnail=function(image){
          if(image)document.getElementById('personalPreview').src=image;
          document.getElementById('personalThumbnailHint').textContent=image?'#{MHDESIGN::Language.for_tool('library').js_fragment('TEXT_822D4B3CB43C')}':'#{MHDESIGN::Language.for_tool('library').js_fragment('TEXT_46B0C2D15FED')}';
        };
        window.personalReceive = function(data){personalData=data;if(personalCategory&&!data.categories.some(c=>c.id===personalCategory))personalCategory='';if(libraryMode==='personal'){renderCats();renderGrid(true);}};
        function personalAncestors(id){
          const path=[],seen=new Set();let current=id;
          while(current&&!seen.has(current)){seen.add(current);const item=personalData.categories.find(c=>c.id===current);if(!item)break;path.unshift(item);current=item.parent;}
          return path;
        }
        function personalNavigate(id){
          personalCategory=id;personalAncestors(id).forEach(c=>personalCollapsed.delete(c.id));
          q='';document.getElementById('search').value='';renderCats();renderGrid(false);
        }
        function personalBack(){const item=personalData.categories.find(c=>c.id===personalCategory);personalNavigate(item?item.parent:'');}
        function personalTree(target){
          const visit=(parent,depth,seen)=>personalData.categories.filter(c=>c.parent===parent).forEach(c=>{
            if(seen.has(c.id))return;
            const row=document.createElement('div');row.className='personalTreeRow'+(personalCategory===c.id?' selected':'');row.style.paddingInlineStart=(8+depth*18)+'px';
            const children=personalData.categories.some(x=>x.parent===c.id);
            const arrow=document.createElement('button');arrow.type='button';arrow.className='personalArrow';arrow.textContent=children?(personalCollapsed.has(c.id)?'▸':'▾'):'·';
            arrow.onclick=()=>{if(!children)return;personalCollapsed.has(c.id)?personalCollapsed.delete(c.id):personalCollapsed.add(c.id);personalCats();};
            const label=document.createElement('button');label.type='button';label.className='personalTreeLabel';label.textContent='📁 '+c.name;label.onclick=()=>personalNavigate(c.id);
            row.appendChild(arrow);row.appendChild(label);target.appendChild(row);
            if(!personalCollapsed.has(c.id))visit(c.id,depth+1,new Set([...seen,c.id]));
          });visit('',0,new Set());
        }
        function personalCats(){
          const target=document.getElementById('cats');target.innerHTML='';
          const navigation=document.getElementById('personalNavigation');navigation.innerHTML='';
          const back=document.createElement('button');back.type='button';back.className='btn personalBack';back.textContent='#{MHDESIGN::Language.for_tool('library').js_fragment('TEXT_578A547732DF')}';back.disabled=!personalCategory;back.onclick=personalBack;navigation.appendChild(back);
          const path=document.createElement('div');path.className='personalLocation';path.textContent=['#{MHDESIGN::Language.for_tool('library').js_fragment('TEXT_74D2FF4B5A41')}',...personalAncestors(personalCategory).map(c=>c.name)].join(' / ');navigation.appendChild(path);
          const home=document.createElement('button');home.type='button';home.className='personalHome'+(!personalCategory?' selected':'');home.textContent='#{MHDESIGN::Language.for_tool('library').js_fragment('TEXT_C3E7685A0AA4')}';home.onclick=()=>personalNavigate('');navigation.appendChild(home);
          personalTree(target);
        }
        function personalCategoryOpen(id=''){
          if(personalBusy)return;
          personalEditingCategory=id;const item=personalData.categories.find(c=>c.id===id);personalCategoryParent=item?item.parent:personalCategory;
          document.getElementById('personalCategoryTitle').textContent=item?'#{MHDESIGN::Language.for_tool('library').js_fragment('TEXT_14E4BBC11D9E')}':'#{MHDESIGN::Language.for_tool('library').js_fragment('TEXT_C1CC83C071A9')}';
          document.getElementById('personalCategoryName').value=item?item.name:'';
          personalCategoryImage(item&&item.image_data?{data:item.image_data,mime:item.image_mime}:null);
          document.getElementById('personalCategoryLocation').textContent='#{MHDESIGN::Language.for_tool('library').js_fragment('TEXT_5F2FD2E91BDB')} '+['#{MHDESIGN::Language.for_tool('library').js_fragment('TEXT_74D2FF4B5A41')}',...personalAncestors(personalCategoryParent).map(c=>c.name)].join(' / ');
          document.getElementById('personalCategoryModal').classList.add('show');document.getElementById('personalCategoryName').focus();
        }
        window.personalCategoryImage=function(picture){
          personalCategoryPicture=picture;
          const preview=document.getElementById('personalCategoryPreview');
          if(picture)preview.src='data:'+picture.mime+';base64,'+picture.data;else preview.removeAttribute('src');
          document.getElementById('personalCategoryRemoveImage').style.display=picture?'block':'none';
        };
        function personalControls(card,removeAction,editAction){
          const remove=document.createElement('button');remove.type='button';remove.className='personalDelete';remove.textContent='×';remove.title='#{MHDESIGN::Language.for_tool('library').js_fragment('COMMON_DELETE')}';remove.onclick=event=>{event.stopPropagation();removeAction();};card.appendChild(remove);
          const edit=document.createElement('button');edit.type='button';edit.className='personalEdit';edit.textContent='✎';edit.title='#{MHDESIGN::Language.for_tool('library').js_fragment('SURVEY_EDIT')}';edit.onclick=event=>{event.stopPropagation();editAction();};card.appendChild(edit);
        }
        function personalGrid(){
          const target=document.getElementById('grid');target.innerHTML='';
          personalData.categories.filter(c=>c.parent===personalCategory&&normalize(c.name).includes(q)).forEach(category=>{
            const card=document.createElement('div');card.className='card personalFolder';card.style.position='relative';
            personalControls(card,()=>personalSend('category_delete',{id:category.id}),()=>personalCategoryOpen(category.id));
            const open=document.createElement('button');open.type='button';open.className='personalFolderOpen';open.onclick=()=>personalNavigate(category.id);
            if(category.image){const image=document.createElement('img');image.className='personalFolderImage';image.src=category.image;image.alt=category.name;image.onerror=()=>{const icon=document.createElement('span');icon.className='personalFolderIcon';icon.textContent='📁';image.replaceWith(icon);};open.appendChild(image);}
            else{const icon=document.createElement('span');icon.className='personalFolderIcon';icon.textContent='📁';open.appendChild(icon);}
            const name=document.createElement('span');name.className='name';name.textContent=category.name;open.appendChild(name);
            const details=document.createElement('span');details.className='desc';details.textContent=personalData.categories.filter(c=>c.parent===category.id).length+' #{MHDESIGN::Language.for_tool('library').js_fragment('TEXT_436761B5B578')} '+personalData.units.filter(u=>u.category===category.id).length+' #{MHDESIGN::Language.for_tool('library').js_fragment('TEXT_E3603D3B8A31')}';open.appendChild(details);
            card.appendChild(open);target.appendChild(card);
          });
          if(personalCategory){
            personalData.units.filter(u=>u.category===personalCategory&&normalize(u.name+' '+(u.desc||'')).includes(q)).forEach(unit=>{
              const card=document.createElement('div');card.className='card';card.style.position='relative';
              personalControls(card,()=>personalSend('delete',{id:unit.id}),()=>personalSend('edit',{id:unit.id}));
              const thumb=document.createElement('div');thumb.className='thumb';const image=document.createElement('img');image.src=unit.image||'';image.alt=unit.name;thumb.appendChild(image);card.appendChild(thumb);
              const content=document.createElement('div');content.className='content';
              const name=document.createElement('div');name.className='name';name.textContent=unit.name;content.appendChild(name);
              const desc=document.createElement('div');desc.className='desc';desc.textContent=unit.desc||'';content.appendChild(desc);
              const insert=document.createElement('button');insert.type='button';insert.className='btn primary';insert.textContent='#{MHDESIGN::Language.for_tool('library').js_fragment('INSERT')}';insert.onclick=()=>personalSend('insert',{id:unit.id});const actions=document.createElement('div');actions.className='btnRow';actions.appendChild(insert);content.appendChild(actions);card.appendChild(content);target.appendChild(card);
            });
            const add=document.createElement('button');add.type='button';add.className='card personalAdd';add.textContent='#{MHDESIGN::Language.for_tool('library').js_fragment('TEXT_2D775D86123B')}';add.onclick=()=>personalSend('begin',{category:personalCategory});target.appendChild(add);
          }
          const addCategory=document.createElement('button');addCategory.type='button';addCategory.className='card personalAdd';addCategory.textContent='#{MHDESIGN::Language.for_tool('library').js_fragment('TEXT_064EB7485E3A')}';addCategory.onclick=()=>personalCategoryOpen();target.appendChild(addCategory);
        }
        window.personalOpen=function(unit=null, name="", dressing=false){
          personalEditingUnit=unit?unit.id:'';
          document.getElementById('personalForm').reset();document.getElementById('personalPreview').removeAttribute('src');
          document.getElementById('personalTitle').textContent=unit?'#{MHDESIGN::Language.for_tool('library').js_fragment('TEXT_382D355A1E42')}':'#{MHDESIGN::Language.for_tool('library').js_fragment('TEXT_FDD5BE6DDE05')}';
          document.getElementById('personalSave').textContent=unit?'#{MHDESIGN::Language.for_tool('library').js_fragment('SHOP_REPORT_SAVE_CHANGES')}':'#{MHDESIGN::Language.for_tool('library').js_fragment('TEXT_FF1D03AC378A')}';
          const nameInput=document.getElementById('personalName');
          nameInput.readOnly=dressing||Boolean(unit&&unit.dressing_type);
          nameInput.value=unit?unit.name:name;
          const rename=document.getElementById('personalRename');
          document.getElementById('personalRenameRow').style.display=nameInput.readOnly?'none':'';
          rename.disabled=nameInput.readOnly;
          rename.checked=false;
          document.getElementById('personalRenameLabel').textContent=unit?'#{MHDESIGN::Language.for_tool('library').js_fragment('TEXT_EA111E8C65FD')}':'#{MHDESIGN::Language.for_tool('library').js_fragment('TEXT_3D15C0EA4B49')}';
          document.getElementById('personalEditHint').style.display=unit&&!nameInput.readOnly?'block':'none';
          document.getElementById('personalThumbnailHint').textContent=unit?'#{MHDESIGN::Language.for_tool('library').js_fragment('TEXT_BE111A04AB03')}':'#{MHDESIGN::Language.for_tool('library').js_fragment('TEXT_686A37FE468E')}';
          if(unit){document.getElementById('personalDesc').value=unit.desc||'';if(unit.image)document.getElementById('personalPreview').src=unit.image;}
          document.getElementById('personalModal').classList.add('show');(nameInput.readOnly?document.getElementById('personalDesc'):nameInput).focus();
        };
        window.personalClose=function(notify=true){document.getElementById('personalModal').classList.remove('show');personalEditingUnit='';if(notify)personalSend('cancel');};
        document.getElementById('personalForm').addEventListener('submit',event=>{
          event.preventDefault();if(personalBusy)return;document.getElementById('personalSave').disabled=true;
          personalSend(personalEditingUnit?'edit_save':'save',{id:personalEditingUnit,name:document.getElementById('personalName').value,desc:document.getElementById('personalDesc').value,rename:document.getElementById('personalRename').checked});
        });
        document.getElementById('personalCategoryForm').addEventListener('submit',event=>{
          event.preventDefault();if(personalBusy)return;document.getElementById('personalCategorySave').disabled=true;
          personalSend('category_save',{id:personalEditingCategory,parent:personalCategoryParent,name:document.getElementById('personalCategoryName').value,picture:personalCategoryPicture});
        });

        function normalize(s){ return (s||"").toString().toLowerCase().trim(); }
        function escapeHtml(s){
          return (s||"").toString().replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;").replaceAll('"',"&quot;").replaceAll("'","&#039;");
        }
        function escapeHtmlAttr(s){ return escapeHtml(s).replaceAll("`",""); }

        function getRightWidth(){ const saved = parseInt(localStorage.getItem(KEY_W) || "", 10); return isNaN(saved) ? 320 : saved; }
        function setRightWidth(px){ px = Math.max(MIN_W, Math.min(MAX_W, px)); document.documentElement.style.setProperty("--rightw", px + "px"); localStorage.setItem(KEY_W, String(px)); positionControls(); }
        function isMini(){ return document.body.classList.contains("mini"); }
        function isRightCollapsed(){ return document.body.classList.contains("rightCollapsed"); }
        function applyRightCollapsed(state){ document.body.classList.toggle("rightCollapsed", state); localStorage.setItem(KEY_RIGHT_COLLAPSED, state ? "1" : "0"); }
        function positionControls(){
          const zoom = parseFloat(document.body.style.zoom) || 1;
          const compact = document.getElementById("appRoot").clientWidth < 880 && !isMini();
          document.body.classList.toggle("compactFilters", compact);
          catsOpenBtn.setAttribute("aria-expanded", String(compact && document.body.classList.contains("filtersOpen")));
          document.body.classList.toggle("compactHeader", window.innerHeight / zoom < 510);
        }

        let dragging = false;
        resizer.addEventListener("mousedown", (e)=>{
          if(isMini() || isRightCollapsed() || document.body.classList.contains("compactFilters")) return;
          dragging = true; document.body.classList.add("dragging"); e.preventDefault();
        });
        document.addEventListener("mousemove", (e)=>{
          if(!dragging) return;
          const panel = rightCol.getBoundingClientRect();
          if(!panel.width) return;
          setRightWidth(rightCol.offsetWidth + (e.clientX - panel.right) * rightCol.offsetWidth / panel.width);
        });
        document.addEventListener("mouseup", ()=>{
          if(!dragging) return;
          dragging = false; document.body.classList.remove("dragging");
        });
        function saveExpandedSize(){ try{ sketchup.saveExpandedSize(); }catch(e){} }
        function applyMiniState(mini, notifyRuby){
          if(mini){ document.body.classList.add("mini"); miniArrow.textContent = "⟪"; }
          else{ document.body.classList.remove("mini"); miniArrow.textContent = "⟫"; }
          miniToggle.setAttribute("aria-expanded", String(!mini));
          setTimeout(positionControls, 0);
          if(notifyRuby){
            const sbwStr = getComputedStyle(document.documentElement).getPropertyValue("--mini-width").trim();
            let miniW = parseInt(sbwStr, 10);
            if (isNaN(miniW) || miniW < 40) miniW = 74;
            miniW = miniW + 2;
            const payload = { mini: mini ? 1 : 0, miniW: miniW };
            sketchup.uiState(JSON.stringify(payload));
          }
        }
        miniToggle.addEventListener("click", ()=>{ if(!isMini()){saveExpandedSize();applyMiniState(true,true);}else{applyMiniState(false,true);} });
        window.addEventListener("resize", positionControls);
        if(typeof ResizeObserver === "function"){
          const layoutObserver = new ResizeObserver(positionControls);
          layoutObserver.observe(document.getElementById("appRoot"));
        }
        catsCloseBtn.addEventListener("click", ()=>{
          if(document.body.classList.contains("compactFilters")){ document.body.classList.remove("filtersOpen"); }
          else{ applyRightCollapsed(true); }
          catsOpenBtn.setAttribute("aria-expanded", "false"); catsOpenBtn.focus();
        });
        catsOpenBtn.addEventListener("click", ()=>{
          if(document.body.classList.contains("compactFilters")){ document.body.classList.add("filtersOpen"); }
          else{ applyRightCollapsed(false); }
          catsOpenBtn.setAttribute("aria-expanded", "true"); catsCloseBtn.focus();
        });
        document.addEventListener("keydown", event=>{
          if(event.key === "Escape" && document.body.classList.contains("compactFilters") &&
             document.body.classList.contains("filtersOpen") && !document.querySelector(".personalModal.show")){
            catsCloseBtn.click();
          }
        });

        function getCurrentAd(){ if(!adsList || adsList.length === 0) return null; return adsList[adRotationIndex % adsList.length] || null; }
        function restartAdRotation(){
          try{ if(adTimer){ clearInterval(adTimer); adTimer = null; } }catch(e){}
          if(!adsList || adsList.length <= 1) return;
          adTimer = setInterval(()=>{ adRotationIndex = (adRotationIndex + 1) % adsList.length; renderGrid(true); }, 10000);
        }
        function filterList(){
          return allComponents.filter(it=>{
            const catOk = (activeCat === "all") ? true : (it.category === activeCat);
            const text = normalize((it.name||"") + " " + (it.desc||"") + " " + (it.category||""));
            const qOk = q ? text.includes(q) : true;
            return catOk && qOk;
          });
        }
        function countByCat(){
          const map = {};
          allComponents.forEach(it=>{ const c = it.category || "غير مصنف"; map[c] = (map[c]||0) + 1; });
          return map;
        }
        function renderCats(){
          if(libraryMode === "personal"){personalCats();return;}
          const map = countByCat();
          const catsEl = document.getElementById("cats");
          const cats = ["all", ...Object.keys(map)];
          catsEl.innerHTML = cats.map(c=>{
            const title = (c==="all") ? "#{MHDESIGN::Language.for_tool('library').js_fragment('REPORT_ALL')}" : c;
            const cnt = (c==="all") ? allComponents.length : map[c];
            const cls = (activeCat === c) ? "cat active" : "cat";
            return `<button type="button" class="${cls}" aria-pressed="${activeCat === c}" onclick='setCat(${escapeHtml(JSON.stringify(c))})'><span>${escapeHtml(title)}</span><span class="count">${cnt}</span></button>`;
          }).join("");
        }
        function buildMergedList(list){
          if(!adsList || adsList.length === 0) return list.slice();
          const out = []; let count = 0; let inserted = 0;
          list.forEach((it)=>{ out.push(it); count++; if(count % ADS_INSERT_EVERY === 0){ out.push({ type: "ad_placeholder" }); inserted++; } });
          if(inserted === 0 && list.length > 0){ out.push({ type: "ad_placeholder" }); }
          return out;
        }
        function renderGrid(keepScroll=false){
          if(libraryMode === "personal"){personalGrid();return;}
          const grid = document.getElementById("grid");
          if(libraryMode === "dressing"){
            grid.innerHTML = `<div class="dressingChoices">
              <button type="button" class="dressingChoice" onclick="selectDressingType('straight')">
                <span class="dressingChoiceIcon" aria-hidden="true"><svg viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="10" y="12" width="60" height="56" rx="4" opacity=".95"/><path d="M31 13v54M51 13v54M11 22h58" opacity=".72"/><path d="M36 31h10m-10 8h10m-10 8h10" opacity=".85"/></svg></span>
                <span class="dressingChoiceText"><span class="dressingChoiceTitle">#{MHDESIGN::Language.for_tool('library').html('CT_SHAPE_STRAIGHT')}</span><span class="dressingChoiceDesc">#{MHDESIGN::Language.for_tool('library').html('TEXT_FE294A825D6B')}</span></span>
              </button>
              <button type="button" class="dressingChoice" onclick="selectDressingType('corner')">
                <span class="dressingChoiceIcon" aria-hidden="true"><svg viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 13h23v31h31v23H13Z" stroke-width="3" opacity=".98"/><path d="M22 13v45h45M31 13v36h36" opacity=".72"/></svg></span>
                <span class="dressingChoiceText"><span class="dressingChoiceTitle">#{MHDESIGN::Language.for_tool('library').html('TEXT_27E8853FA89A')}</span><span class="dressingChoiceDesc">#{MHDESIGN::Language.for_tool('library').html('TEXT_0FBB3AFA36DE')}</span></span>
              </button>
            </div>`;
            setTimeout(positionControls, 0);
            return;
          }
          const list = filterList();
          document.getElementById("workspaceCount").textContent = list.length;
          const oldScroll = keepScroll ? gridWrap.scrollTop : 0;
          if(!allComponents || allComponents.length === 0){
            grid.innerHTML = `<div class="emptyBox">#{MHDESIGN::Language.for_tool('library').html('TEXT_CF4A6DABF5F8')}</div>`;
            setTimeout(positionControls, 0);
            return;
          }
          const merged = buildMergedList(list);
          const currentAd = getCurrentAd();
          grid.innerHTML = merged.map(it=>{
            if(it.type === "ad_placeholder" && currentAd){
              const link = escapeHtmlAttr(currentAd.link || "");
              return `<div class="card adCard"><div class="adBadge">#{MHDESIGN::Language.for_tool('library').html('TEXT_D6D29720BBB3')}</div><div class="thumb"><img src="${escapeHtmlAttr(currentAd.image || "")}" alt="" /></div><div class="content"><div class="name">${escapeHtml(currentAd.title || "")}</div><div class="desc">${escapeHtml(currentAd.description || "")}</div><div class="btnRow"><button class="btn primary" onclick="openAdLink('${link}')">#{MHDESIGN::Language.for_tool('library').html('TEXT_640463D6AD5F')}</button></div></div></div>`;
            }
            const safe = escapeHtml(JSON.stringify(it));
            return `<div class="card"><div class="thumb"><img src="${escapeHtmlAttr(it.image)}" alt="" /></div><div class="content"><div class="name">${escapeHtml(it.name)}</div><div class="desc">${escapeHtml(it.desc || "")}</div><div class="btnRow"><button class="btn primary" onclick='insertOriginal(${safe})'><span class="insertMark" aria-hidden="true">+</span>#{MHDESIGN::Language.for_tool('library').html('INSERT')}</button></div></div></div>`;
          }).join("");
          if(keepScroll){ requestAnimationFrame(()=>{ gridWrap.scrollTop = oldScroll; }); }
          setTimeout(positionControls, 0);
        }
        function setCat(cat){ activeCat = (cat==="all") ? "all" : cat; renderCats(); renderGrid(true); }
        document.getElementById("search").addEventListener("input", (e)=>{ q = normalize(e.target.value); renderGrid(true); });
        window.insertOriginal = function(comp){ showEmbeddedLoading("جاري تجهيز المكون والمقاسات..."); sketchup.insertOriginal(JSON.stringify(comp)); }
        window.doAction = function(name){ sketchup.doAction(name); }
        window.setLibraryMode = function(mode){
          libraryMode = ["kitchens","dressing","personal"].includes(mode) ? mode : "kitchens";
          ["kitchens", "personal", "dressing"].forEach(id=>{
            const active = libraryMode === id;
            const tab = document.getElementById(id + "ModeBtn");
            document.body.classList.toggle(id + "Mode", active);
            tab.classList.toggle("active", active);
            tab.setAttribute("aria-pressed", String(active));
            if(active) document.getElementById("workspaceMode").textContent = tab.textContent.trim();
          });
          sketchup.setLibraryMode(libraryMode);
          renderCats();
          if(libraryMode === "personal")personalSend("load");
          renderGrid(false);
          setTimeout(positionControls, 0);
        }
        window.showEmbeddedLoading = function(status){
          const overlay = document.getElementById("embeddedLoading");
          if(status) document.getElementById("embeddedLoadingStatus").textContent = status;
          document.getElementById("embeddedLoadingFill").style.width = "3%";
          document.getElementById("embeddedLoadingPercent").textContent = "3%";
          overlay.classList.add("show");
        }
        window.updateEmbeddedLoading = function(percent, status){
          const value = Math.max(0, Math.min(100, parseInt(percent || 0, 10)));
          if(status) document.getElementById("embeddedLoadingStatus").textContent = status;
          document.getElementById("embeddedLoadingFill").style.width = value + "%";
          document.getElementById("embeddedLoadingPercent").textContent = value + "%";
          document.getElementById("embeddedLoading").classList.add("show");
        }
        window.hideEmbeddedLoading = function(){ document.getElementById("embeddedLoading").classList.remove("show"); }
        window.selectDressingType = function(type){ showEmbeddedLoading("جاري تجهيز أداة الدريسنج..."); sketchup.selectDressingType(String(type || "")); }
        window.openAdLink = function(url){ if(!url) return; sketchup.openAdLink(String(url)); }
        window.__setComponents = function(list){
          allComponents = (list || []);
          activeCat = "all";
          q = normalize(document.getElementById("search").value || "");
          renderCats(); renderGrid(false);
        }
        window.__setAds = function(list){
          adsList = (list || []).filter(x => x && x.image && x.link);
          adRotationIndex = 0; restartAdRotation(); renderGrid(true);
        }
        window.__updateCountry = function(cc){ currentCountry = String(cc || "GLOBAL"); requestAds(); }

        const lowerSelect = document.getElementById("lowerSelect");
        const upperSelect = document.getElementById("upperSelect");
        const languageSelect = document.getElementById("languageSelect");
        if(languageSelect){
          languageSelect.value = MHD_LANG.locale || "ar_EG";
          languageSelect.addEventListener("change", ()=>{ sketchup.setLanguage(String(languageSelect.value || "ar_EG")); });
        }
        renderLanguageOptions();

        const initialLower = "#{saved_lower}";
        const initialUpper = "#{saved_upper}";
        lowerSelect.value = (initialLower === "B") ? "B" : "A";
        upperSelect.value = (initialUpper === "B") ? "B" : "A";

        function requestComponents(){ const payload = { lower: String(lowerSelect.value || "A"), upper: String(upperSelect.value || "A") }; sketchup.getComponentsCombo(JSON.stringify(payload)); }
        function requestAds(){ sketchup.getAds(String(currentCountry || "GLOBAL")); }

        lowerSelect.addEventListener("change", ()=>{ sketchup.setLower(String(lowerSelect.value || "A")); requestComponents(); });
        upperSelect.addEventListener("change", ()=>{ sketchup.setUpper(String(upperSelect.value || "A")); requestComponents(); });

        const SKETCHUP_YEAR = #{Sketchup.version.to_i};
        const IS_SKETCHUP_2024 = SKETCHUP_YEAR <= 24;
        const ZOOM_STORAGE_KEY = "mrkitchen_library_zoom_2024_v1";
        const ZOOM_MIN = 0.5;
        const ZOOM_MAX = 2.0;
        const ZOOM_STEP = 0.1;
        const DEFAULT_ZOOM = 0.9;

        let zoomLevel = IS_SKETCHUP_2024
          ? (parseFloat(localStorage.getItem(ZOOM_STORAGE_KEY) || String(DEFAULT_ZOOM)) || DEFAULT_ZOOM)
          : DEFAULT_ZOOM;

        const zoomOutBtn = document.getElementById("zoomOutBtn");
        const zoomInBtn  = document.getElementById("zoomInBtn");
        const zoomValue  = document.getElementById("zoomValue");
        const zoomControls = document.querySelector(".zoomControls");

        function clampZoom(v){ return Math.max(ZOOM_MIN, Math.min(ZOOM_MAX, Number(v) || DEFAULT_ZOOM)); }
        function updateZoomUI(){
          if(zoomValue){ zoomValue.textContent = Math.round(zoomLevel * 100) + "%"; }
          if(zoomOutBtn){ zoomOutBtn.disabled = zoomLevel <= ZOOM_MIN + 0.001; zoomOutBtn.style.opacity = zoomOutBtn.disabled ? "0.5" : "1"; zoomOutBtn.style.cursor = zoomOutBtn.disabled ? "default" : "pointer"; }
          if(zoomInBtn){ zoomInBtn.disabled = zoomLevel >= ZOOM_MAX - 0.001; zoomInBtn.style.opacity = zoomInBtn.disabled ? "0.5" : "1"; zoomInBtn.style.cursor = zoomInBtn.disabled ? "default" : "pointer"; }
        }
        function applyPageZoom(level){
          zoomLevel = clampZoom(level);
          const appEl = document.querySelector(".app");
          document.documentElement.style.overflow = "hidden";
          document.body.style.overflow = "hidden";
          document.body.style.zoom = String(zoomLevel);
          if(appEl){ appEl.style.height = (100 / zoomLevel) + "vh"; appEl.style.minHeight = (100 / zoomLevel) + "vh"; }
          setTimeout(() => { positionControls(); try{ window.scrollTo(0, 0); }catch(_e){} }, 0);
        }

        if(IS_SKETCHUP_2024){
          if(zoomControls){ zoomControls.style.display = "flex"; }
          updateZoomUI(); applyPageZoom(zoomLevel);
          if(zoomOutBtn){ zoomOutBtn.addEventListener("click", function(){ zoomLevel -= ZOOM_STEP; applyPageZoom(zoomLevel); updateZoomUI(); localStorage.setItem(ZOOM_STORAGE_KEY, String(zoomLevel)); }); }
          if(zoomInBtn){ zoomInBtn.addEventListener("click", function(){ zoomLevel += ZOOM_STEP; applyPageZoom(zoomLevel); updateZoomUI(); localStorage.setItem(ZOOM_STORAGE_KEY, String(zoomLevel)); }); }
        }else{
          if(zoomControls){ zoomControls.style.display = "none"; }
          applyPageZoom(DEFAULT_ZOOM);
        }

        setRightWidth(getRightWidth());
        applyMiniState(false, false);
        const savedCollapsed = (localStorage.getItem(KEY_RIGHT_COLLAPSED) || "0") === "1";
        applyRightCollapsed(savedCollapsed);

        setTimeout(positionControls, 60);
        setLibraryMode(libraryMode);
        requestComponents();
        requestAds();
      </script>
    </body>
    </html>
    HTML

    personal_register(dlg)
    dlg.set_html(html)

    dlg.add_action_callback("setLibraryMode") do |_, mode|
      value = %w[kitchens dressing personal].include?(mode.to_s) ? mode.to_s : 'kitchens'
      Sketchup.write_default(PLUGIN_NAME, 'library_mode', value)
    end

    dlg.add_action_callback("selectDressingType") do |_, type|
      prepare_dressing_unit(type.to_s, dlg)
    end

    dlg.add_action_callback("insertOriginal") do |_, comp_json|
      comp = JSON.parse(comp_json, symbolize_names: true) rescue nil
      next unless comp.is_a?(Hash)
      comp[:progress_dialog] = dlg
      fetch_definition_async(comp) do |definition|
        unless definition
          dlg.execute_script("window.hideEmbeddedLoading();") rescue nil
          restore_library_after_placement
          next
        end
        begin
          dlg.execute_script("window.hideEmbeddedLoading();") rescue nil
          hide_library_for_placement
          model = Sketchup.active_model
          ok = activate_smart_unit_placement(definition, comp)
          restore_library_after_placement unless ok
        rescue => e
          restore_library_after_placement
          UI.messagebox("#{MHDESIGN::Language.for_tool('library').t('TEXT_73E11B3FA306')}#{e.message}")
        end
      end
    end

    dlg.add_action_callback("getComponentsCombo") do |_, payload_json|
      begin
        data  = JSON.parse(payload_json) rescue {}
        lower = (data["lower"] || "A").to_s.strip.upcase
        upper = (data["upper"] || "A").to_s.strip.upcase
        lower = "A" unless %w[A B].include?(lower)
        upper = "A" unless %w[A B].include?(upper)
        list = load_components_for_combo(lower, upper)
        dlg.execute_script("window.__setComponents(#{list.to_json});")
      rescue => e
        UI.messagebox("❌ خطأ أثناء تجهيز بيانات المكتبة:\n#{e.message}")
        dlg.execute_script("window.__setComponents([]);") rescue nil
      end
    end

    dlg.add_action_callback("getAds") do |_, country_code|
      begin
        cc = country_code.to_s.strip.upcase
        cc = "GLOBAL" unless country_code_valid?(cc)
        ads = load_ads_for_country(cc)
        dlg.execute_script("window.__setAds(#{ads.to_json});")
      rescue
        dlg.execute_script("window.__setAds([]);") rescue nil
      end
    end

    dlg.add_action_callback("openAdLink") do |_, url|
      begin
        u = url.to_s.strip
        next if u.empty?
        UI.openURL(u)
      rescue => e
        UI.messagebox("❌ فشل فتح رابط الإعلان:\n#{e.message}")
      end
    end

    dlg.add_action_callback("setLanguage") do |_, code|
      begin
        set_language(code)
        dlg.close rescue nil
        UI.start_timer(0.15, false) { show_library }
      rescue => e
        UI.messagebox("Language change failed: #{e.message}")
      end
    end

    dlg.add_action_callback("setLower") { |_, mode| set_saved_lower_mode(mode) }
    dlg.add_action_callback("setUpper") { |_, mode| set_saved_upper_mode(mode) }

    dlg.add_action_callback("saveExpandedSize") do |_|
      begin
        w, h = dlg.get_size
        w = w.to_i; h = h.to_i
        if w > 200 && h > 200
          Sketchup.write_default(PLUGIN_NAME, "dlg_w", w)
          Sketchup.write_default(PLUGIN_NAME, "dlg_h", h)
        else
          Sketchup.write_default(PLUGIN_NAME, "dlg_w", DEFAULT_DIALOG_WIDTH)
          Sketchup.write_default(PLUGIN_NAME, "dlg_h", DEFAULT_DIALOG_HEIGHT)
        end
      rescue
      end
    end

    dlg.add_action_callback("uiState") do |_, payload_json|
      begin
        data = JSON.parse(payload_json) rescue {}
        mini = data["mini"].to_i == 1
        if mini
          w = (data["miniW"] || 74).to_i
          h = (Sketchup.read_default(PLUGIN_NAME, "dlg_h") || DEFAULT_DIALOG_HEIGHT).to_i
          h = DEFAULT_DIALOG_HEIGHT if h < 300
          dlg.set_size(w, h) rescue nil
        else
          w = (Sketchup.read_default(PLUGIN_NAME, "dlg_w") || DEFAULT_DIALOG_WIDTH).to_i
          h = (Sketchup.read_default(PLUGIN_NAME, "dlg_h") || DEFAULT_DIALOG_HEIGHT).to_i
          w = DEFAULT_DIALOG_WIDTH  if w < 300
          h = DEFAULT_DIALOG_HEIGHT if h < 300
          dlg.set_size(w, h) rescue nil
        end
      rescue
      end
    end

    dlg.add_action_callback("doAction") do |_, name|
      case name.to_s
      when "kitchens" then dlg.execute_script("window.setLibraryMode('kitchens');")
      when "dressing_launcher" then dlg.execute_script("window.setLibraryMode('dressing');")
      when "user_info"
        changed = show_user_info
        if changed
          cc = get_saved_country
          cc = "GLOBAL" if cc.to_s.empty?
          begin
            dlg.execute_script("window.__updateCountry('#{cc}');")
          rescue
          end
        end
      when "invoice" then call_invoice_plugin
      when "pricing_launcher"
        begin
          dlg.minimize
        rescue
        end
        activate_pricing_launcher_from_server
      when "report" then call_reports_plugin
      when "unique" then MHDESIGN_UNIQUIFY.run_uniquify
      when "serial_tool"
        begin
          dlg.minimize
        rescue
        end
        activate_serial_tool_from_server
      when "refresh_cache"
        begin
          dlg.close
        rescue
        end
        refresh_library_with_window_reset
      when "download_all_components" then download_all_components_for_offline
      when "rotate90"
        begin
          dlg.minimize
        rescue
        end
        activate_rotate_tool
      when "flip_lr"
        begin
          dlg.minimize
        rescue
        end
        activate_flip_lr_tool
      when "snap_side"
        begin
          dlg.minimize
        rescue
        end
        activate_click_side_snap_tool
      when "hand_groove"
        begin
          dlg.minimize
        rescue
        end
        activate_hand_groove_tool_from_server
      when "classic_door"
        begin
          dlg.minimize
        rescue
        end
        activate_classic_door_tool_from_server
      when "component_translator" then activate_component_translator_from_server
      when "kitchen_materials"
        begin
          dlg.minimize
        rescue
        end
        open_kitchen_materials_tool
      when "component_options" then open_options_protected
      end
    end

    begin
      dlg.set_on_closed do
        begin
          @library_dialog = nil if @library_dialog.equal?(dlg)
          @library_dialog_hidden_for_placement = false
          w, h = dlg.get_size
          w = w.to_i; h = h.to_i
          if w > 200 && h > 200
            Sketchup.write_default(PLUGIN_NAME, "dlg_w", w)
            Sketchup.write_default(PLUGIN_NAME, "dlg_h", h)
          else
            Sketchup.write_default(PLUGIN_NAME, "dlg_w", DEFAULT_DIALOG_WIDTH)
            Sketchup.write_default(PLUGIN_NAME, "dlg_h", DEFAULT_DIALOG_HEIGHT)
          end
        rescue
        end
      end
    rescue
    end

    begin
      dlg.show
      dlg.bring_to_front if dlg.respond_to?(:bring_to_front)
    rescue
      dlg.show rescue nil
    end
  end

  TranslationPackage.boot!

  FILE_LOADED_KEY = "mrkitchen_library_loaded_v2_ads_country"
  @toolbar = nil
  @cmd = nil

  unless file_loaded?(FILE_LOADED_KEY)
    UI.menu("Plugins").add_item("#{PLUGIN_NAME} - تفعيل") { activate(true) }
    UI.menu("Plugins").add_item("#{PLUGIN_NAME} - بيانات الحساب") { show_user_info }
    UI.menu("Plugins").add_item("#{PLUGIN_NAME} - رقم الجهاز") { show_device_id_dialog }
    UI.menu("Plugins").add_item("تحديث مكتبة #{PLUGIN_NAME}") { refresh_library_with_window_reset }

    @toolbar = UI::Toolbar.new(PLUGIN_NAME)
    @cmd = UI::Command.new("تشغيل #{PLUGIN_NAME}") { show_library }

    icon_path = (PLUGIN_DIR ? File.join(PLUGIN_DIR, "icon.png") : nil) rescue nil
    if icon_path && File.exist?(icon_path)
      @cmd.small_icon = icon_path
      @cmd.large_icon = icon_path
    end

    @cmd.tooltip = "تشغيل مكتبة MR Kitchen"
    @toolbar.add_item(@cmd)
    @toolbar.restore

    file_loaded(FILE_LOADED_KEY)
  end
end
