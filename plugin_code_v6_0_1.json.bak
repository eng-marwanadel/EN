      UI.messagebox("⚠️ تم تحميل Classic_door.rb ✅ لكن لم أجد دالة تشغيل.\nلازم يكون فيه مثلاً:\nMHDESIGN::ClassicToSolidPresetSwap.activate_tool")
      false
    rescue => e
