  def self.account_language_key
    code = current_language.to_s.downcase
    return "fr" if code.start_with?("fr")
    return "tr" if code.start_with?("tr")
    return "en" if code.start_with?("en")
    "ar"
  rescue
    "ar"
  end

  ACCOUNT_TRANSLATION_KEYS = {
    title: "ACCOUNT_TITLE", hero_title: "ACCOUNT_HERO_TITLE", hero_desc: "ACCOUNT_HERO_DESC",
    email: "ACCOUNT_EMAIL", license: "ACCOUNT_LICENSE", expiry: "ACCOUNT_EXPIRY",
    device: "ACCOUNT_DEVICE", country: "ACCOUNT_COUNTRY", offline: "ACCOUNT_OFFLINE",
    auto_title: "ACCOUNT_AUTO_OPTIONS_TITLE", auto_desc: "ACCOUNT_AUTO_OPTIONS_DESC",
    enabled: "ACCOUNT_ENABLED", disabled: "ACCOUNT_DISABLED", change_country: "ACCOUNT_CHANGE_COUNTRY",
    close: "ACCOUNT_CLOSE", saved: "ACCOUNT_SAVED", no_data: "ACCOUNT_NO_DATA",
    activate_hint: "ACCOUNT_ACTIVATE_HINT", permanent: "ACCOUNT_PERMANENT",
    undefined: "ACCOUNT_UNDEFINED", expired: "ACCOUNT_EXPIRED",
    hour: "ACCOUNT_HOUR", hours: "ACCOUNT_HOURS", minute: "ACCOUNT_MINUTE",
    minutes: "ACCOUNT_MINUTES", second: "ACCOUNT_SECOND", seconds: "ACCOUNT_SECONDS",
    and_word: "ACCOUNT_AND"
  }.freeze

  def self.account_text(key)
    table = ACCOUNT_TEXTS[account_language_key] || ACCOUNT_TEXTS["ar"]
    fallback = (table[key.to_sym] || ACCOUNT_TEXTS["ar"][key.to_sym] || key.to_s).to_s
    translation_key = ACCOUNT_TRANSLATION_KEYS[key.to_sym]
    return fallback if translation_key.to_s.empty?
    translated = MHDESIGN.t(translation_key, fallback).to_s
    translated.strip.empty? ? fallback : translated
  rescue
    fallback || key.to_s
  end

  def self.account_humanize_seconds(total)
    total = total.to_i
    m, s = total.divmod(60)
    h, m = m.divmod(60)
    parts = []
    parts << "#{h} #{account_text(h == 1 ? :hour : :hours)}" if h > 0
    parts << "#{m} #{account_text(m == 1 ? :minute : :minutes)}" if m > 0
    parts << "#{s} #{account_text(s == 1 ? :second : :seconds)}" if s > 0 || parts.empty?
    parts.join(" #{account_text(:and_word)} ")
  rescue
    humanize_seconds(total)
  end

  def self.auto_open_options_enabled?
    value = Sketchup.read_default(PLUGIN_NAME, AUTO_OPTIONS_PREF_KEY, true)
    !(value == false || value.to_s.strip.downcase == "false" || value.to_s == "0")
  rescue
    true
  end

  def self.set_auto_open_options_enabled(value)
    enabled = value == true || value.to_s == "1" || value.to_s.strip.downcase == "true"
    Sketchup.write_default(PLUGIN_NAME, AUTO_OPTIONS_PREF_KEY, enabled)
    enabled
  rescue
    true
  end

  def self.open_options_automatically(instance)
    return false unless auto_open_options_enabled?
    return false unless instance && instance.valid?
    open_options_protected
  rescue
    false
  end

  def self.html_escape(text)
    text.to_s
      .gsub("&", "&amp;").gsub("<", "&lt;").gsub(">", "&gt;")
      .gsub('"', "&quot;").gsub("'", "&#39;")
  rescue
    text.to_s
  end

  def self.show_user_info
    email   = Sketchup.read_default(PLUGIN_NAME, "email").to_s
    license = Sketchup.read_default(PLUGIN_NAME, "license").to_s
    ends_at = Sketchup.read_default(PLUGIN_NAME, "ends_at").to_s
    country = get_saved_country
    if email.empty? || license.empty?
      UI.messagebox("#{account_text(:no_data)}\n#{account_text(:activate_hint)}")
      return false
    end
    ends_txt = ends_at.strip.empty? ? account_text(:permanent) : ends_at
    country_txt = country.to_s.empty? ? account_text(:undefined) : country_label(country)
    offline_left = offline_access_remaining_seconds
    offline_txt = offline_left > 0 ? account_humanize_seconds(offline_left) : account_text(:expired)
    auto_enabled = auto_open_options_enabled?
    rtl = account_language_key == "ar"
    begin
      @user_info_dialog.close if @user_info_dialog
    rescue
    end
    @user_info_dialog = UI::HtmlDialog.new(
      dialog_title: "MR Kitchen - #{account_text(:title)}",
      preferences_key: "mrkitchen_user_info_compact_v2",
      scrollable: false, resizable: false, width: 390, height: 540,
      style: UI::HtmlDialog::STYLE_DIALOG
    )
    html = <<~HTML
      <!DOCTYPE html>
      <html lang="#{account_language_key}" dir="#{rtl ? 'rtl' : 'ltr'}">
      <head>
        <meta charset="UTF-8">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;800&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
        <style>
          #{ACCOUNT_DIALOG_THEME}
          .row {
            display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
            align-items: baseline; gap: 8px; padding: 7px 0; border-bottom: 1px solid var(--border-default);
          }
          .row:first-child { padding-top: 2px; }
          .row:last-child { padding-bottom: 2px; border: 0; }
          .label { color: var(--text-secondary); font-size: 12px; font-weight: 700; overflow-wrap: anywhere; }
          .value { text-align: start; overflow-wrap: anywhere; font-size: 12px; }
          .feature { display: grid; grid-template-columns: minmax(0,1fr) auto; align-items: center; gap: 10px; }
          .feature-title { font-weight: 700; }
          .feature-desc { margin-top: 3px; color: var(--text-secondary); font-size: 11px; }
          .switch { position: relative; display: block; width: 50px; height: 28px; }
          .switch input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
          .slider { position: absolute; inset: 0; pointer-events: none; border: 1px solid var(--border-default); border-radius: 999px; background: var(--bg-input); }
          .slider::before { content: ""; position: absolute; width: 20px; height: 20px; top: 3px; inset-inline-start: 4px; border-radius: 50%; background: var(--text-secondary); }
          .switch input:checked + .slider { background: var(--active-gradient); border-color: var(--border-active); }
          .switch input:checked + .slider::before { inset-inline-start: auto; inset-inline-end: 4px; background: var(--text-primary); }
          .state { margin-top: 4px; color: var(--text-secondary); font-size: 11px; font-weight: 700; }
          .state.on { color: var(--accent-hover); }
          .actions { margin-top: auto; display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 8px; }
          .toast { position: fixed; left: 50%; bottom: 14px; transform: translateX(-50%); padding: 7px 12px; border-radius: 8px; background: var(--button-gradient); color: #04191C; font-size: 12px; font-weight: 700; display: none; }
        #{MHDESIGN_ResponsiveHeaderUI::CSS}
:root { --bg-panel: var(--ref-panel); --bg-input: var(--ref-input); --border-default: var(--ref-border); --button-gradient: var(--ref-action); }
.hero.mhd-ref-header { min-height: 58px; }
.feature { background: var(--ref-section); }
        </style>
      </head>
      <body>
        <div class="page">
          <div class="hero mhd-ref-header">
            #{MHDESIGN_ResponsiveHeaderUI::BRAND}
            <div class="mhd-ref-heading">
              <h1>#{html_escape(account_text(:hero_title))}</h1>
              <p>MR Kitchen • #{html_escape(account_text(:hero_desc))}</p>
            </div>
          </div>
          <div class="card">
            <div class="row"><div class="label">#{html_escape(account_text(:email))}</div><div class="value" dir="ltr">#{html_escape(email)}</div></div>
            <div class="row"><div class="label">#{html_escape(account_text(:license))}</div><div class="value" dir="ltr">••••••••</div></div>
            <div class="row"><div class="label">#{html_escape(account_text(:expiry))}</div><div class="value" dir="auto">#{html_escape(ends_txt)}</div></div>
            <div class="row"><div class="label">#{html_escape(account_text(:device))}</div><div class="value" dir="ltr">#{html_escape(get_device_id)}</div></div>
            <div class="row"><div class="label">#{html_escape(account_text(:country))}</div><div class="value" id="countryValue">#{html_escape(country_txt)}</div></div>
            <div class="row"><div class="label">#{html_escape(account_text(:offline))}</div><div class="value">#{html_escape(offline_txt)}</div></div>
          </div>
          <div class="card feature">
            <div>
              <div class="feature-title">#{html_escape(account_text(:auto_title))}</div>
              <div class="feature-desc">#{html_escape(account_text(:auto_desc))}</div>
              <div class="state #{auto_enabled ? 'on' : 'off'}" id="stateText">#{html_escape(auto_enabled ? account_text(:enabled) : account_text(:disabled))}</div>
            </div>
            <label class="switch"><input id="autoOptions" type="checkbox" aria-label="#{html_escape(account_text(:auto_title))}" #{auto_enabled ? 'checked' : ''} onchange="toggleAuto(this.checked)"><span class="slider"></span></label>
          </div>
          <div class="actions">
            <button class="primary" onclick="changeCountry()">#{html_escape(account_text(:change_country))}</button>
            <button class="secondary" onclick="closeDialog()">#{html_escape(account_text(:close))}</button>
          </div>
        </div>
        <div class="toast" id="toast">#{html_escape(account_text(:saved))}</div>
        <script>
          document.addEventListener('contextmenu',e=>e.preventDefault());
          function toggleAuto(enabled){
            sketchup.set_auto_options(enabled ? '1' : '0');
            const state=document.getElementById('stateText');
            state.textContent=enabled ? #{account_text(:enabled).to_json} : #{account_text(:disabled).to_json};
            state.className='state '+(enabled?'on':'off');
            const toast=document.getElementById('toast'); toast.style.display='block';
            clearTimeout(window._toastTimer); window._toastTimer=setTimeout(()=>toast.style.display='none',900);
          }
          function changeCountry(){ sketchup.change_country(); }
          function closeDialog(){ sketchup.close_user_info(); }
          window.updateCountry=function(text){ document.getElementById('countryValue').textContent=text; }
        </script>
      </body>
      </html>
    HTML
    @user_info_dialog.set_html(html)
    @user_info_dialog.add_action_callback("set_auto_options") { |_dlg, value| set_auto_open_options_enabled(value) }
    @user_info_dialog.add_action_callback("change_country") do |_context, _value|
      new_country = choose_country(true)
      if new_country
        label = country_label(new_country)
        @user_info_dialog.execute_script("window.updateCountry(#{label.to_json});") rescue nil
        begin
          cc = get_saved_country
          cc = "GLOBAL" if cc.to_s.empty?
          @library_dialog.execute_script("window.__updateCountry(#{cc.to_json});") if @library_dialog
        rescue
        end
      end
    end
    @user_info_dialog.add_action_callback("close_user_info") do |_context, _value|
      begin
        @user_info_dialog.close if @user_info_dialog
      rescue
      end
    end
    @user_info_dialog.set_on_closed { @user_info_dialog = nil }
    @user_info_dialog.set_position(160, 90) rescue nil
    @user_info_dialog.show
    true
  rescue => e
    UI.messagebox("MR Kitchen: #{e.message}")
    false
  end

  def self.reset_library_window_state
    begin
      Sketchup.write_default(PLUGIN_NAME, "dlg_w", DEFAULT_DIALOG_WIDTH)
      Sketchup.write_default(PLUGIN_NAME, "dlg_h", DEFAULT_DIALOG_HEIGHT)
    rescue
    end
    begin
      if defined?(UI::HtmlDialog) && UI::HtmlDialog.respond_to?(:preferences_path)
        pref_path = UI::HtmlDialog.preferences_path(LIBRARY_DIALOG_PREFS_KEY) rescue nil
        if pref_path && File.exist?(pref_path)
          File.delete(pref_path) rescue nil
        end
      end
    rescue
    end
    true
  rescue
    false
  end

  def self.clear_cache_and_reset_library_window(show_message = true)
    refresh_message = MHDESIGN::Language.for_tool('library').t('TEXT_30883CAC8762')
    ok = clear_cache_targets(%w[ads code units tools], false)
    reset_library_window_state
    if show_message
      if ok
        UI.messagebox(refresh_message)
      else
        UI.messagebox("#{MHDESIGN::Language.for_tool('library').t('TEXT_7E189E6E8CB6')}")
      end
    end
    ok
  rescue => e
    UI.messagebox("#{MHDESIGN::Language.for_tool('library').t('TEXT_7C0576E85AB8')}#{e.message}") if show_message
    false
  end

  def self.refresh_library_with_window_reset
    clear_cache_and_reset_library_window(true)
  end

  def self.clear_cache(show_message = true)
    clear_cache_and_reset_library_window(show_message)
  end

  def self.purge_legacy_remote_tool_cache_silent
    begin
      old_dir = File.join(Dir.tmpdir, "MHDESIGN_REMOTE_TOOLS")
      FileUtils.rm_rf(old_dir) if File.directory?(old_dir)
    rescue
    end
    begin
      Dir.glob(File.join(Dir.tmpdir, "mhd_remote_*.rb")).each do |f|
        begin
          File.delete(f) if File.file?(f)
        rescue
        end
      end
    rescue
    end
  end

  def self.remove_const_path_safely(path)
    parts = path.to_s.split("::").reject { |x| x.to_s.strip.empty? }
    return false if parts.empty?
    parent = Object
    parts[0...-1].each do |name|
      return false unless parent.const_defined?(name, false)
      parent = parent.const_get(name)
    end
    last = parts[-1]
    if parent.const_defined?(last, false)
      parent.send(:remove_const, last)
      true
    else
      false
    end
  rescue
    false
  end

  def self.load_remote_ruby_live(url, key: "remote_tool", remove_consts: [], cache_prefix: "tool")
    url_s = url.to_s.strip
    raise "Remote URL empty" if url_s.empty?
    Array(remove_consts).each { |const_path| remove_const_path_safely(const_path) }
    begin
      code = fetch_text_with_encrypted_cache(url_s, cache_prefix.to_s)
      raise "Empty remote file" if code.to_s.strip.empty?
      eval(code.force_encoding("UTF-8"), TOPLEVEL_BINDING, "(remote:#{key})", 1)
      true
    rescue => e
      UI.messagebox("❌ فشل تحميل/تشغيل الأداة من السيرفر:\n#{e.message}")
      false
    end
  end

  def self.activate_hand_groove_tool_from_server
    begin
      ok = load_remote_ruby_live(GROOVE_TOOL_URL, key: "hand_groove_led", remove_consts: ["MHDESIGN::HandGroove90"])
      return false unless ok
      if defined?(MHDESIGN::HandGroove90) && MHDESIGN::HandGroove90.respond_to?(:activate_tool)
        MHDESIGN::HandGroove90.activate_tool
        return true
      end
      if defined?(MHDESIGN)
        MHDESIGN.constants.each do |c|
          begin
            mod = MHDESIGN.const_get(c)
            if mod.respond_to?(:activate_tool)
              mod.activate_tool
              return true
            end
          rescue
          end
        end
      end
      UI.messagebox("⚠️ تم تحميل LED.rb ✅ لكن لم أجد دالة تشغيل.\nلازم يكون فيه:\nMHDESIGN::HandGroove90.activate_tool")
      false
    rescue => e
      UI.messagebox("❌ فشل تحميل/تشغيل أداة الجروف:\n#{e.message}")
      false
    end
  end

  def self.load_core_context_tools_from_server
    return true if @core_context_tools_loaded
    tools = [
      { url: COUNTERTOP_ENGINE_URL, key: "countertop_engine", remove_consts: ["MHD_Countertop_Engine", "MHDESIGN::MHD_Countertop_Engine"] },
      { url: OPENING_ENGINE_URL, key: "opening_engine", remove_consts: ["mhd_opening_engine", "MHDESIGN::mhd_opening_engine"] },
      { url: ROOM_BUILDER_URL, key: "room_builder", remove_consts: ["mhd_room_builder", "MHDESIGN::mhd_room_builder"] }
    ]
    success = true
    tools.each do |tool|
      ok = load_remote_ruby_live(tool[:url], key: tool[:key], remove_consts: tool[:remove_consts], cache_prefix: "tool")
      success = false unless ok
    end
    @core_context_tools_loaded = success
    success
  end

  def self.load_component_translator_from_server
    if defined?(MHDESIGN::ComponentTranslator) && MHDESIGN::ComponentTranslator.respond_to?(:translate_selection)
      @component_translator_loaded = true
      return true
    end
    ok = load_remote_ruby_live(COMPONENT_TRANSLATOR_URL, key: "component_translator", remove_consts: ["MHDESIGN::ComponentTranslator"], cache_prefix: "tool")
    return false unless ok
    unless defined?(MHDESIGN::ComponentTranslator)
      UI.messagebox("#{MHDESIGN::Language.for_tool('library').t('TEXT_BF28E0A85581')}")
      return false
    end
    translator = MHDESIGN::ComponentTranslator
    if !translator.respond_to?(:translate_selection) && translator.instance_methods(false).include?(:translate_selection)
      translator.extend(translator)
    end
    unless translator.respond_to?(:translate_selection)
      UI.messagebox("#{MHDESIGN::Language.for_tool('library').t('TEXT_820F5A68EFCC')}")
      return false
    end
    @component_translator_loaded = true
    true
  rescue => e
    UI.messagebox("❌ فشل تحميل أداة ترجمة أسماء القطع:\n#{e.message}")
    false
  end

  def self.activate_component_translator_from_server
    return false unless load_component_translator_from_server
    selection = Sketchup.active_model.selection.to_a.select do |entity|
      entity.is_a?(Sketchup::ComponentInstance) || entity.is_a?(Sketchup::Group)
    end
    if selection.empty?
      UI.messagebox(tr("حدد الوحدة أو الوحدات المطلوب ترجمة أسماء قطعها أولاً."))
      return false
    end
    MHDESIGN::ComponentTranslator.translate_selection
    true
  rescue => e
    UI.messagebox("❌ فشل تشغيل أداة ترجمة أسماء القطع:\n#{e.message}")
    false
  end

