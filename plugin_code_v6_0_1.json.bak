    body { margin: 0; background: var(--bg-app); color: var(--text-primary); font: 13px/1.4 Cairo, Tajawal, "Segoe UI", Tahoma, sans-serif; }
    .page { min-height: 100vh; padding: 12px; display: flex; flex-direction: column; gap: 10px; }
    .hero, .card { border: 1px solid var(--border-default); border-radius: 12px; }
    .hero { display: flex; align-items: center; gap: 10px; padding: 10px; background: var(--header-gradient); }
    .hero h1 { margin: 0; font-size: 18px; }
    .hero p { margin: 3px 0 0; color: var(--text-secondary); font-size: 12px; }
    .brand-mark { display: grid; place-items: center; flex: 0 0 42px; height: 42px; padding: 6px; border: 1px solid var(--border-default); border-radius: 8px; background: var(--bg-input); color: var(--border-active); }
    .brand-mark img, .brand-mark svg { width: 100%; height: 100%; object-fit: contain; }
    .card { padding: 10px; background: var(--bg-panel); }
    button { min-height: 38px; padding: 5px 10px; border: 1px solid transparent; border-radius: 8px; font: inherit; font-weight: 700; cursor: pointer; }
    button:focus, .switch input:focus + .slider { outline: 2px solid var(--border-active); outline-offset: 2px; }
    .primary { background: var(--button-gradient); color: #04191C; }
    .primary:hover { background: var(--accent-hover); }
    .secondary { background: var(--bg-input); color: var(--text-primary); border-color: var(--border-default); }
    .secondary:hover { background: var(--bg-hover); }
  CSS

  def self.show_device_id_dialog
    if @device_id_dialog && @device_id_dialog.visible?
      @device_id_dialog.bring_to_front
      return
    end
    device_id = get_device_id.to_s
    @device_id_dialog = UI::HtmlDialog.new(
      dialog_title: "#{MHDESIGN::Language.for_tool('library').t('TEXT_3D13A0E69545')}",
      preferences_key: "mrkitchen_device_id_dialog_v1",
      scrollable: false, resizable: false, width: 430, height: 245,
      style: UI::HtmlDialog::STYLE_DIALOG
    )
    @device_id_dialog.set_html(<<~HTML)
      <!doctype html>
      <html lang="#{MHDESIGN::Language.current.tr('_','-')}" dir="#{MHDESIGN::Language.direction}">
      <head>
        <meta charset="UTF-8">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;800&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
        <style>
          #{ACCOUNT_DIALOG_THEME}
          .device {
            direction: ltr; text-align: center; overflow-wrap: anywhere; user-select: all;
            padding: 10px; border: 1px solid var(--border-default); border-radius: 8px;
            background: var(--bg-input); font: 13px/1.5 Consolas, monospace;
          }
          .copy { align-self: center; min-width: min(156px, 100%); }
        #{MHDESIGN_ResponsiveHeaderUI::CSS}
:root { --bg-panel: var(--ref-panel); --bg-input: var(--ref-input); --border-default: var(--ref-border); --button-gradient: var(--ref-action); }
.hero.mhd-ref-header { min-height: 58px; }
.feature { background: var(--ref-section); }
        </style>
      </head>
      <body oncontextmenu="return false">
        <main class="page">
          <header class="hero mhd-ref-header">
            #{MHDESIGN_ResponsiveHeaderUI::BRAND}
            <div class="mhd-ref-heading">
              <h1>#{MHDESIGN::Language.for_tool('library').html('ACCOUNT_DEVICE')}</h1>
              <p>#{MHDESIGN::Language.for_tool('library').html('TEXT_3624FCB9C839')}</p>
            </div>
          </header>
          <div class="card">
            <div class="device" id="deviceId">#{html_escape(device_id)}</div>
          </div>
          <button type="button" class="primary copy" id="copyButton" onclick="copyDeviceId()">#{MHDESIGN::Language.for_tool('library').html('TEXT_B1CD7130C68E')}</button>
        </main>
        <script>
          function copyDeviceId(){
            const value=document.getElementById('deviceId').textContent;
            const copied=()=>{const button=document.getElementById('copyButton');button.textContent='#{MHDESIGN::Language.for_tool('library').js_fragment('TEXT_A1A405BBA8F5')}';setTimeout(()=>button.textContent='#{MHDESIGN::Language.for_tool('library').js_fragment('TEXT_B1CD7130C68E')}',1800)};
            const fallback=()=>{const input=document.createElement('textarea');input.value=value;input.style.position='fixed';input.style.opacity='0';document.body.appendChild(input);input.select();const success=document.execCommand('copy');document.body.removeChild(input);if(success)copied()};
            if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(value).then(copied).catch(fallback)}else{fallback()}
          }
        </script>
      </body>
      </html>
    HTML
    @device_id_dialog.set_on_closed { @device_id_dialog = nil }
    @device_id_dialog.center if @device_id_dialog.respond_to?(:center)
    @device_id_dialog.show
  end

  def self.humanize_seconds(total)
    total = total.to_i
    m, s = total.divmod(60)
    h, m = m.divmod(60)
    if current_language == 'en'
      parts = []
      parts << "#{h} #{h == 1 ? 'hour' : 'hours'}" if h > 0
      parts << "#{m} #{m == 1 ? 'minute' : 'minutes'}" if m > 0
      parts << "#{s} #{s == 1 ? 'second' : 'seconds'}" if s > 0 || parts.empty?
      parts.join(' and ')
    else
      parts = []
      parts << "#{h} ساعة"  if h > 0
      parts << "#{m} دقيقة" if m > 0
      parts << "#{s} ثانية" if s > 0 || parts.empty?
      parts.join(' و ')
    end
  end

  def self.activate(force_prompt = true)
    email    = Sketchup.read_default(PLUGIN_NAME, "email")   || ""
    password = Sketchup.read_default(PLUGIN_NAME, "license") || ""
    if force_prompt || email.empty? || password.empty?
      input = UI.inputbox(
        ["البريد الإلكتروني / اسم المستخدم", "كلمة المرور"],
        [email, password], "تفعيل MR Kitchen"
      )
      return false unless input
      email, password = input
    end
    device = get_device_id
    begin
      raw = URI.open(GITHUB_USERS_URL, open_timeout: OPEN_TIMEOUT, read_timeout: READ_TIMEOUT).read
      data = JSON.parse(raw)
      users = data.is_a?(Hash) ? data["users"] : nil
      raise "بيانات المستخدمين غير صالحة" unless users.is_a?(Array)
      user = users.find { |u| u.is_a?(Hash) && u["email"].to_s.strip.casecmp?(email.to_s.strip) }
      unless user
        clear_offline_access_grant
        UI.messagebox("❌ لا يوجد مستخدم بهذا البريد/الاسم.") if force_prompt
        return false
      end
      unless user["password"].to_s == password.to_s
        clear_offline_access_grant
        UI.messagebox("❌ كلمة المرور غير صحيحة.") if force_prompt
        return false
      end
      allowed_device = user["device_id"].to_s.strip
      if allowed_device.empty? || allowed_device != device.to_s
        clear_offline_access_grant
        if force_prompt
          UI.messagebox(
            "❌ هذا الحساب مرتبط بجهاز آخر.\n\n" \
            "جهازك الحالي: #{device}\n" \
            "الجهاز المسجل: #{allowed_device.empty? ? 'غير محدد' : allowed_device}\n\n" \
            "تواصل مع الدعم لتحديث الجهاز."
          )
        end
        return false
      end
      unless user["active"] == true
        clear_offline_access_grant
        UI.messagebox("❌ هذا الحساب غير مفعّل حاليًا.") if force_prompt
        return false
      end
      expiry_str = user["expiry_date"].to_s.strip
      unless expiry_str.empty?
        begin
          expiry_date = Date.parse(expiry_str)
          if Date.today > expiry_date
            clear_offline_access_grant
            UI.messagebox("❌ انتهى اشتراكك بتاريخ: #{expiry_str}\nيرجى التجديد للاستمرار.") if force_prompt
            return false
          end
          Sketchup.write_default(PLUGIN_NAME, "ends_at", expiry_str)
        rescue ArgumentError
          clear_offline_access_grant
          UI.messagebox("❌ تاريخ انتهاء الاشتراك غير صالح: #{expiry_str}") if force_prompt
          return false
        end
      else
        Sketchup.write_default(PLUGIN_NAME, "ends_at", "")
      end
      Sketchup.write_default(PLUGIN_NAME, "email",          email)
      Sketchup.write_default(PLUGIN_NAME, "license",        password)
      Sketchup.write_default(PLUGIN_NAME, "activated_once", true)
      write_offline_access_grant(email, password)
      UI.messagebox("✅ تم التفعيل بنجاح.") if force_prompt
      true
    rescue => e
      if offline_access_allowed?(email, password)
        true
      else
        msg = "⚠️ فشل الاتصال بالسيرفر: #{e.message}"
        if Sketchup.read_default(PLUGIN_NAME, "activated_once")
          left = offline_access_remaining_seconds
          if left <= 0
            msg += "\n\nانتهت مدة السماح بالأوفلاين. برجاء الاتصال بالإنترنت للتحقق من الترخيص."
          else
            msg += "\n\nلا يوجد تصريح أوفلاين صالح لهذا الترخيص."
          end
        end
        UI.messagebox(msg) if force_prompt
        false
      end
    end
  end

