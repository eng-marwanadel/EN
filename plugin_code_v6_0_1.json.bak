  def self.load_options_protected_from_server
    return true if @options_protected_loaded && options_protected_module
    ok = load_remote_ruby_live(OPTIONS_PROTECTED_URL, key: "options_protected", remove_consts: ["MHDESIGN_Options_protected", "MHDESIGN::MHDESIGN_Options_protected", "MHDESIGN::PremiumComponentOptions"], cache_prefix: "tool")
    return false unless ok
    @options_protected_loaded = true
    true
  end

  def self.options_protected_module
    candidates = []
    begin
      candidates << Object.const_get(:MHDESIGN_Options_protected) if Object.const_defined?(:MHDESIGN_Options_protected)
    rescue
    end
    begin
      candidates << MHDESIGN.const_get(:MHDESIGN_Options_protected) if MHDESIGN.const_defined?(:MHDESIGN_Options_protected, false)
    rescue
    end
    begin
      candidates << MHDESIGN.const_get(:PremiumComponentOptions) if MHDESIGN.const_defined?(:PremiumComponentOptions, false)
    rescue
    end
    candidates.compact.first
  rescue
    nil
  end

  def self.open_options_protected
    return false unless load_options_protected_from_server
    mod = options_protected_module
    unless mod
      UI.messagebox("#{MHDESIGN::Language.for_tool('library').t('TEXT_0750CAA503A9')}")
      return false
    end
    [:open, :show, :open_dialog, :show_dialog, :run, :start].each do |method_name|
      if mod.respond_to?(method_name)
        mod.send(method_name)
        return true
      end
    end
    UI.messagebox("#{MHDESIGN::Language.for_tool('library').t('TEXT_B2E898430DEC')}")
    false
  rescue => e
    UI.messagebox("#{MHDESIGN::Language.for_tool('library').t('TEXT_62E0288ADB5C')}#{e.message}")
    false
  end

