# ==================== ENCRYPTED LANGUAGE RESOURCES ====================
module MHDESIGN
  module TranslationPackage
    extend self
    VERSION = 'per-tool-c2f9301002587afd'.freeze
    URL = 'https://mhdesign-eg.com/SKETCHUP022/language/translation_bundle.json'.freeze

    def validate(raw)
      package = JSON.parse(raw.force_encoding('UTF-8'))
      raise LoadError, 'Invalid translation bundle' unless package['version'].is_a?(String) && !package['version'].strip.empty? && package['files'].is_a?(Hash) && !package['files'].empty?
      resources = {}
      package['files'].each do |relative, entry|
        valid = relative == 'language/language_engine.rb' || relative.match?(%r{\Alanguage/(?:manifest\.json|tools/[a-z_]+/(?:ar_EG|ar_SA|ar_IQ|en|fr|tr)\.json)\z})
        next unless valid
        content = Base64.strict_decode64(entry.fetch('base64'))
        raise LoadError, 'Translation checksum mismatch' unless Digest::SHA256.hexdigest(content) == entry['sha256']
        resources[relative] = content.force_encoding('UTF-8')
      end
      %w[language/language_engine.rb language/manifest.json language/tools/library/en.json].each do |name|
        raise LoadError, "Missing translation resource: #{name}" unless resources.key?(name)
      end
      manifest = JSON.parse(resources.fetch('language/manifest.json'))
      raise LoadError, 'Invalid language manifest' unless manifest['languages'].is_a?(Array)
      scopes = %w[common library]
      resources.each do |relative, content|
        match = relative.match(%r{\Alanguage/tools/([a-z_]+)/(ar_EG|ar_SA|ar_IQ|en|fr|tr)\.json\z})
        next unless match
        data = JSON.parse(content)
        raise LoadError, 'Invalid tool dictionary' unless data['locale'] == match[2] && data['texts'].is_a?(Hash)
        scopes << match[1]
      end
      scopes.uniq.each do |scope|
        %w[ar_EG ar_SA ar_IQ en fr tr].each do |locale|
          raise LoadError, 'Incomplete tool dictionary' unless resources.key?("language/tools/#{scope}/#{locale}.json")
        end
      end
      begin
        RubyVM::InstructionSequence.compile(resources.fetch('language/language_engine.rb'))
      rescue SyntaxError => error
        raise LoadError, "Invalid language engine: #{error.message}"
      end
      [package['version'], resources]
    end

    def resources
      return @resources if @resources
      cached = MHDESIGN.read_encrypted_cache_for_url(URL, 'language')
      if cached
        begin
          version, entries = validate(cached)
          return @resources = entries
        rescue LoadError, StandardError
        end
      end
      begin
        raw = URI.open(URL, open_timeout: 10, read_timeout: 30).read
        version, entries = validate(raw)
        path = MHDESIGN.write_encrypted_cache_for_url(URL, raw, 'language')
        raise LoadError, 'Could not write encrypted translation cache' unless path
        @resources = entries
      rescue LoadError, StandardError
        raise unless cached
        _, @resources = validate(cached)
        @resources
      end
    end

    def read(relative)
      resources.fetch(relative)
    end

    def remove_legacy_plaintext_cache!
      temporary_root = File.expand_path(Dir.tmpdir)
      legacy = File.expand_path(File.join(temporary_root, 'MHDESIGN_TRANSLATION'))
      raise 'Invalid legacy cache path' unless File.dirname(legacy) == temporary_root && File.basename(legacy) == 'MHDESIGN_TRANSLATION'
      FileUtils.rm_rf(legacy) if File.exist?(legacy)
      raise 'Could not remove old plaintext translation cache' if File.exist?(legacy)
    end

    def boot!
      remove_legacy_plaintext_cache!
      eval(read('language/language_engine.rb'), TOPLEVEL_BINDING, '(mhdesign_language_engine)', 1) unless defined?(MHDESIGN::Language)
    end

    def invalidate!
      @resources = nil
      if defined?(MHDESIGN::Language)
        MHDESIGN::Language.instance_variable_set(:@languages, nil)
        MHDESIGN::Language.instance_variable_set(:@tools, {})
      end
    end
  end
end

module MHDESIGN
  def self.current_language
    if defined?(MHDESIGN::Language)
      MHDESIGN::Language.current
    else
      Sketchup.read_default('MHDESIGN', 'language_code', 'ar_EG').to_s
    end
  rescue
    'ar_EG'
  end

  def self.set_language(code)
    value = code.to_s.strip
    if defined?(MHDESIGN::Language)
      MHDESIGN::Language.set(value)
    else
      Sketchup.write_default('MHDESIGN', 'language_code', value)
      value
    end
  rescue
    current_language
  end

  def self.t(key, fallback=nil)
    defined?(MHDESIGN::Language) ? MHDESIGN::Language.for_tool('library').t(key, fallback) : (fallback || key).to_s
  end

  def self.tr(text)
    defined?(MHDESIGN::Language) ? MHDESIGN::Language.for_tool('library').translate_source(text.to_s) : text.to_s
  rescue
    text.to_s
  end

  def self.available_languages
    if defined?(MHDESIGN::Language)
      MHDESIGN::Language.available_languages
    else
      [{ "code" => "ar_EG", "name" => "العربية - مصر", "direction" => "rtl", "file" => "ar_EG.json" }]
    end
  rescue
    []
  end

