  def self.cache_root_dir
    File.join(Dir.tmpdir, CACHE_ROOT_DIR)
  rescue
    File.join(Dir.tmpdir, "A9A6D99_5957844_88970")
  end

  def self.units_cache_root_dir
    File.join(Dir.tmpdir, UNITS_CACHE_ROOT_DIR)
  rescue
    File.join(Dir.tmpdir, "A9A6D99_5957844_88980")
  end

  def self.cache_dir_for_prefix(prefix = "remote")
    pfx = prefix.to_s.strip.downcase
    case pfx
    when "json", "skp" then units_cache_root_dir
    else cache_root_dir
    end
  rescue
    cache_root_dir
  end

  def self.ensure_cache_root!(prefix = nil)
    FileUtils.mkdir_p(cache_root_dir)
    FileUtils.mkdir_p(units_cache_root_dir)
    prefix ? cache_dir_for_prefix(prefix) : cache_root_dir
  rescue
    prefix ? cache_dir_for_prefix(prefix) : cache_root_dir
  end

  PERSONAL_PACKAGE_MAGIC = "MHDLIB1\x00".b unless const_defined?(:PERSONAL_PACKAGE_MAGIC, false)

  def self.personal_pack(payload)
    cipher = OpenSSL::Cipher.new('aes-256-gcm')
    cipher.encrypt
    cipher.key = Digest::SHA256.digest("#{CACHE_SECRET_SALT}|MHDESIGN_PERSONAL_TRANSFER_V1")
    iv = OpenSSL::Random.random_bytes(12)
    cipher.iv = iv
    cipher.auth_data = PERSONAL_PACKAGE_MAGIC
    compressed = Zlib::Deflate.deflate(JSON.generate(payload), Zlib::BEST_SPEED)
    encrypted = cipher.update(compressed) + cipher.final
    PERSONAL_PACKAGE_MAGIC + iv + cipher.auth_tag(16) + encrypted
  end

  def self.personal_unpack(bytes)
    magic = PERSONAL_PACKAGE_MAGIC
    raise MHDESIGN::Language.for_tool('library').t('TEXT_319983062969') unless bytes.bytesize > magic.bytesize + 28 && bytes.start_with?(magic)
    cipher = OpenSSL::Cipher.new('aes-256-gcm')
    cipher.decrypt
    cipher.key = Digest::SHA256.digest("#{CACHE_SECRET_SALT}|MHDESIGN_PERSONAL_TRANSFER_V1")
    cipher.iv = bytes.byteslice(magic.bytesize, 12)
    cipher.auth_tag = bytes.byteslice(magic.bytesize + 12, 16)
    cipher.auth_data = magic
    plain = cipher.update(bytes.byteslice(magic.bytesize + 28..-1)) + cipher.final
    data = JSON.parse(Zlib::Inflate.inflate(plain).force_encoding('UTF-8'))
    raise MHDESIGN::Language.for_tool('library').t('TEXT_B8A879B0C9A4') unless data.is_a?(Hash) && data['format'] == 'MHDESIGN_PERSONAL_LIBRARY' && data['version'] == 1
    data
  rescue OpenSSL::Cipher::CipherError, Zlib::Error, JSON::ParserError
    raise MHDESIGN::Language.for_tool('library').t('TEXT_F680A4F3A458')
  end

  def self.personal_unit_fingerprint(unit, model, image)
    Digest::SHA256.hexdigest(JSON.generate([unit['name'], unit['desc'].to_s, unit['image_mime'], unit['cutlist_name'] == true, Digest::SHA256.hexdigest(model), Digest::SHA256.hexdigest(image)]))
  end

  def self.personal_export(dialog)
    target = UI.savepanel('تصدير مكتبتي', '', "MRKitchen_MyLibrary_#{Time.now.strftime('%Y%m%d')}.mrklibrary")
    return false if target.to_s.empty?
    target += '.mrklibrary' if File.extname(target).empty?
    catalog = personal_catalog
    package = {'format'=>'MHDESIGN_PERSONAL_LIBRARY', 'version'=>1,
               'categories'=>catalog['categories'].map { |c| c.slice('id', 'parent', 'name', 'image_data', 'image_mime') }, 'units'=>[]}
    total = [catalog['units'].length, 1].max
    catalog['units'].each_with_index do |unit, index|
      personal_progress(dialog, 10 + index * 65 / total, "جاري تجميع الوحدات… #{index + 1}/#{total}")
      model = decrypt_cache_text(File.binread(personal_file('LibraryUnits', unit['id'], '.cache')))
      image = File.binread(personal_file('LibraryImages', unit['id'], '.image'))
      record = unit.slice('id', 'category', 'name', 'desc', 'image_mime', 'cutlist_name', 'dressing_type')
      record['model_data'] = Base64.strict_encode64(model)
      record['image_data'] = Base64.strict_encode64(image)
      record['fingerprint'] = personal_unit_fingerprint(record, model, image)
      package['units'] << record
    end
    personal_progress(dialog, 80, 'جاري تجهيز ملف التصدير…')
    bytes = personal_pack(package)
    temporary = Tempfile.new(['mrkitchen_library_export', '.tmp'], File.dirname(target))
    begin
      temporary.binmode
      temporary.write(bytes)
      temporary.flush
      temporary.fsync
      temporary.close
      File.rename(temporary.path, target)
    ensure
      temporary.close!
    end
    personal_progress(dialog, 100, 'تم تصدير مكتبتي')
    true
  end

  def self.personal_import(dialog)
    source = UI.openpanel('استيراد مكتبة', '', 'MR Kitchen Library|*.mrklibrary||')
    return false if source.to_s.empty?
    personal_progress(dialog, 10, 'جاري قراءة ملف المكتبة…')
    package = personal_unpack(File.binread(source))
    categories, units = package['categories'], package['units']
    raise MHDESIGN::Language.for_tool('library').t('TEXT_D7116C7208BB') unless categories.is_a?(Array) && units.is_a?(Array)
    validate_id = lambda { |id| id.is_a?(String) && id.match?(/\A[0-9a-f-]{36}\z/) }
    category_ids, unit_ids = [], []
    categories.each do |category|
      raise MHDESIGN::Language.for_tool('library').t('TEXT_6A1910624D35') unless category.is_a?(Hash) && validate_id.call(category['id']) && category['name'].is_a?(String) && !category['name'].strip.empty? && category['name'].length <= 120 && category['parent'].is_a?(String)
      category_ids << category['id']
      personal_category_picture({'data'=>category['image_data'], 'mime'=>category['image_mime']}) if category['image_data']
    end
    raise MHDESIGN::Language.for_tool('library').t('TEXT_3A0E70E2262A') unless category_ids.uniq.length == category_ids.length
    units.each do |unit|
      raise MHDESIGN::Language.for_tool('library').t('TEXT_81CC462DF564') unless unit.is_a?(Hash) && validate_id.call(unit['id']) && category_ids.include?(unit['category']) && unit['name'].is_a?(String) && !unit['name'].strip.empty? && unit['name'].length <= 200 && %w[image/png image/jpeg image/gif].include?(unit['image_mime'])
      unit_ids << unit['id']
    end
    raise MHDESIGN::Language.for_tool('library').t('TEXT_F118D6615661') unless unit_ids.uniq.length == unit_ids.length
    current = personal_catalog
    merged = {'version'=>1, 'categories'=>current['categories'].map(&:dup), 'units'=>current['units'].map(&:dup)}
    mapping, remaining = {}, categories.dup
    until remaining.empty?
      ready = remaining.select { |c| c['parent'].empty? || mapping.key?(c['parent']) }
      raise MHDESIGN::Language.for_tool('library').t('TEXT_F9FBEBCF0167') if ready.empty?
      ready.each do |category|
        parent = category['parent'].empty? ? '' : mapping.fetch(category['parent'])
        found = merged['categories'].find { |c| c['parent'] == parent && c['name'].to_s.strip == category['name'].strip }
        unless found
          found = {'id'=>SecureRandom.uuid, 'parent'=>parent, 'name'=>category['name'].strip}
          merged['categories'] << found
        end
        if category['image_data'] && !found['image_data']
          found.merge!(personal_category_picture({'data'=>category['image_data'], 'mime'=>category['image_mime']}))
        end
        mapping[category['id']] = found['id']
      end
      remaining -= ready
    end
    staging = File.join(personal_root, '.import_' + SecureRandom.uuid)
    FileUtils.mkdir_p(staging)
    moved, staged = [], []
    committed = false
    begin
      total = [units.length, 1].max
      units.each_with_index do |unit, index|
        personal_progress(dialog, 20 + index * 65 / total, "جاري استيراد الوحدات… #{index + 1}/#{total}")
        model = Base64.strict_decode64(unit.fetch('model_data'))
        image = Base64.strict_decode64(unit.fetch('image_data'))
        raise MHDESIGN::Language.for_tool('library').t('TEXT_128E7E5D43B9') if model.empty? || image.empty?
        fingerprint = personal_unit_fingerprint(unit, model, image)
        raise MHDESIGN::Language.for_tool('library').t('TEXT_E845B41EE5AB') unless unit['fingerprint'] == fingerprint
        category = mapping.fetch(unit['category'])
        duplicate = current['units'].any? do |record|
          next false unless record['category'] == category
          if record['name'] == unit['name'] && record['desc'].to_s == unit['desc'].to_s && record['image_mime'] == unit['image_mime'] && (record['cutlist_name'] == true) == (unit['cutlist_name'] == true)
            next false unless File.file?(personal_file('LibraryUnits', record['id'], '.cache')) && File.file?(personal_file('LibraryImages', record['id'], '.image'))
            local_model = decrypt_cache_text(File.binread(personal_file('LibraryUnits', record['id'], '.cache')))
            local_image = File.binread(personal_file('LibraryImages', record['id'], '.image'))
            personal_unit_fingerprint(record, local_model, local_image) == fingerprint
          else
            false
          end
        end
        next if duplicate
        id = SecureRandom.uuid
        record = unit.slice('name', 'desc', 'image_mime', 'cutlist_name', 'dressing_type')
        record.merge!('id'=>id, 'category'=>category, 'import_source_id'=>unit['id'], 'import_fingerprint'=>fingerprint)
        model_file, image_file = File.join(staging, id + '.cache'), File.join(staging, id + '.image')
        File.binwrite(model_file, encrypt_cache_text(model))
        File.binwrite(image_file, image)
        staged << [model_file, personal_file('LibraryUnits', id, '.cache')]
        staged << [image_file, personal_file('LibraryImages', id, '.image')]
        merged['units'] << record
      end
      personal_progress(dialog, 90, 'جاري حفظ الأقسام والوحدات…')
      staged.each do |from, to|
        raise MHDESIGN::Language.for_tool('library').t('TEXT_B656F9F43584') if File.exist?(to)
        File.rename(from, to)
        moved << to
      end
      personal_write(merged)
      committed = true
    ensure
      moved.each { |path| File.delete(path) if File.file?(path) } unless committed
      FileUtils.remove_entry(staging) if File.directory?(staging)
    end
    personal_push(dialog)
    personal_progress(dialog, 100, 'تم استيراد المكتبة')
    true
  end

  def self.personal_root
    home = ENV['USERPROFILE'].to_s.strip
    home = Dir.home if home.empty?
    root = File.join(home, 'Documents', 'MR Kitchen', 'CustomAssets')
    %w[LibraryUnits LibraryImages].each { |folder| FileUtils.mkdir_p(File.join(root, folder)) }
    root
  end

  def self.personal_path
    File.join(personal_root, 'custom_library.json')
  end

  def self.personal_catalog
    return {'version'=>1, 'categories'=>[], 'units'=>[]} unless File.file?(personal_path)
    data = JSON.parse(File.binread(personal_path).force_encoding('UTF-8'))
    raise MHDESIGN::Language.for_tool('library').t('TEXT_9945363024E7') unless data.is_a?(Hash) && data['categories'].is_a?(Array) && data['units'].is_a?(Array)
    root_units = data['units'].select { |u| u['category'].to_s.empty? }
    unless root_units.empty?
      id = SecureRandom.uuid
      data['categories'] << {'id'=>id, 'parent'=>'', 'name'=>'وحداتي المحفوظة'}
      root_units.each { |u| u['category'] = id }
      personal_write(data)
    end
    data
  end

  def self.personal_write(data)
    path = personal_path
    tmp = path + '.tmp'
    File.open(tmp, 'wb') { |f| f.write(JSON.pretty_generate(data).encode('UTF-8')); f.flush; f.fsync }
    FileUtils.cp(path, path + '.bak') if File.file?(path)
    File.rename(tmp, path)
  ensure
    File.delete(tmp) if tmp && File.file?(tmp)
  end

  def self.personal_file(folder, id, extension)
    raise MHDESIGN::Language.for_tool('library').t('TEXT_45EBF43DD890') unless id.to_s.match?(/\A[0-9a-f-]{36}\z/)
    File.join(personal_root, folder, id + extension)
  end

  def self.personal_thumbnail(entity)
    temp = Tempfile.new(['mrkitchen_personal_thumbnail', '.png'])
    temp.close
    return nil unless entity.definition.save_thumbnail(temp.path) && File.size?(temp.path)
    [File.binread(temp.path), 'image/png']
  rescue => error
    puts "MR Kitchen personal thumbnail: #{error.message}"
    nil
  ensure
    temp.close! if temp
  end

  def self.personal_progress(dialog, percent, message)
    dialog.execute_script("window.personalProgress(#{percent.to_i}, #{JSON.generate(message)});")
  rescue
    nil
  end

  def self.personal_push(dialog)
    data = personal_catalog
    data['categories'].each do |category|
      if category['image_data'] && category['image_mime']
        category['image'] = "data:#{category['image_mime']};base64,#{category['image_data']}"
      end
    end
    data['units'].each do |unit|
      image = personal_file('LibraryImages', unit['id'], '.image')
      if File.file?(image)
        unit['image'] = "data:#{unit['image_mime']};base64,#{Base64.strict_encode64(File.binread(image))}"
      end
    end
    dialog.execute_script("window.personalReceive(#{JSON.generate(data)});")
  end

  def self.personal_category_picture(picture)
    return {} if picture.nil?
    raise MHDESIGN::Language.for_tool('library').t('TEXT_E28AE8BBB0E5') unless picture.is_a?(Hash) && %w[image/png image/jpeg image/gif].include?(picture['mime']) && picture['data'].is_a?(String) && picture['data'].bytesize <= 3 * 1024 * 1024
    bytes = Base64.strict_decode64(picture['data'])
    raise MHDESIGN::Language.for_tool('library').t('TEXT_E0FCE99F12D1') if bytes.empty? || bytes.bytesize > 2 * 1024 * 1024
    {'image_data'=>Base64.strict_encode64(bytes), 'image_mime'=>picture['mime']}
  end

  def self.personal_rename(entity, label, ancestors = [])
    entity.make_unique
    definition = entity.definition
    raise MHDESIGN::Language.for_tool('library').t('TEXT_A7B4C517033E') if ancestors.include?(definition.object_id)
    rename = lambda do |text|
      value = text.to_s.gsub(/#\d+\s*\z/, '').strip
      value.match?(/\([^)]*\)/) ? value.sub(/\([^)]*\)(?!.*\([^)]*\))/) { "(#{label})" } : "#{value} (#{label})".strip
    end
    definition.name = rename.call(definition.name)
    entity.name = rename.call(entity.name) unless entity.name.to_s.empty?
    [definition, entity].each do |owner|
      dict = owner.attribute_dictionary('dynamic_attributes', false)
      next unless dict
      %w[_name name NAME].each do |key|
        next unless dict[key].is_a?(String)
        value = dict[key]
        dict[key] = value.match?(/\([^)]*\)/) ? value.sub(/\([^)]*\)(?!.*\([^)]*\))/) { "(#{label})" } : "#{value} (#{label})"
      end
    end
    definition.entities.each do |child|
      personal_rename(child, label, ancestors + [definition.object_id]) if child.is_a?(Sketchup::ComponentInstance) || child.is_a?(Sketchup::Group)
    end
  end

  def self.personal_dressing_target(entity, seen = [])
    return nil unless entity && entity.valid?
    type = dressing_unit_type(entity)
    return [entity, type] if type
    definition = entity.respond_to?(:definition) ? entity.definition : entity
    return nil unless definition.respond_to?(:entities)
    return nil if seen.include?(definition.object_id)
    entities = definition.entities.to_a
    return nil unless entities.length == 1
    child = entities.first
    return nil unless child.is_a?(Sketchup::ComponentInstance) || child.is_a?(Sketchup::Group)
    personal_dressing_target(child, seen + [definition.object_id])
  end

  def self.personal_unwrap_dressing!(instance)
    return instance unless personal_dressing_target(instance)
    return instance if dressing_unit_type(instance)
    model = Sketchup.active_model
    model.start_operation('تجهيز وحدة الدريسنج من مكتبتي', true)
    begin
      current = instance
      until dressing_unit_type(current)
        entities = current.explode
        current = Array(entities).find { |child| child.is_a?(Sketchup::ComponentInstance) || child.is_a?(Sketchup::Group) }
        raise MHDESIGN::Language.for_tool('library').t('TEXT_1922DD95F635') unless current && current.valid?
      end
      model.commit_operation
      current
    rescue
      model.abort_operation
      raise
    end
  end

  def self.personal_dressing_name(entity)
    fallback = entity.definition.name.to_s.strip
    data = JSON.parse(dressing_attribute(entity, 'DATA_JSON').to_s)
    name = data.is_a?(Hash) ? data['unit_name'].to_s.strip : ''
    name.empty? ? fallback : name
  rescue JSON::ParserError
    fallback
  end

  def self.personal_register(dialog)
    pending = nil
    editing_unit = nil
    chosen_image = nil
    busy = false
    work = lambda do |payload|
      begin
        args = JSON.parse(payload.to_s)
        data = personal_catalog
        case args['action']
        when 'load'
          personal_push(dialog)
        when 'export'
          personal_export(dialog)
        when 'import'
          personal_import(dialog)
        when 'category_save'
          name = args['name'].to_s.strip
          raise MHDESIGN::Language.for_tool('library').t('TEXT_3608B7C112EE') if name.empty? || name.length > 120
          picture = personal_category_picture(args['picture'])
          if args['id'].to_s.empty?
            parent = args['parent'].to_s
            raise MHDESIGN::Language.for_tool('library').t('TEXT_F117BC40DCF0') unless parent.empty? || data['categories'].any? { |c| c['id'] == parent }
            data['categories'] << {'id'=>SecureRandom.uuid, 'parent'=>parent, 'name'=>name}.merge(picture)
          else
            category = data['categories'].find { |c| c['id'] == args['id'] }
            raise MHDESIGN::Language.for_tool('library').t('TEXT_F9FC47B64AD7') unless category
            category['name'] = name
            category.delete('image_data')
            category.delete('image_mime')
            category.merge!(picture)
          end
          personal_write(data)
          personal_push(dialog)
          dialog.execute_script("document.getElementById('personalCategoryModal').classList.remove('show');")
        when 'category_image'
          path = UI.openpanel('اختيار صورة القسم', '', 'Images|*.png;*.jpg;*.jpeg;*.gif||')
          if path && File.file?(path)
            mime = {'.png'=>'image/png', '.jpg'=>'image/jpeg', '.jpeg'=>'image/jpeg', '.gif'=>'image/gif'}[File.extname(path).downcase]
            raise MHDESIGN::Language.for_tool('library').t('TEXT_D1C5241777B6') unless mime && File.size(path) <= 2 * 1024 * 1024
            picture = {'data'=>Base64.strict_encode64(File.binread(path)), 'mime'=>mime}
            personal_category_picture(picture)
            dialog.execute_script("window.personalCategoryImage(#{JSON.generate(picture)});")
          end
        when 'category_delete'
          category = data['categories'].find { |c| c['id'] == args['id'] }
          raise MHDESIGN::Language.for_tool('library').t('TEXT_F9FC47B64AD7') unless category
          ids = [category['id']]
          loop do
            children = data['categories'].select { |c| ids.include?(c['parent']) }.map { |c| c['id'] }
            merged = (ids + children).uniq
            break if merged == ids
            ids = merged
          end
          units = data['units'].select { |u| ids.include?(u['category']) }
          message = "حذف قسم «#{category['name']}»؟\nالقسم قد يحتوي على وحدات وأقسام فرعية.\nسيتم حذف القسم وكل فروعه والوحدات الموجودة داخله نهائيًا من مكتبتي.\nعدد الأقسام: #{ids.length} — عدد الوحدات: #{units.length}\nالنسخ الموجودة في مشروع SketchUp لن تتأثر."
          if UI.messagebox(message, MB_YESNO) == IDYES
            paths = units.flat_map { |u| [personal_file('LibraryUnits', u['id'], '.cache'), personal_file('LibraryImages', u['id'], '.image')] }
            data['categories'].reject! { |c| ids.include?(c['id']) }
            data['units'].reject! { |u| ids.include?(u['category']) }
            personal_write(data)
            paths.each { |path| File.delete(path) if File.file?(path) }
            personal_push(dialog)
          end
        when 'edit'
          unit = data['units'].find { |u| u['id'] == args['id'] }
          raise MHDESIGN::Language.for_tool('library').t('TEXT_A5390CB2CB43') unless unit
          editing_unit = unit['id']
          pending = chosen_image = nil
          info = unit.dup
          image = personal_file('LibraryImages', unit['id'], '.image')
          info['image'] = "data:#{unit['image_mime']};base64,#{Base64.strict_encode64(File.binread(image))}" if File.file?(image)
          dialog.execute_script("window.personalOpen(#{JSON.generate(info)});")
        when 'edit_save'
          personal_progress(dialog, 15, 'جاري تحديث الوحدة…')
          unit = data['units'].find { |u| u['id'] == editing_unit }
          raise MHDESIGN::Language.for_tool('library').t('TEXT_493BB66D3F53') unless unit && args['id'] == editing_unit
          dressing = !unit['dressing_type'].to_s.empty?
          name = dressing ? unit['name'].to_s : args['name'].to_s.strip
          raise MHDESIGN::Language.for_tool('library').t('TEXT_587274E96994') if name.empty? || (!dressing && name.length > 200)
          rename_parts = !dressing && args['rename'] == true
          model_path = personal_file('LibraryUnits', unit['id'], '.cache')
          image_path = personal_file('LibraryImages', unit['id'], '.image')
          old_model = rename_parts ? File.binread(model_path) : nil
          old_image = chosen_image && File.file?(image_path) ? File.binread(image_path) : nil
          model, temp, operation = Sketchup.active_model, nil, false
          begin
            if rename_parts
              temp = Tempfile.new(['mrkitchen_personal_edit', '.skp'])
              temp.binmode
              temp.write(decrypt_cache_text(old_model))
              temp.flush
              temp.close
              model.start_operation('تحديث نسخة مكتبتي', true)
              operation = true
              definition = model.definitions.load(temp.path)
              raise MHDESIGN::Language.for_tool('library').t('TEXT_1BA63723E1A5') unless definition
              copy = model.active_entities.add_instance(definition, Geom::Transformation.new)
              personal_progress(dialog, 30, 'جاري تحديث أسماء الأجزاء…')
              personal_rename(copy, name)
              raise MHDESIGN::Language.for_tool('library').t('TEXT_6E1001EE657D') unless copy.definition.save_as(temp.path)
              personal_progress(dialog, 65, 'جاري تجهيز الوحدة للحفظ…')
              encrypted = encrypt_cache_text(File.binread(temp.path))
              model.abort_operation
              operation = false
              File.binwrite(model_path, encrypted)
            end
            File.binwrite(image_path, chosen_image[0]) if chosen_image
            unit['name'] = name
            unit['desc'] = args['desc'].to_s
            unit['image_mime'] = chosen_image[1] if chosen_image
            unit['cutlist_name'] = true if rename_parts
            personal_progress(dialog, 85, 'جاري حفظ التعديلات…')
            personal_write(data)
          rescue
            File.binwrite(model_path, old_model) if old_model
            if chosen_image
              old_image ? File.binwrite(image_path, old_image) : (File.delete(image_path) if File.file?(image_path))
            end
            raise
          ensure
            model.abort_operation if operation
            temp.close! if temp
          end
          editing_unit = chosen_image = nil
          dialog.execute_script('window.personalClose(false);')
          personal_push(dialog)
        when 'begin'
          raise MHDESIGN::Language.for_tool('library').t('TEXT_54F09C03141F') unless data['categories'].any? { |c| c['id'] == args['category']  }
          editing_unit = nil
          selection = Sketchup.active_model.selection.to_a
          raise MHDESIGN::Language.for_tool('library').t('TEXT_DB686CBCE107') unless selection.length == 1 && (selection.first.is_a?(Sketchup::ComponentInstance) || selection.first.is_a?(Sketchup::Group))
          pending = [Sketchup.active_model, selection.first, args['category'].to_s]
          chosen_image = nil
          dressing = personal_dressing_target(selection.first)
          name = dressing ? personal_dressing_name(dressing[0]) : ''
          dialog.execute_script("window.personalOpen(null, #{JSON.generate(name)}, #{!dressing.nil?});")
          request = pending
          UI.start_timer(0.08, false) do
            if pending.equal?(request) && !chosen_image && !busy && request[1].valid?
              chosen_image = personal_thumbnail(request[1])
              if chosen_image
                preview = "data:#{chosen_image[1]};base64,#{Base64.strict_encode64(chosen_image[0])}"
                dialog.execute_script("window.personalThumbnail(#{JSON.generate(preview)});") rescue nil
              else
                dialog.execute_script('window.personalThumbnail(null);') rescue nil
              end
            end
          end
        when 'image'
          path = UI.openpanel('اختيار صورة الوحدة', '', 'Images|*.png;*.jpg;*.jpeg;*.gif||')
          if path && File.file?(path)
            mime = {'.png'=>'image/png', '.jpg'=>'image/jpeg', '.jpeg'=>'image/jpeg', '.gif'=>'image/gif'}[File.extname(path).downcase]
            raise MHDESIGN::Language.for_tool('library').t('TEXT_606EE7D7A72A') unless mime && File.size(path) <= 10 * 1024 * 1024
            chosen_image = [File.binread(path), mime]
            preview = "data:#{mime};base64,#{Base64.strict_encode64(chosen_image[0])}"
            dialog.execute_script("window.personalThumbnail(#{JSON.generate(preview)});")
          end
        when 'cancel'
          pending = chosen_image = editing_unit = nil
        when 'save'
          personal_progress(dialog, 10, 'جاري إضافة الوحدة…')
          raise MHDESIGN::Language.for_tool('library').t('TEXT_DD380962EA1D') unless pending && pending[0] == Sketchup.active_model && pending[1].valid?
          model, source, category = pending
          raise MHDESIGN::Language.for_tool('library').t('TEXT_761A2907216B') unless data['categories'].any? { |c| c['id'] == category  }
          dressing_target = personal_dressing_target(source)
          name = dressing_target ? personal_dressing_name(dressing_target[0]) : args['name'].to_s.strip
          raise MHDESIGN::Language.for_tool('library').t('TEXT_587274E96994') if name.empty? || (!dressing_target && name.length > 200)
          unless chosen_image
            personal_progress(dialog, 15, 'جاري تجهيز صورة الوحدة…')
            chosen_image = personal_thumbnail(source)
          end
          raise MHDESIGN::Language.for_tool('library').t('TEXT_7C02E8447741') unless chosen_image
          rename_parts = !dressing_target && args['rename'] == true
          id = SecureRandom.uuid
          unit_path = personal_file('LibraryUnits', id, '.cache')
          image_path = personal_file('LibraryImages', id, '.image')
          temp = Tempfile.new(['mrkitchen_personal_save', '.skp'])
          temp.close
          operation = false
          begin
            personal_progress(dialog, 25, 'جاري تجهيز نسخة الوحدة…')
            model.start_operation('تجهيز نسخة لمكتبتي', true)
            operation = true
            wrapper = model.active_entities.add_group
            transform = source.transformation.to_a
            transform[12] = transform[13] = transform[14] = 0.0
            copy = wrapper.entities.add_instance(source.definition, Geom::Transformation.new(transform))
            source.attribute_dictionaries.each do |dict|
              dict.each_pair { |key, value| copy.set_attribute(dict.name, key, value) }
            end if source.attribute_dictionaries
            copy.name = source.name
            personal_rename(copy, name) if rename_parts
            raise MHDESIGN::Language.for_tool('library').t('TEXT_1C353BC54A50') unless wrapper.definition.save_as(temp.path)
            personal_progress(dialog, 60, 'جاري تجهيز الوحدة للحفظ…')
            encrypted = encrypt_cache_text(File.binread(temp.path))
            model.abort_operation
            operation = false
            personal_progress(dialog, 80, 'جاري حفظ الوحدة في مكتبتي…')
            File.binwrite(unit_path, encrypted)
            File.binwrite(image_path, chosen_image[0])
            data['units'] << {'id'=>id, 'category'=>category, 'name'=>name, 'desc'=>args['desc'].to_s, 'image_mime'=>chosen_image[1], 'cutlist_name'=>rename_parts, 'dressing_type'=>dressing_target && dressing_target[1]}
            personal_write(data)
          rescue
            File.delete(unit_path) if File.file?(unit_path)
            File.delete(image_path) if File.file?(image_path)
            raise
          ensure
            model.abort_operation if operation
            temp.close!
          end
          pending = chosen_image = nil
          personal_progress(dialog, 95, 'جاري تحديث كروت المكتبة…')
          dialog.execute_script('window.personalClose(false);')
          personal_push(dialog)
        when 'delete'
          unit = data['units'].find { |u| u['id'] == args['id'] }
          raise MHDESIGN::Language.for_tool('library').t('TEXT_A5390CB2CB43') unless unit
          if UI.messagebox("#{MHDESIGN::Language.for_tool('library').t('TEXT_E375A20C9704')}#{unit['name']}#{MHDESIGN::Language.for_tool('library').t('TEXT_22CF93B7C15E')}", MB_YESNO) == IDYES
            data['units'].delete(unit)
            personal_write(data)
            [['LibraryUnits', '.cache'], ['LibraryImages', '.image']].each do |folder, ext|
              path = personal_file(folder, unit['id'], ext)
              File.delete(path) if File.file?(path)
            end
            personal_push(dialog)
          end
        when 'insert'
          unit = data['units'].find { |u| u['id'] == args['id'] }
          raise MHDESIGN::Language.for_tool('library').t('TEXT_A5390CB2CB43') unless unit
          dialog.execute_script("window.showEmbeddedLoading('جاري تجهيز الوحدة من مكتبتي...');")
          temp = Tempfile.new(['mrkitchen_personal_load', '.skp'])
          begin
            temp.binmode
            temp.write(decrypt_cache_text(File.binread(personal_file('LibraryUnits', unit['id'], '.cache'))))
            temp.flush
            temp.close
            definition = Sketchup.active_model.definitions.load(temp.path)
          ensure
            temp.close!
          end
          raise MHDESIGN::Language.for_tool('library').t('TEXT_1575CDC3A85D') unless definition
          comp = {name: unit['name'], personal_library_id: unit['id']}
          dressing_target = personal_dressing_target(definition)
          if dressing_target
            comp[:dressing_type] = dressing_target[1]
            raise MHDESIGN::Language.for_tool('library').t('TEXT_BCF200A01B74') unless load_dressing_engine(comp[:dressing_type])
          end
          dialog.execute_script('window.hideEmbeddedLoading();')
          hide_library_for_placement
          ok = activate_smart_unit_placement(definition, comp)
          restore_library_after_placement unless ok
        end
      rescue => error
        if args.is_a?(Hash) && args['action'] == 'insert'
          dialog.execute_script('window.hideEmbeddedLoading();') rescue nil
          restore_library_after_placement
        end
        dialog.execute_script("window.personalError(#{JSON.generate(error.message.to_s)});") rescue nil
      ensure
        busy = false
        dialog.execute_script('window.personalSavingDone();') rescue nil
        dialog.execute_script('window.personalReady();') rescue nil
      end
    end
    dialog.add_action_callback('personalAction') do |_, payload|
      next if busy
      busy = true
      args = JSON.parse(payload.to_s) rescue {}
      if %w[save edit_save export import].include?(args['action'])
        UI.start_timer(0.08, false) { work.call(payload) }
      else
        work.call(payload)
      end
    end
  end

  def self.cache_binding_seed
    [PLUGIN_NAME, get_device_id.to_s,
     (Sketchup.read_default(PLUGIN_NAME, "email") || "").to_s.strip.downcase,
     (Sketchup.read_default(PLUGIN_NAME, "license") || "").to_s,
     CACHE_SECRET_SALT].join("|")
  rescue
    "#{PLUGIN_NAME}|#{CACHE_SECRET_SALT}"
  end

  def self.cache_crypto_key
    Digest::SHA256.digest(cache_binding_seed)
  rescue
    Digest::SHA256.digest("#{PLUGIN_NAME}|#{CACHE_SECRET_SALT}")
  end

  def self.cache_hmac_key
    Digest::SHA256.digest("#{cache_binding_seed}|#{CACHE_HMAC_SALT}")
  rescue
    Digest::SHA256.digest("#{PLUGIN_NAME}|#{CACHE_HMAC_SALT}")
  end

  def self.cache_hmac_for(version, iv_b64, data_b64)
    OpenSSL::HMAC.hexdigest("SHA256", cache_hmac_key, [version.to_i, iv_b64.to_s, data_b64.to_s].join("|"))
  rescue
    ""
  end

  def self.encrypt_cache_text(plain_text)
    cipher = OpenSSL::Cipher.new("AES-256-CBC")
    cipher.encrypt
    cipher.key = cache_crypto_key
    iv = cipher.random_iv
    cipher.iv = iv
    encrypted = cipher.update(plain_text.to_s) + cipher.final
    iv_b64   = Base64.strict_encode64(iv)
    data_b64 = Base64.strict_encode64(encrypted)
    version  = 1
    envelope = { v: version, iv: iv_b64, data: data_b64, sig: cache_hmac_for(version, iv_b64, data_b64) }
    JSON.generate(envelope)
  end

  def self.decrypt_cache_text(encoded_text)
    txt = encoded_text.to_s
    parsed = JSON.parse(txt) rescue nil
    if parsed.is_a?(Hash) && parsed["v"] && parsed["iv"] && parsed["data"] && parsed["sig"]
      version  = parsed["v"].to_i
      iv_b64   = parsed["iv"].to_s
      data_b64 = parsed["data"].to_s
      sig      = parsed["sig"].to_s
      expected_sig = cache_hmac_for(version, iv_b64, data_b64)
      raise "Cache signature mismatch" unless !expected_sig.empty? && sig == expected_sig
      iv  = Base64.decode64(iv_b64)
      enc = Base64.decode64(data_b64)
      raise "Encrypted cache is invalid" if iv.nil? || enc.nil? || iv.bytesize != 16 || enc.bytesize == 0
      cipher = OpenSSL::Cipher.new("AES-256-CBC")
      cipher.decrypt
      cipher.key = cache_crypto_key
      cipher.iv  = iv
      return cipher.update(enc) + cipher.final
    end
    raw = Base64.decode64(txt)
    raise "Encrypted cache is invalid" if raw.nil? || raw.bytesize <= 16
    iv  = raw[0, 16]
    enc = raw[16..-1]
    cipher = OpenSSL::Cipher.new("AES-256-CBC")
    cipher.decrypt
    cipher.key = cache_crypto_key
    cipher.iv  = iv
    cipher.update(enc) + cipher.final
  end

  def self.cache_file_for_url(url, prefix = "remote")
    dir = ensure_cache_root!(prefix)
    hash = Digest::SHA256.hexdigest(url.to_s)
    File.join(dir, "#{prefix}_#{hash}.cache")
  end

  def self.write_encrypted_cache_for_url(url, content, prefix = "remote")
    path = cache_file_for_url(url, prefix)
    File.binwrite(path, encrypt_cache_text(content.to_s))
    path
  rescue
    nil
  end

  def self.read_encrypted_cache_for_url(url, prefix = "remote")
    path = cache_file_for_url(url, prefix)
    return nil unless File.exist?(path) && File.file?(path) && File.size(path) > 0
    decrypt_cache_text(File.binread(path))
  rescue
    nil
  end

  def self.fetch_text_with_encrypted_cache(url, prefix = "remote")
    remote_error = nil
    begin
      raw = URI.open(url.to_s, open_timeout: OPEN_TIMEOUT, read_timeout: READ_TIMEOUT).read
      if raw && !raw.to_s.strip.empty?
        write_encrypted_cache_for_url(url, raw, prefix)
        return raw
      end
    rescue => e
      remote_error = e
    end
    cached = read_encrypted_cache_for_url(url, prefix)
    return cached if cached && !cached.to_s.strip.empty?
    raise(remote_error || RuntimeError.new("تعذر تحميل الملف ولا يوجد كاش صالح له"))
  end

  def self.fetch_binary_with_encrypted_cache(url, prefix = "bin")
    remote_error = nil
    begin
      raw = URI.open(url.to_s, "rb", open_timeout: OPEN_TIMEOUT, read_timeout: READ_TIMEOUT).read
      if raw && raw.bytesize > 0
        write_encrypted_cache_for_url(url, raw, prefix)
        return raw
      end
    rescue => e
      remote_error = e
    end
    cached = read_encrypted_cache_for_url(url, prefix)
    return cached if cached && cached.bytesize > 0
    raise(remote_error || RuntimeError.new("تعذر تحميل الملف الثنائي ولا يوجد كاش صالح له"))
  end

  def self.cache_exists_and_nonempty_for_url?(url, prefix = "remote")
    path = cache_file_for_url(url, prefix)
    File.exist?(path) && File.file?(path) && File.size(path) > 0
  rescue
    false
  end

  def self.normalize_source_url(url)
    u = url.to_s.strip
    return "" if u.empty?
    begin
      uri = URI.parse(u)
      return "" unless uri.is_a?(URI::HTTP) || uri.is_a?(URI::HTTPS)
      host = uri.host.to_s.strip.downcase
      return "" unless SOURCE_ALLOWED_HOSTS.include?(host)
      uri.fragment = nil
      uri.to_s
    rescue
      ""
    end
  end

  def self.source_signature_for(url)
    normalized = normalize_source_url(url)
    return "" if normalized.empty?
    Digest::SHA256.hexdigest("#{normalized}|#{SOURCE_SIGNATURE_SALT}")
  rescue
    ""
  end

  def self.component_source_payload_valid?(url, sig)
    normalized = normalize_source_url(url)
    return false if normalized.empty?
    expected = source_signature_for(normalized)
    return false if expected.empty?
    expected == sig.to_s
  rescue
    false
  end

  def self.write_source_metadata(instance, comp_data)
    return false unless instance
    return false unless comp_data.is_a?(Hash)
    raw_url = (comp_data[:url] || comp_data["url"]).to_s
    raw_name = (comp_data[:name] || comp_data["name"]).to_s
    normalized_url = normalize_source_url(raw_url)
    return false if normalized_url.empty?
    sig = source_signature_for(normalized_url)
    return false if sig.empty?
    instance.set_attribute(SOURCE_ATTR_DICT, SOURCE_ATTR_URL, normalized_url)
    instance.set_attribute(SOURCE_ATTR_DICT, SOURCE_ATTR_SIG, sig)
    instance.set_attribute(SOURCE_ATTR_DICT, SOURCE_ATTR_NAME, raw_name.to_s)
    instance.set_attribute(SOURCE_ATTR_DICT, SOURCE_ATTR_INSERTED_AT, Time.now.to_i)
    true
  rescue
    false
  end

  def self.source_metadata_for(instance)
    return nil unless instance
    url = instance.get_attribute(SOURCE_ATTR_DICT, SOURCE_ATTR_URL).to_s
    sig = instance.get_attribute(SOURCE_ATTR_DICT, SOURCE_ATTR_SIG).to_s
    name = instance.get_attribute(SOURCE_ATTR_DICT, SOURCE_ATTR_NAME).to_s
    return nil unless component_source_payload_valid?(url, sig)
    { url: normalize_source_url(url), sig: sig, name: name }
  rescue
    nil
  end

  def self.component_lists_from_all_json_feeds
    urls = [JSON_URL_11, JSON_URL_12, JSON_URL_33, JSON_URL_41, JSON_URL_EXTRA]
    all = []
    urls.each do |json_url|
      begin
        raw = fetch_text_with_encrypted_cache(json_url, "json")
        arr = _normalize_components(raw)
        next unless arr.is_a?(Array)
        arr.each do |it|
          next unless it.is_a?(Hash)
          url = (it[:url] || it["url"]).to_s
          name = (it[:name] || it["name"]).to_s
          next if url.strip.empty?
          all << { url: url, name: name }
        end
      rescue
      end
    end
    all
  rescue
    []
  end

  def self.unique_component_downloads
    seen = {}
    out = []
    component_lists_from_all_json_feeds.each do |it|
      url = it[:url].to_s
      next if url.strip.empty?
      next if seen[url]
      seen[url] = true
      out << it
    end
    out
  rescue
    []
  end

  def self.cache_exists_for_url?(url, prefix = "remote")
    path = cache_file_for_url(url, prefix)
    File.exist?(path) && File.file?(path) && File.size(path) > 0
  rescue
    false
  end

  def self.cache_file_age_seconds(url, prefix = "remote")
    path = cache_file_for_url(url, prefix)
    return nil unless File.exist?(path) && File.file?(path)
    (Time.now - File.mtime(path)).to_f
  rescue
    nil
  end

  def self.ads_cache_fresh_for_url?(url)
    age = cache_file_age_seconds(url, "ads")
    return false if age.nil?
    age <= ADS_CACHE_TTL_SECONDS
  rescue
    false
  end

  def self.fetch_ads_text_with_ttl(url)
    if ads_cache_fresh_for_url?(url)
      cached = read_encrypted_cache_for_url(url, "ads")
      return cached if cached && !cached.to_s.strip.empty?
    end
    remote_error = nil
    begin
      raw = URI.open(url.to_s, open_timeout: OPEN_TIMEOUT, read_timeout: READ_TIMEOUT).read
      if raw && !raw.to_s.strip.empty?
        write_encrypted_cache_for_url(url, raw, "ads")
        return raw
      end
    rescue => e
      remote_error = e
    end
    cached = read_encrypted_cache_for_url(url, "ads")
    return cached if cached && !cached.to_s.strip.empty?
    raise(remote_error || RuntimeError.new("تعذر تحميل الإعلانات ولا يوجد كاش صالح لها"))
  end

  def self.offline_access_state_path
    ensure_cache_root!
    File.join(cache_root_dir, "offline_access_state.cache")
  rescue
    File.join(cache_root_dir, "offline_access_state.cache")
  end

  def self.write_offline_access_grant(email, license)
    ensure_cache_root!
    payload = {
      device_id: get_device_id.to_s,
      email: email.to_s,
      license: license.to_s,
      granted_at: Time.now.to_i,
      offline_allowed_until: (Time.now.to_i + OFFLINE_GRACE_SECONDS)
    }.to_json
    File.binwrite(offline_access_state_path, encrypt_cache_text(payload))
    true
  rescue
    false
  end

  def self.read_offline_access_grant
    path = offline_access_state_path
    return nil unless File.exist?(path) && File.file?(path) && File.size(path) > 0
    raw = File.binread(path)
    txt = decrypt_cache_text(raw)
    data = JSON.parse(txt) rescue nil
    data.is_a?(Hash) ? data : nil
  rescue
    nil
  end

  def self.clear_offline_access_grant
    path = offline_access_state_path
    File.delete(path) if File.exist?(path)
    true
  rescue
    false
  end

  def self.offline_access_allowed?(email = nil, license = nil)
    data = read_offline_access_grant
    return false unless data.is_a?(Hash)
    expires_at = data["offline_allowed_until"].to_i
    return false if expires_at <= 0
    return false if Time.now.to_i > expires_at
    saved_device  = data["device_id"].to_s
    saved_email   = data["email"].to_s
    saved_license = data["license"].to_s
    return false if saved_device.empty? || saved_device != get_device_id.to_s
    return false if !email.to_s.empty? && saved_email != email.to_s
    return false if !license.to_s.empty? && saved_license != license.to_s
    true
  rescue
    false
  end

  def self.offline_access_remaining_seconds
    data = read_offline_access_grant
    return 0 unless data.is_a?(Hash)
    expires_at = data["offline_allowed_until"].to_i
    left = expires_at - Time.now.to_i
    left > 0 ? left : 0
  rescue
    0
  end

  def self.applied_update_marker_path
    File.join(cache_root_dir, "applied_update_id.txt")
  rescue
    File.join(cache_root_dir, "applied_update_id.txt")
  end

  def self.read_applied_update_id
    path = applied_update_marker_path
    return "" unless File.exist?(path) && File.file?(path) && File.size(path) > 0
    raw = File.binread(path)
    decrypt_cache_text(raw).to_s.strip
  rescue
    ""
  end

  def self.write_applied_update_id(update_id)
    uid = update_id.to_s.strip
    return false if uid.empty?
    ensure_cache_root!
    File.binwrite(applied_update_marker_path, encrypt_cache_text(uid))
    true
  rescue
    false
  end

  def self.legacy_plugin_candidates
    dirs = [PLUGIN_DIR, (File.dirname(PLUGIN_DIR) rescue nil)].compact.map(&:to_s).uniq
    out = []
    dirs.each do |dir|
      next if dir.to_s.strip.empty?
      ["invoice.rb", "report_units.rb"].each do |name|
        path = File.join(dir, name)
        out << path if File.exist?(path) && File.file?(path)
      end
    end
    out.uniq
  rescue
    []
  end

  def self.ensure_no_legacy_local_plugins!
    files = legacy_plugin_candidates
    return true if files.empty?
    list = files.map { |p| "- #{p}" }.join("\n")
    UI.messagebox("⚠️ تم العثور على ملفات قديمة داخل مجلد Plugins:\n\n#{list}\n\nمن فضلك احذف هذه الملفات ثم افتح المكتبة مرة أخرى.")
    false
  rescue
    true
  end

  def self.normalize_update_targets(raw_targets)
    allowed = %w[ads code units tools language]
    list = Array(raw_targets).flatten.map { |x| x.to_s.strip.downcase }.reject(&:empty?)
    list &= allowed
    list = ["code"] if list.empty?
    list.uniq
  rescue
    ["code"]
  end

  def self.clear_cache_targets(targets, show_message = true)
    ensure_cache_root!
    normalized = normalize_update_targets(targets)
    success_message = MHDESIGN::Language.for_tool('library').t('TEXT_AF5449F3657F') if show_message
    if normalized.include?("units")
      FileUtils.rm_rf(units_cache_root_dir) if File.directory?(units_cache_root_dir)
      FileUtils.mkdir_p(units_cache_root_dir)
    end
    patterns = []
    patterns.concat(%w[language_*.cache]) if normalized.include?("language")
    patterns.concat(%w[ads_*.cache]) if normalized.include?("ads")
    patterns.concat(%w[tool_*.cache plugin_*.cache language_*.cache]) if normalized.include?("tools")
    if normalized.include?("code")
      patterns.concat(%w[remote_*.cache code_*.cache core_*.cache main_*.cache plugin_code_*.cache language_*.cache])
    end
    patterns.uniq.each do |pattern|
      Dir.glob(File.join(cache_root_dir, pattern)).each do |path|
        begin
          File.delete(path) if File.file?(path)
        rescue
        end
      end
    end
    if (normalized & %w[code tools language]).any?
      TranslationPackage.invalidate!
      @loaded_dressing_engines = {}
    end
    UI.messagebox(success_message) if show_message
    true
  rescue => e
    UI.messagebox("MR Kitchen: #{e.message}") if show_message
    false
  end

  def self.fetch_update_status
    uri = URI(GITHUB_STATUS_URL)
    http = Net::HTTP.new(uri.host, uri.port)
    http.use_ssl      = (uri.scheme == 'https')
    http.open_timeout = OPEN_TIMEOUT
    http.read_timeout = READ_TIMEOUT
    req = Net::HTTP::Get.new(uri.request_uri)
    req['User-Agent'] = "SketchUp/#{Sketchup.version} Ruby/#{RUBY_VERSION} #{PLUGIN_NAME}"
    res = http.request(req)
    return nil unless res.code.to_i == 200
    data = JSON.parse(res.body) rescue nil
    return nil unless data.is_a?(Hash)
    mode = (data['mode'].to_s == 'required' ? 'required' : 'optional')
    notify = data['notify'].to_s.strip.downcase
    notify = 'message' unless %w[message silent].include?(notify)
    notify = 'message' if mode == 'optional'
    {
      has_update: !!data['has_update'],
      mode: mode,
      notify: notify,
      message: data['message'].to_s.strip,
      update_id: (data['version'] || data['update_id'] || Digest::SHA256.hexdigest(data.to_json)[0, 16]).to_s.strip,
      targets: normalize_update_targets(data['targets'])
    }
  rescue
    nil
  end

  def self.handle_update_gate!
    status = fetch_update_status
    return :proceed if status.nil?
    return :proceed unless status[:has_update]
    current_update_id = status[:update_id].to_s.strip
    applied_update_id = read_applied_update_id
    if !current_update_id.empty? && applied_update_id == current_update_id
      return :proceed
    end
    message = status[:message].to_s.strip
    message = "هناك بعض التعديلات برجاء تحديث المكتبة." if message.empty?
    targets = normalize_update_targets(status[:targets])
    notify  = status[:notify].to_s
    if status[:mode] == 'required'
      if notify == 'silent'
        ok = clear_cache_targets(targets, false)
        write_applied_update_id(current_update_id) if ok && !current_update_id.empty?
        return ok ? :updated : :abort
      end
      response = UI.messagebox(message, MB_OK)
      return :abort unless response == IDOK || response == IDYES
      ok = clear_cache_targets(targets, false)
      write_applied_update_id(current_update_id) if ok && !current_update_id.empty?
      return ok ? :updated : :abort
    end
    response = UI.messagebox(message, MB_YESNO)
    if response == IDYES
      ok = clear_cache_targets(targets, false)
      write_applied_update_id(current_update_id) if ok && !current_update_id.empty?
      ok ? :updated : :proceed
    else
      :proceed
    end
  rescue
    :proceed
  end

  def self.country_code_valid?(code)
    COUNTRY_CHOICES.any? { |pair| pair[0] == code.to_s.strip.upcase }
  rescue
    false
  end

  def self.country_label(code)
    cc = code.to_s.strip.upcase
    pair = COUNTRY_CHOICES.find { |item| item[0] == cc }
    original = pair ? pair[1] : "غير محددة"
    tr(original)
  rescue
    tr("غير محددة")
  end

  def self.country_code_from_label(label)
    txt = label.to_s.strip
    pair = COUNTRY_CHOICES.find { |item| item[1] == txt }
    pair ? pair[0] : nil
  rescue
    nil
  end

  def self.get_saved_country
    cc = (Sketchup.read_default(PLUGIN_NAME, "country_code") || "").to_s.strip.upcase
    return cc if country_code_valid?(cc)
    ""
  rescue
    ""
  end

  def self.set_saved_country(code)
    cc = code.to_s.strip.upcase
    cc = "GLOBAL" unless country_code_valid?(cc)
    Sketchup.write_default(PLUGIN_NAME, "country_code", cc)
    cc
  rescue
    "GLOBAL"
  end

  def self.choose_country(force = false)
    current = get_saved_country
    return current if !force && !current.to_s.empty?
    labels = COUNTRY_CHOICES.map { |pair| pair[1] }
    default_label = current.to_s.empty? ? COUNTRY_CHOICES.first[1] : country_label(current)
    input = UI.inputbox(
      ["اختر الدولة"], [default_label], [labels.join("|")],
      "MR Kitchen - اختيار الدولة"
    )
    return current unless force || input
    return current if input.nil? && !current.to_s.empty?
    return nil if input.nil? && current.to_s.empty?
    selected_label = input[0].to_s
    selected_code  = country_code_from_label(selected_label)
    selected_code  = "GLOBAL" unless country_code_valid?(selected_code)
    set_saved_country(selected_code)
  rescue
    current = get_saved_country
    current.to_s.empty? ? "GLOBAL" : current
  end

  def self.ensure_country_selected
    cc = get_saved_country
    return cc unless cc.to_s.empty?
    chosen = choose_country(true)
    chosen.to_s.empty? ? nil : chosen
  rescue
    nil
  end

  def self._normalize_components(raw)
    begin
      parsed = JSON.parse(raw) rescue nil
      return [] unless parsed
      if parsed.is_a?(Hash) && parsed["data"].is_a?(String) && !parsed["data"].to_s.strip.empty?
        decoded = Base64.decode64(parsed["data"].to_s) rescue ""
        arr = JSON.parse(decoded, symbolize_names: true) rescue []
        return arr.is_a?(Array) ? arr : []
      end
      if parsed.is_a?(Array)
        arr = JSON.parse(raw, symbolize_names: true) rescue []
        return arr.is_a?(Array) ? arr : []
      end
      if parsed.is_a?(Hash)
        %w[components items list data].each do |k|
          v = parsed[k]
          if v.is_a?(Array)
            vv = JSON.parse(v.to_json, symbolize_names: true) rescue []
            return vv.is_a?(Array) ? vv : []
          end
        end
      end
      []
    rescue
      []
    end
  end

  def self._normalize_ads(raw)
    begin
      parsed = JSON.parse(raw) rescue nil
      return [] unless parsed
      arr =
        if parsed.is_a?(Array)
          parsed
        elsif parsed.is_a?(Hash) && parsed["ads"].is_a?(Array)
          parsed["ads"]
        elsif parsed.is_a?(Hash) && parsed["items"].is_a?(Array)
          parsed["items"]
        elsif parsed.is_a?(Hash) && parsed["data"].is_a?(Array)
          parsed["data"]
        else
          []
        end
      arr = JSON.parse(arr.to_json, symbolize_names: true) rescue []
      arr.select do |it|
        it.is_a?(Hash) &&
          (it[:title] || it["title"]) &&
          (it[:image] || it["image"]) &&
          (it[:link]  || it["link"])
      end.map do |it|
        it2 = JSON.parse(it.to_json, symbolize_names: true) rescue it
        it2[:type] = "ad"
        it2
      end
    rescue
      []
    end
  end

  def self.load_ads_for_country(country_code)
    cc = country_code.to_s.strip.upcase
    cc = "GLOBAL" unless country_code_valid?(cc)
    begin
      raw = fetch_ads_text_with_ttl(GITHUB_ADS_URL)
      ads = _normalize_ads(raw)
    rescue
      return []
    end
    today = Date.today
    ads.select do |ad|
      countries = ad[:countries] || ad["countries"]
      country_ok = !countries.is_a?(Array) || countries.empty? ||
                   countries.map { |x| x.to_s.strip.upcase }.include?(cc) ||
                   countries.map { |x| x.to_s.strip.upcase }.include?("GLOBAL")
      start_ok = true
      end_ok   = true
      begin
        start_date = ad[:start_date] || ad["start_date"]
        end_date   = ad[:end_date]   || ad["end_date"]
        start_ok = false if start_date && !start_date.to_s.strip.empty? && today < Date.parse(start_date.to_s)
        end_ok   = false if end_date   && !end_date.to_s.strip.empty?   && today > Date.parse(end_date.to_s)
      rescue ArgumentError
      end
      country_ok && start_ok && end_ok
    end
  rescue
    []
  end

  def self.get_saved_lower_mode
    (Sketchup.read_default(PLUGIN_NAME, "lower_mode") || "A").to_s.strip.upcase
  rescue
    "A"
  end

  def self.get_saved_upper_mode
    (Sketchup.read_default(PLUGIN_NAME, "upper_mode") || "A").to_s.strip.upcase
  rescue
    "A"
  end

  def self.set_saved_lower_mode(mode)
    mode = mode.to_s.strip.upcase
    mode = "A" unless %w[A B].include?(mode)
    Sketchup.write_default(PLUGIN_NAME, "lower_mode", mode)
    mode
  rescue
    "A"
  end

  def self.set_saved_upper_mode(mode)
    mode = mode.to_s.strip.upcase
    mode = "A" unless %w[A B].include?(mode)
    Sketchup.write_default(PLUGIN_NAME, "upper_mode", mode)
    mode
  rescue
    "A"
  end

  def self._url_for_combo(lower_mode, upper_mode)
    lm = lower_mode.to_s.strip.upcase
    um = upper_mode.to_s.strip.upcase
    lm = "A" unless %w[A B].include?(lm)
    um = "A" unless %w[A B].include?(um)
    if lm == "A" && um == "A" then JSON_URL_11
    elsif lm == "A" && um == "B" then JSON_URL_12
    elsif lm == "B" && um == "B" then JSON_URL_33
    else JSON_URL_41
    end
  end

  def self.load_components_for_combo(lower_mode, upper_mode)
    url = _url_for_combo(lower_mode, upper_mode)
    begin
      raw = fetch_text_with_encrypted_cache(url, "json")
      list = _normalize_components(raw)
      begin
        extra_raw = fetch_text_with_encrypted_cache(JSON_URL_EXTRA, "json")
        extra_list = _normalize_components(extra_raw)
        list = list + extra_list if extra_list.is_a?(Array)
      rescue
      end
      list = list.select do |it|
        it.is_a?(Hash) && (it[:name] || it["name"]) && (it[:url] || it["url"])
      end.map do |it|
        it2 = (it.is_a?(Hash) ? it : {})
        it2 = JSON.parse(it2.to_json, symbolize_names: true) rescue it2
        it2
      end
      if defined?(MHDESIGN::Language)
        list = list.map { |item| MHDESIGN::Language.for_tool('library').translate_component(item) }
      end
      list
    rescue => e
      UI.messagebox("❌ فشل تحميل بيانات المكتبة:\n#{e.message}\n")
      []
    end
  end

  def self.preload_core_remote_assets(country_code = nil)
    ensure_cache_root!
    assets = [
      [JSON_URL_11, 'json'], [JSON_URL_12, 'json'], [JSON_URL_33, 'json'], [JSON_URL_41, 'json'],
      [JSON_URL_EXTRA, 'json'],
      [GROOVE_TOOL_URL, 'tool'], [CLASSIC_DOOR_TOOL_URL, 'tool'], [SERIAL_TOOL_URL, 'tool'],
      [SNAP_TOOL_URL, 'tool'], [COUNTERTOP_ENGINE_URL, 'tool'], [OPENING_ENGINE_URL, 'tool'],
      [ROOM_BUILDER_URL, 'tool'], [OPTIONS_PROTECTED_URL, 'tool'], [KITCHEN_MATERIALS_TOOL_URL, 'tool'],
      [COMPONENT_TRANSLATOR_URL, 'tool'], [INVOICE_PLUGIN_URL, 'plugin'], [REPORTS_PLUGIN_URL, 'plugin'],
      [PRICING_LAUNCHER_URL, 'tool'], [PRICING_ADMIN_URL, 'tool'], [PRICING_DESIGNER_URL, 'tool'],
      [GITHUB_ADS_URL, 'ads']
    ]
    assets.each do |url, prefix|
      begin
        if prefix == 'ads'
          next if ads_cache_fresh_for_url?(url)
          fetch_ads_text_with_ttl(url)
        else
          next if cache_exists_for_url?(url, prefix)
          fetch_text_with_encrypted_cache(url, prefix)
        end
      rescue
      end
    end
    true
  rescue
    false
  end

  def self.preload_assets_cache_with_progress(country_code = nil)
    ensure_cache_root!
    core_assets = [
      [JSON_URL_11, 'json', 'ملف الوحدات 1/4', :text],
      [JSON_URL_12, 'json', 'ملف الوحدات 2/4', :text],
      [JSON_URL_33, 'json', 'ملف الوحدات 3/4', :text],
      [JSON_URL_41, 'json', 'ملف الوحدات 4/4', :text],
      [JSON_URL_EXTRA, 'json', 'ملف الإضافات', :text],
      [GROOVE_TOOL_URL, 'tool', 'أداة حفر اليد', :text],
      [CLASSIC_DOOR_TOOL_URL, 'tool', 'أداة الضلفة الكلاسيك', :text],
      [SERIAL_TOOL_URL, 'tool', 'أداة الترقيم', :text],
      [SNAP_TOOL_URL, 'tool', 'أداة السناب', :text],
      [COUNTERTOP_ENGINE_URL, 'tool', 'محرك الرخامة', :text],
      [OPENING_ENGINE_URL, 'tool', 'محرك الفتحات', :text],
      [ROOM_BUILDER_URL, 'tool', 'أداة بناء الغرفة', :text],
      [OPTIONS_PROTECTED_URL, 'tool', 'أداة خيارات الوحدات', :text],
      [KITCHEN_MATERIALS_TOOL_URL, 'tool', 'أداة مستويات وخامات المطبخ', :text],
      [COMPONENT_TRANSLATOR_URL, 'tool', 'أداة ترجمة أسماء القطع', :text],
      [INVOICE_PLUGIN_URL, 'plugin', 'إضافة الفواتير', :text],
      [REPORTS_PLUGIN_URL, 'plugin', 'إضافة التقارير', :text],
      [PRICING_LAUNCHER_URL, 'tool', 'لانشر التسعير', :text],
      [PRICING_ADMIN_URL, 'tool', 'لوحة تحكم التسعير', :text],
      [PRICING_DESIGNER_URL, 'tool', 'لوحة تسعير المطابخ', :text],
      [GITHUB_ADS_URL, 'ads', 'إعلانات MR Kitchen', :text]
    ]
    missing_assets = core_assets.reject do |url, prefix, _label, _kind|
      prefix == 'ads' ? ads_cache_fresh_for_url?(url) : cache_exists_and_nonempty_for_url?(url, prefix)
    end
    return true if missing_assets.empty?

    progress = UI::HtmlDialog.new(
      dialog_title: 'MR Kitchen',
      preferences_key: 'mrkitchen_preload_cache_progress',
      scrollable: false, resizable: false, width: 390, height: 185,
      style: UI::HtmlDialog::STYLE_DIALOG
    )
    progress.set_html <<-HTML
      <html><head>
        <meta charset="UTF-8">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;800&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
        <style>
          body{font-family:'Tajawal',sans-serif;direction:rtl;margin:0;padding:18px;background:#f5f6f8;color:#1b1f27}
          .wrap{display:flex;flex-direction:column;gap:10px}
          .title{font-size:18px;font-weight:700;text-align:center}
          .sub{font-size:13px;text-align:center;color:#5c6777}
          .bar{width:100%;height:16px;background:#e2e6eb;border-radius:999px;overflow:hidden}
          .fill{height:100%;width:0%;background:#43a047;transition:width .2s ease}
          .percent{text-align:center;font-size:13px;font-weight:700}
          .name{text-align:center;font-size:13px;color:#263238;min-height:18px}
        #{MHDESIGN_ResponsiveHeaderUI::CSS}
html { color-scheme: dark; }
body { background: var(--ref-bg); color: var(--ref-text); padding: 6px; font: 12px/1.35 "Segoe UI", Tahoma, Arial, sans-serif; }
.mhd-ref-header { min-height: 44px; padding: 3px 5px; border: 1px solid var(--ref-border); border-radius: 8px; }
.mhd-ref-header :is(.title, h3) { font-size: 14px; }
.mhd-ref-header .mhd-ref-logo { max-height: 32px; }
.mhd-ref-header .mhd-ref-art svg { width: 40px; height: 42px; }
.wrap { gap: 6px; }
.sub, .name { color: var(--ref-muted); }
.bar, #progress-bar { background: var(--ref-input); border: 1px solid var(--ref-border); height: 12px; }
.fill, #progress-fill { background: var(--ref-action); }
        </style>
      </head><body>
        <div class="wrap">
          <header class="mhd-ref-header">#{MHDESIGN_ResponsiveHeaderUI::BRAND}<div class="title mhd-ref-heading">#{MHDESIGN::Language.for_tool('library').html('TEXT_4D8F4C7E8903')}</div></header>
          <div class="sub">#{MHDESIGN::Language.for_tool('library').html('TEXT_E76580BC0769')}</div>
          <div class="bar"><div class="fill" id="fill"></div></div>
          <div class="percent" id="percent">0%</div>
          <div class="name" id="name">#{MHDESIGN::Language.for_tool('library').html('TEXT_91536F6CEB4B')}</div>
        </div>
      </body></html>
    HTML
    progress.show
    total = missing_assets.length
    success = true
    missing_assets.each_with_index do |(url, prefix, label, kind), idx|
      begin
        percent_before = ((idx.to_f / total.to_f) * 100).to_i
        progress.execute_script("document.getElementById('fill').style.width='#{percent_before}%'") rescue nil
        progress.execute_script("document.getElementById('percent').innerText='#{percent_before}%'") rescue nil
        progress.execute_script("document.getElementById('name').innerText=#{label.to_json}") rescue nil
        if kind == :binary
          fetch_binary_with_encrypted_cache(url, prefix)
        elsif prefix == 'ads'
          fetch_ads_text_with_ttl(url)
        else
          fetch_text_with_encrypted_cache(url, prefix)
        end
      rescue
        success = false
      end
    end
    progress.execute_script("document.getElementById('fill').style.width='100%'") rescue nil
    progress.execute_script("document.getElementById('percent').innerText='100%'") rescue nil
    progress.execute_script(("document.getElementById('name').innerText='" + MHDESIGN::Language.for_tool('library').js_fragment('TEXT_2F0E6E2D8B00') + "'")) rescue nil
    UI.start_timer(0.5, false) { progress.close rescue nil }
    success
  rescue
    true
  end

  def self.download_all_components_for_offline
    ensure_cache_root!
    comps = unique_component_downloads
    if comps.empty?
      UI.messagebox("#{MHDESIGN::Language.for_tool('library').t('TEXT_6C73CD99A88C')}")
      return false
    end
    missing = comps.reject { |it| cache_exists_and_nonempty_for_url?(it[:url].to_s, 'skp') }
    if missing.empty?
      UI.messagebox("#{MHDESIGN::Language.for_tool('library').t('TEXT_6954E6BCCB15')}")
      return true
    end
    progress = UI::HtmlDialog.new(
      dialog_title: 'MR Kitchen',
      preferences_key: 'mrkitchen_download_all_components',
      scrollable: false, resizable: false, width: 390, height: 185,
      style: UI::HtmlDialog::STYLE_DIALOG
    )
    progress.set_html <<-HTML
      <html><head>
        <meta charset="UTF-8">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;800&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
        <style>
          body{font-family:'Tajawal',sans-serif;direction:rtl;margin:0;padding:18px;background:#f5f6f8;color:#1b1f27}
          .wrap{display:flex;flex-direction:column;gap:10px}
          .title{font-size:18px;font-weight:700;text-align:center}
          .sub{font-size:13px;text-align:center;color:#5c6777}
          .bar{width:100%;height:16px;background:#e2e6eb;border-radius:999px;overflow:hidden}
          .fill{height:100%;width:0%;background:#43a047;transition:width .2s ease}
          .percent{text-align:center;font-size:13px;font-weight:700}
          .name{text-align:center;font-size:13px;color:#263238;min-height:18px}
        #{MHDESIGN_ResponsiveHeaderUI::CSS}
html { color-scheme: dark; }
body { background: var(--ref-bg); color: var(--ref-text); padding: 6px; font: 12px/1.35 "Segoe UI", Tahoma, Arial, sans-serif; }
.mhd-ref-header { min-height: 44px; padding: 3px 5px; border: 1px solid var(--ref-border); border-radius: 8px; }
.mhd-ref-header :is(.title, h3) { font-size: 14px; }
.mhd-ref-header .mhd-ref-logo { max-height: 32px; }
.mhd-ref-header .mhd-ref-art svg { width: 40px; height: 42px; }
.wrap { gap: 6px; }
.sub, .name { color: var(--ref-muted); }
.bar, #progress-bar { background: var(--ref-input); border: 1px solid var(--ref-border); height: 12px; }
.fill, #progress-fill { background: var(--ref-action); }
        </style>
      </head><body>
        <div class="wrap">
          <header class="mhd-ref-header">#{MHDESIGN_ResponsiveHeaderUI::BRAND}<div class="title mhd-ref-heading">#{MHDESIGN::Language.for_tool('library').html('DOWNLOAD_OFFLINE')}</div></header>
          <div class="sub">#{MHDESIGN::Language.for_tool('library').html('TEXT_FC3ED0DEE436')}</div>
          <div class="bar"><div class="fill" id="fill"></div></div>
          <div class="percent" id="percent">0%</div>
          <div class="name" id="name">#{MHDESIGN::Language.for_tool('library').html('TEXT_91536F6CEB4B')}</div>
        </div>
      </body></html>
    HTML
    progress.show
    total = missing.length
    success = true
    UI.start_timer(0.1, false) do
      missing.each_with_index do |it, idx|
        begin
          label = it[:name].to_s.strip.empty? ? 'بدون اسم' : it[:name].to_s
          percent_before = ((idx.to_f / total.to_f) * 100).to_i
          progress.execute_script("document.getElementById('fill').style.width='#{percent_before}%'") rescue nil
          progress.execute_script("document.getElementById('percent').innerText='#{percent_before}%'") rescue nil
          progress.execute_script("document.getElementById('name').innerText=#{label.to_json}") rescue nil
          fetch_binary_with_encrypted_cache(it[:url].to_s, 'skp')
        rescue
          success = false
        end
      end
      progress.execute_script("document.getElementById('fill').style.width='100%'") rescue nil
      progress.execute_script("document.getElementById('percent').innerText='100%'") rescue nil
      progress.execute_script(("document.getElementById('name').innerText='" + MHDESIGN::Language.for_tool('library').js_fragment('TEXT_86AD52E7DFC7') + "'")) rescue nil
      UI.start_timer(0.5, false) do
        progress.close rescue nil
        if success
          UI.messagebox("#{MHDESIGN::Language.for_tool('library').t('TEXT_E0995E5285EE')}")
        else
          UI.messagebox("#{MHDESIGN::Language.for_tool('library').t('TEXT_4FB435EEB63A')}")
        end
      end
    end
    true
  rescue => e
    UI.messagebox("#{MHDESIGN::Language.for_tool('library').t('TEXT_08DDBB33BA6E')}#{e.message}")
    false
  end

  def self.get_device_id
    prefs = Sketchup.read_default(PLUGIN_NAME, "device_id")
    return prefs unless prefs.nil? || prefs.empty?
    id = SecureRandom.uuid
    Sketchup.write_default(PLUGIN_NAME, "device_id", id)
    id
  end

